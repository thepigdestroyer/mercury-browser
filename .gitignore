# SPDX-License-Identifier: MPL-2.0
# Build output. The disk guard (.opencode/plugins/) deletes it after every round of work.
/target/
/dist/

# Documentation toolchain (MkDocs builds into target/mkdocs)
/.venv-docs/

# macOS
.DS_Store
.AppleDouble
._*

# Editors and IDEs
.idea/
.vscode/
*.swp
*~

# OpenCode: the plugin and skills in .opencode/ are tracked; anything OpenCode installs beside them is not
/.opencode/node_modules/
/.opencode/package.json
/.opencode/package-lock.json
/.opencode/bun.lock

# Planning notes, kept in a separate private repository
/.superpowers/

# Local scratch
/humanize/

# Signing keys and signatures made by hand (docs/developer-guide/releases.md): a generated key is
# never committed by accident. The public key, apps/mercury-desktop/resources/update-key.pub, is
# the one file of the kind that is tracked, and none of these patterns matches it.
*.key
mercury-update-key*
update.json.minisig
/update.json
