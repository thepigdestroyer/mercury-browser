{
  "manifest_version": 2,
  "name": "Old Style",
  "version": "0.9",
  "description": "A Chrome manifest version 2 extension used as a test fixture.",
  "browser_action": { "default_title": "Old", "default_icon": "icon.png", "default_popup": "popup.html" },
  "background": { "scripts": ["bg.js"], "persistent": false },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["cs.js"], "run_at": "document_end", "match_about_blank": true }
  ],
  "permissions": ["tabs", "http://*/*", "https://mail.example.com/*", "webRequest", "webRequestBlocking", "cookies"],
  "optional_permissions": ["bookmarks", "https://*.example.net/*"],
  "web_accessible_resources": ["images/*.png", "style.css"],
  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'",
  "options_page": "options.html",
  "incognito": "not_allowed"
}
