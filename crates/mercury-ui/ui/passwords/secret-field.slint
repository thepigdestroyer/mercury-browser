// A one-line field for a secret being typed, drawn like the settings window's `LineEdit`.
//
// a11y-base: why it is not a `LineEdit`. Slint's std `LineEdit` binds its `accessible-value` to
// its text, and the AccessKit adapter hands that value on for the password role too, which
// macOS gives to every assistive technology as the field's AXValue, unmasked. A password typed
// here would be readable by any program with accessibility access, which is more than the
// screen shows. This field gives an assistive technology a label and a placeholder, and
// never the text, whether the dots or the characters are drawn. An assistive technology can
// still type into it (set-value), as VoiceOver does by dictation. `tests/a11y_windows.rs` types a
// password into it and reads the value; `tests/a11y_secrets.rs` fails when a field with a
// password input type is written anywhere else.

import { Palette } from "std-widgets.slint";

export component SecretField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    // What the field is for, said by a screen reader (the placeholder when this is empty).
    in property <string> accessible-name;
    // What the reveal button acts on, in its label: "Show the new password".
    in property <string> reveal-name: "the password";
    // Draws the characters instead of dots. Never changes what an assistive technology is given.
    in-out property <bool> revealed: false;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);

    min-width: 160px;
    height: 32px;
    horizontal-stretch: 1;
    border-radius: 4px;
    border-width: 1px;
    // As faint as the std field's own border.
    border-color: Palette.foreground.with-alpha(0.1);
    background: Palette.control-background;

    if root.text == "": Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.placeholder-text;
        color: Palette.foreground.with-alpha(0.55);
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
        // The field's `accessible-placeholder-text` carries these words.
        accessible-role: none;
    }

    input := TextInput {
        x: 12px;
        // Room for the reveal button on the right while there is text to reveal.
        width: parent.width - 24px - (root.text != "" ? 50px : 0px);
        height: parent.height;
        text <=> root.text;
        color: Palette.foreground;
        selection-background-color: Palette.selection-background;
        selection-foreground-color: Palette.selection-foreground;
        font-size: 13px;
        vertical-alignment: center;
        single-line: true;
        input-type: root.revealed ? InputType.text : InputType.password;
        // Never the text: see the top of the file.
        accessible-value: "";
        accessible-label: root.accessible-name != "" ? root.accessible-name : root.placeholder-text;
        accessible-placeholder-text: root.placeholder-text;
        edited => {
            root.edited(self.text);
        }
    }

    // As the std field's focus line: two pixels of accent along the bottom.
    if input.has-focus: Rectangle {
        x: root.border-radius;
        y: parent.height - self.height;
        width: parent.width - 2 * root.border-radius;
        height: 2px;
        border-radius: 1px;
        background: Palette.accent-background;
    }

    // Show or hide what was typed, as the eye of the std field does. Without it nothing here
    // would let a person check a password they typed (there is no second field to repeat it in).
    // Not focusable, like the toolbar buttons: an assistive technology presses it without focus.
    if root.text != "": Rectangle {
        x: parent.width - self.width - 6px;
        y: (parent.height - self.height) / 2;
        width: 44px;
        height: 22px;
        border-radius: 4px;
        background: reveal-touch.has-hover ? Palette.alternate-background : transparent;
        accessible-role: button;
        accessible-label: (root.revealed ? "Hide " : "Show ") + root.reveal-name;
        accessible-action-default => {
            root.revealed = !root.revealed;
        }

        Text {
            text: root.revealed ? "Hide" : "Show";
            color: Palette.accent-background;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }

        reveal-touch := TouchArea {
            clicked => {
                root.revealed = !root.revealed;
            }
        }
    }
}
