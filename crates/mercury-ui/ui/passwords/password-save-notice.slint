// The bar under the toolbar that says a login the user asked to save could not be saved, with
// Retry (which may make macOS ask about the keychain) and Dismiss. Colours come from
// `ChromePalette` (its notice role), so the bar follows the appearance setting.

import { ChromePalette } from "../theme/chrome-palette.slint";

component NoticeButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked;

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }

    // The palette's primary fill under its label is 3.98:1 in the light theme, short of the 4.5:1
    // that 13 px text needs (the dark theme's is 9.3:1). So in the light theme this button's
    // fill is the palette's, darkened in every state (5.4:1 at rest, 4.7:1 or more hovered,
    // more when pressed); the dark theme keeps the palette's fill and its lighter hover.
    property <color> primary-rest: ChromePalette.dark
        ? ChromePalette.primary-button-background
        : ChromePalette.primary-button-background.darker(20%);
    property <color> primary-hover: ChromePalette.dark
        ? ChromePalette.primary-button-background.brighter(10%)
        : ChromePalette.primary-button-background.darker(30%);
    property <color> primary-pressed: ChromePalette.dark
        ? ChromePalette.primary-button-background.darker(15%)
        : ChromePalette.primary-button-background.darker(40%);

    width: label-text.preferred-width + 24px;
    height: 28px;
    border-radius: 7px;
    border-width: root.primary ? 0px : 1px;
    border-color: ChromePalette.notice-border;
    background: root.primary
        ? (touch.pressed
            ? root.primary-pressed
            : touch.has-hover ? root.primary-hover : root.primary-rest)
        : (touch.pressed
            ? ChromePalette.button-pressed
            : touch.has-hover ? ChromePalette.button-hover : transparent);

    label-text := Text {
        text: root.label;
        color: root.primary ? ChromePalette.primary-button-text : ChromePalette.text;
        font-size: 13px;
        font-weight: root.primary ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    // The keyboard focus ring: 2 px, outside the button with 1 px of the band between, so that it
    // shows on the primary button's blue fill too (a ring drawn on that edge is the fill's own
    // colour there). It lies within the band: the buttons are 8 px from its top and bottom.
    Rectangle {
        visible: focus.has-focus;
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-radius: root.border-radius + 3px;
        border-width: 2px;
        border-color: ChromePalette.focus-ring;
    }

    // Reached with Tab (never focused by a click); Return or Space presses it.
    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }

        touch := TouchArea {
            clicked => {
                root.clicked();
            }
        }
    }
}

export component PasswordSaveNotice inherits Rectangle {
    in property <string> text;
    callback retry();
    callback dismissed();

    height: 44px;
    background: ChromePalette.notice-background;
    // a11y-base: a group named by its message (it was a text with two buttons inside it, and the
    // drawn message was read a second time). The buttons keep exactly the labels "Retry" and
    // "Dismiss": desktop tests find them by those labels.
    accessible-role: groupbox;
    accessible-label: root.text;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 14px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 8px;

        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: ChromePalette.text;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }

        NoticeButton {
            label: "Retry";
            primary: true;
            clicked => {
                root.retry();
            }
        }

        NoticeButton {
            label: "Dismiss";
            clicked => {
                root.dismissed();
            }
        }
    }

    Rectangle {
        x: 0px;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: ChromePalette.notice-border;
    }
}
