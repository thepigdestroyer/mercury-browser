// The saved logins in the settings window's Passwords section: search, the list, one login
// opened (copy, reveal, edit, delete), the password generator, and CSV import and export.
// Everything it shows and does goes through the `PasswordManagerUi` global, which the browser
// fills for each settings window.

import { Button, CheckBox, LineEdit, Palette, SpinBox } from "std-widgets.slint";
import { ChromePalette } from "../theme/chrome-palette.slint";

export struct LoginListRow {
    site: string,
    username: string,
    kind: string,
}

export global PasswordManagerUi {
    // Where logins are kept this run, for the note under the heading.
    in property <string> storage-note;
    in property <[LoginListRow]> rows;
    // How many logins are saved, whatever the search.
    in property <int> total;
    in-out property <string> search;

    // The login opened: an index into `rows`, or -1.
    in property <int> selected: -1;
    in property <string> detail-site;
    in property <string> detail-username;
    in property <string> detail-kind;
    // The password, only while the user has asked to see it after authenticating.
    in property <string> shown-password;
    in property <bool> password-shown;
    in property <bool> editing;
    in-out property <string> edit-username;
    in-out property <string> edit-password;
    in property <string> edit-problem;
    in property <bool> confirming-delete;

    in-out property <int> generator-length: 20;
    in-out property <bool> generator-symbols: true;
    in property <string> generated;

    // The result of the last action, for example "Copied the password.".
    in property <string> status;

    callback search-edited(string);
    callback open-login(int);
    callback close-login();
    callback show-password();
    callback hide-password();
    callback copy-username();
    callback copy-password();
    callback edit-login();
    callback generate-for-edit();
    callback save-edit();
    callback cancel-edit();
    callback delete-login();
    callback confirm-delete();
    callback cancel-delete();
    callback generate();
    callback copy-generated();
    callback import-logins();
    callback export-logins();
}

component Note inherits Text {
    font-size: 12px;
    color: Palette.foreground.with-alpha(0.62);
    wrap: word-wrap;
}

component Title inherits Text {
    font-size: 13px;
    font-weight: 650;
    color: Palette.foreground;
}

component Field inherits HorizontalLayout {
    in property <string> label;
    spacing: 12px;

    Text {
        width: 110px;
        text: root.label;
        color: Palette.foreground.with-alpha(0.7);
        font-size: 13px;
        vertical-alignment: center;
    }

    @children
}

// One saved login in the list; Return, Space or a click opens it.
component LoginButton inherits Rectangle {
    in property <LoginListRow> login;
    in property <bool> selected;
    callback clicked;

    height: 40px;
    border-radius: 6px;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: ChromePalette.focus-ring;
    background: root.selected
        ? Palette.accent-background.with-alpha(0.25)
        : touch.has-hover ? Palette.alternate-background : transparent;
    accessible-role: list-item;
    accessible-label: root.login.site + ", " + root.login.username;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            Text {
                text: root.login.site;
                color: Palette.foreground;
                font-size: 13px;
                overflow: elide;
            }

            if root.login.kind != "": Text {
                text: root.login.kind;
                color: Palette.foreground.with-alpha(0.62);
                font-size: 11px;
                overflow: elide;
            }
        }

        Text {
            width: 40%;
            text: root.login.username;
            color: Palette.foreground.with-alpha(0.8);
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

export component PasswordsSection inherits VerticalLayout {
    spacing: 12px;

    Title {
        text: "Saved logins";
    }

    Note {
        text: PasswordManagerUi.storage-note;
    }

    HorizontalLayout {
        spacing: 8px;

        LineEdit {
            horizontal-stretch: 1;
            accessible-label: "Search saved logins";
            placeholder-text: "Search by site or user name";
            text <=> PasswordManagerUi.search;
            edited(text) => {
                PasswordManagerUi.search-edited(text);
            }
        }

        Button {
            text: "Import…";
            accessible-label: "Import logins from a CSV file";
            clicked => {
                PasswordManagerUi.import-logins();
            }
        }

        Button {
            text: "Export…";
            accessible-label: "Export logins to a CSV file";
            enabled: PasswordManagerUi.total > 0;
            clicked => {
                PasswordManagerUi.export-logins();
            }
        }
    }

    if PasswordManagerUi.status != "": Text {
        text: PasswordManagerUi.status;
        color: Palette.foreground;
        font-size: 12px;
        wrap: word-wrap;
        accessible-role: text;
    }

    if PasswordManagerUi.total == 0: Note {
        text: "No saved logins.";
    }

    if PasswordManagerUi.total > 0 && PasswordManagerUi.rows.length == 0: Note {
        text: "No saved login matches the search.";
    }

    VerticalLayout {
        spacing: 2px;

        for row[index] in PasswordManagerUi.rows: VerticalLayout {
            spacing: 6px;

            LoginButton {
                login: row;
                selected: PasswordManagerUi.selected == index;
                clicked => {
                    if PasswordManagerUi.selected == index {
                        PasswordManagerUi.close-login();
                    } else {
                        PasswordManagerUi.open-login(index);
                    }
                }
            }

            if PasswordManagerUi.selected == index: Rectangle {
                border-radius: 8px;
                border-width: 1px;
                border-color: Palette.border;
                background: Palette.alternate-background;
                height: detail.preferred-height;

                detail := VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    if !PasswordManagerUi.editing: Field {
                        label: "User name";
                        Text {
                            horizontal-stretch: 1;
                            text: PasswordManagerUi.detail-username;
                            color: Palette.foreground;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Button {
                            text: "Copy";
                            accessible-label: "Copy the user name";
                            clicked => {
                                PasswordManagerUi.copy-username();
                            }
                        }
                    }

                    if !PasswordManagerUi.editing: Field {
                        label: "Password";
                        Text {
                            horizontal-stretch: 1;
                            text: PasswordManagerUi.password-shown ? PasswordManagerUi.shown-password : "••••••••••";
                            color: Palette.foreground;
                            font-size: 13px;
                            vertical-alignment: center;
                            // A shown password is never shortened: it wraps.
                            wrap: PasswordManagerUi.password-shown ? TextWrap.char-wrap : TextWrap.no-wrap;
                            accessible-label: PasswordManagerUi.password-shown ? "Password" : "Password, hidden";
                        }
                        Button {
                            text: PasswordManagerUi.password-shown ? "Hide" : "Show";
                            accessible-label: PasswordManagerUi.password-shown ? "Hide the password" : "Show the password";
                            clicked => {
                                if PasswordManagerUi.password-shown {
                                    PasswordManagerUi.hide-password();
                                } else {
                                    PasswordManagerUi.show-password();
                                }
                            }
                        }
                        Button {
                            text: "Copy";
                            accessible-label: "Copy the password";
                            clicked => {
                                PasswordManagerUi.copy-password();
                            }
                        }
                    }

                    if PasswordManagerUi.detail-kind != "" && !PasswordManagerUi.editing: Note {
                        text: PasswordManagerUi.detail-kind;
                    }

                    if PasswordManagerUi.editing: Field {
                        label: "User name";
                        LineEdit {
                            horizontal-stretch: 1;
                            accessible-label: "New user name";
                            text <=> PasswordManagerUi.edit-username;
                        }
                    }

                    if PasswordManagerUi.editing: Field {
                        label: "Password";
                        LineEdit {
                            horizontal-stretch: 1;
                            accessible-label: "New password";
                            input-type: password;
                            placeholder-text: "Unchanged";
                            text <=> PasswordManagerUi.edit-password;
                        }
                        Button {
                            text: "Generate";
                            accessible-label: "Generate a new password";
                            clicked => {
                                PasswordManagerUi.generate-for-edit();
                            }
                        }
                    }

                    if PasswordManagerUi.edit-problem != "": Text {
                        text: PasswordManagerUi.edit-problem;
                        color: ChromePalette.danger;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    if PasswordManagerUi.confirming-delete: Text {
                        text: "Delete the login for " + PasswordManagerUi.detail-site + "? This cannot be undone.";
                        color: Palette.foreground;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;

                        if PasswordManagerUi.editing: Button {
                            text: "Cancel";
                            clicked => {
                                PasswordManagerUi.cancel-edit();
                            }
                        }
                        if PasswordManagerUi.editing: Button {
                            text: "Save";
                            primary: true;
                            accessible-label: "Save the login";
                            clicked => {
                                PasswordManagerUi.save-edit();
                            }
                        }

                        if PasswordManagerUi.confirming-delete: Button {
                            text: "Cancel";
                            accessible-label: "Keep the login";
                            clicked => {
                                PasswordManagerUi.cancel-delete();
                            }
                        }
                        if PasswordManagerUi.confirming-delete: Button {
                            text: "Delete";
                            accessible-label: "Delete the login now";
                            clicked => {
                                PasswordManagerUi.confirm-delete();
                            }
                        }

                        if !PasswordManagerUi.editing && !PasswordManagerUi.confirming-delete: Button {
                            text: "Delete…";
                            accessible-label: "Delete the login";
                            clicked => {
                                PasswordManagerUi.delete-login();
                            }
                        }
                        if !PasswordManagerUi.editing && !PasswordManagerUi.confirming-delete: Button {
                            text: "Edit";
                            accessible-label: "Edit the login";
                            clicked => {
                                PasswordManagerUi.edit-login();
                            }
                        }
                    }
                }
            }
        }
    }

    Note {
        text: "Showing or copying a password asks for Touch ID or your Mac's login password. A copied password is removed from the clipboard after a minute. To fill a login into a page, right-click its password field and choose \"Fill login…\".";
    }

    Title {
        text: "Password generator";
    }

    HorizontalLayout {
        spacing: 12px;

        Text {
            text: "Length";
            color: Palette.foreground;
            font-size: 13px;
            vertical-alignment: center;
        }

        SpinBox {
            width: 110px;
            accessible-label: "Password length";
            minimum: 8;
            maximum: 128;
            value <=> PasswordManagerUi.generator-length;
        }

        CheckBox {
            text: "Symbols";
            checked <=> PasswordManagerUi.generator-symbols;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Button {
            text: "Generate";
            accessible-label: "Generate a password";
            clicked => {
                PasswordManagerUi.generate();
            }
        }
    }

    if PasswordManagerUi.generated != "": HorizontalLayout {
        spacing: 8px;

        Text {
            horizontal-stretch: 1;
            text: PasswordManagerUi.generated;
            color: Palette.foreground;
            font-family: "Menlo";
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
            accessible-label: "Generated password";
        }

        Button {
            text: "Copy";
            accessible-label: "Copy the generated password";
            clicked => {
                PasswordManagerUi.copy-generated();
            }
        }
    }

    Note {
        text: "An exported file holds every password in clear text: keep it only as long as you need it, and do not open it in a spreadsheet.";
    }
}
