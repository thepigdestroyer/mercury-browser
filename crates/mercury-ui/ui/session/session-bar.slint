// The bar under the toolbar that offers to restore tabs after Mercury Browser did not close
// properly, or shows a one-time message about the session.

component SessionBarButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked;

    width: label-text.preferred-width + 24px;
    height: 28px;
    border-radius: 7px;
    border-width: root.primary ? 0px : 1px;
    border-color: #2f3a46;
    background: root.primary
        ? (touch.pressed ? #45a9ed : touch.has-hover ? #78caff : #62bfff)
        : (touch.pressed ? #222d39 : touch.has-hover ? #19222c : #141b23);

    label-text := Text {
        text: root.label;
        color: root.primary ? #09131c : #dbe4ee;
        font-size: 13px;
        font-weight: root.primary ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

component SessionChoice inherits Rectangle {
    in property <string> label;
    callback clicked;

    height: 32px;
    border-radius: 6px;
    background: touch.pressed ? #222d39 : touch.has-hover ? #1d2731 : transparent;

    Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.label;
        color: #dbe4ee;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component SessionBar inherits Rectangle {
    // Sessions that did not close properly, newest first, as named for the chooser. While any
    // are listed the bar offers to restore them; otherwise it shows `notice`.
    in property <[string]> sessions;
    in property <string> notice;
    // Restore the session at this index of `sessions`.
    callback restore(int);
    callback dismiss();
    callback dismiss-notice();

    // Opens the list of sessions to choose from (when more than one is held).
    public function open-chooser() {
        chooser.show();
    }

    // Restores the session chosen in the list.
    public function choose(index: int) {
        chooser.close();
        root.restore(index);
    }

    height: 44px;
    background: #16202b;

    Rectangle {
        x: 0px;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: #202832;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 14px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 8px;

        Text {
            horizontal-stretch: 1;
            text: root.sessions.length > 0
                ? "Mercury Browser didn't close properly. Restore your tabs?"
                : root.notice;
            color: #edf4fa;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.sessions.length > 1: SessionBarButton {
            label: "Choose a session…";
            clicked => {
                root.open-chooser();
            }
        }

        if root.sessions.length > 0: SessionBarButton {
            label: "Restore";
            primary: true;
            clicked => {
                root.restore(0);
            }
        }

        if root.sessions.length > 0: SessionBarButton {
            label: "Dismiss";
            clicked => {
                root.dismiss();
            }
        }

        if root.sessions.length == 0: SessionBarButton {
            label: "OK";
            clicked => {
                root.dismiss-notice();
            }
        }
    }

    chooser := PopupWindow {
        x: root.width - self.width - 14px;
        y: root.height - 4px;
        width: 340px;

        Rectangle {
            border-radius: 9px;
            border-width: 1px;
            border-color: #2f3a46;
            background: #151d26;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000080;

            VerticalLayout {
                padding: 6px;
                spacing: 2px;

                HorizontalLayout {
                    padding-left: 10px;
                    height: 26px;

                    Text {
                        text: "Restore which session?";
                        color: #8c99a9;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                for label[index] in root.sessions: SessionChoice {
                    label: label;
                    clicked => {
                        root.choose(index);
                    }
                }
            }
        }
    }
}
