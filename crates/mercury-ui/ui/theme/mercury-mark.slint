// The Mercury Browser mark (a disc crossed by the M sigil) in the colours of the theme: the disc
// is the fill accent of the palette (`primary-button-background`) and the M is the colour drawn
// on that accent (`primary-button-text`), so the mark changes with the palette and the scheme and
// is legible on it (4.5:1, a rule of every selectable palette). Two flat one-colour SVGs, tinted
// here; there is no per-theme copy of the image.
//
// `inverted` swaps the two colours: use it when the mark sits on a surface that is itself the fill
// accent (a selected row, `item-selected`), where an accent disc would vanish. The disc is then the
// `item-selected-text` (what is drawn on a selected row) and the M is `item-selected`, so the pair
// keeps the 4.5:1 the palette's rules give text on a selected row.
//
// Use it wherever the mark is drawn inside the browser's own windows. The window `icon` properties
// are static pictures that cannot follow a palette; the Dock icon is set at run time by the app
// (`apps/mercury-desktop/src/dock_icon.rs`).
import { ChromePalette } from "chrome-palette.slint";

export component MercuryMark inherits Rectangle {
    // Use the heavier M at 24 px and below (tab icons, list rows).
    in property <bool> heavy: false;
    // Swap the disc and the M colours (the mark on a selected row).
    in property <bool> inverted: false;

    background: transparent;
    accessible-role: none;

    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("mercury-mark-disc.svg");
        colorize: root.inverted ? ChromePalette.item-selected-text : ChromePalette.primary-button-background;
        image-fit: contain;
        accessible-role: none;
    }

    if !root.heavy: Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("mercury-mark-m.svg");
        colorize: root.inverted ? ChromePalette.item-selected : ChromePalette.primary-button-text;
        image-fit: contain;
        accessible-role: none;
    }

    if root.heavy: Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("mercury-mark-m-heavy.svg");
        colorize: root.inverted ? ChromePalette.item-selected : ChromePalette.primary-button-text;
        image-fit: contain;
        accessible-role: none;
    }
}
