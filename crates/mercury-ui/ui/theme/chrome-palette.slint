// Rule: every window gets its own copy of this global, so each window's Rust side must call
// `settings::apply_chrome_theme(&window)` once after creating it; colours come only from here.
import { Palette } from "std-widgets.slint";

// The appearance setting, as the browser's own chrome applies it.
export enum ChromeTheme {
    system,
    light,
    dark,
}

// The colours of every role in one scheme. Rust pushes two of these (one per scheme) into
// `ChromePalette`; the field names are the roles' names (mercury-appearance `Role::slint_name`).
export struct ChromeColors {
    window-background: color,
    toolbar-background: color,
    toolbar-divider: color,
    content-background: color,
    field-background: color,
    field-border: color,
    search-field-background: color,
    search-field-border: color,
    text: color,
    text-secondary: color,
    text-muted: color,
    placeholder: color,
    accent: color,
    button-label: color,
    button-label-hover: color,
    button-hover: color,
    button-pressed: color,
    tab-active: color,
    tab-hover: color,
    tab-title-inactive: color,
    tab-close-hover: color,
    tab-close-pressed: color,
    tab-close-label: color,
    status-background: color,
    status-border: color,
    status-text: color,
    notice-background: color,
    notice-border: color,
    info-background: color,
    info-border: color,
    info-text: color,
    popup-background: color,
    popup-border: color,
    item-hover: color,
    item-selected: color,
    item-selected-text: color,
    separator: color,
    shortcut-text: color,
    disabled-text: color,
    scrim: color,
    sheet-background: color,
    shadow: color,
    primary-button-background: color,
    primary-button-hover: color,
    primary-button-pressed: color,
    primary-button-text: color,
    danger: color,
    focus-ring: color,
    match-highlight: color,
    page-popup-background: color,
    page-popup-border: color,
    page-popup-caption: color,
    capture-indicator: color,
    capture-indicator-glyph: color,
}

// The browser chrome's colours, by role. Every part of the browser's own UI takes its colours
// from here, so that it follows the appearance setting. The dark values are the chrome's
// original ones; with `system` the chrome follows the window's colour scheme, and stays dark
// when that is unknown.
export global ChromePalette {
    in property <ChromeTheme> theme: ChromeTheme.system;
    out property <bool> dark: root.theme == ChromeTheme.system
        ? Palette.color-scheme != ColorScheme.light
        : root.theme == ChromeTheme.dark;

    // The colours of each scheme: what Rust pushes (`mercury_ui::apply_look`) and what a window
    // nobody pushes to shows. The defaults are the chrome's original colours (the `hermes`
    // palette of mercury-appearance), so nothing changes until Rust sets them. The role
    // properties below choose between the two tables by `dark`.
    in property <ChromeColors> light-colours: {
        window-background: #e9edf2,
        toolbar-background: #f7f8fa,
        toolbar-divider: #d6dce3,
        content-background: #f4f6f8,
        field-background: #ffffff,
        field-border: #c5ccd5,
        search-field-background: #ffffff,
        search-field-border: #c5ccd5,
        text: #141a21,
        text-secondary: #5a6573,
        text-muted: #6a7480,
        placeholder: #7d8794,
        accent: #b4410c,
        button-label: #4d5866,
        button-label-hover: #9e390a,
        button-hover: #e2e7ed,
        button-pressed: #d3dae2,
        tab-active: #ffffff,
        tab-hover: #dde3ea,
        tab-title-inactive: #5a6573,
        tab-close-hover: #d8dee6,
        tab-close-pressed: #c8d0da,
        tab-close-label: #6a7480,
        status-background: #ffffff,
        status-border: #c5ccd5,
        status-text: #2d3540,
        notice-background: #fff4d6,
        notice-border: #e8cf87,
        info-background: #f6f1fb,
        info-border: #cfc3e6,
        info-text: #141a21,
        popup-background: #ffffff,
        popup-border: #c5ccd5,
        item-hover: #e8edf3,
        item-selected: #b4410c,
        item-selected-text: #ffffff,
        separator: #d6dce3,
        shortcut-text: #6a7480,
        disabled-text: #9aa3ad,
        scrim: #0000004d,
        sheet-background: #ffffff,
        shadow: #00000040,
        primary-button-background: #b4410c,
        primary-button-hover: #9e390a,
        primary-button-pressed: #873009,
        primary-button-text: #ffffff,
        danger: #b3261e,
        focus-ring: #9e390a,
        match-highlight: #9e390a,
        // --- controls: page popups ---
        page-popup-background: #fdfdfd,
        page-popup-border: #b9b9be,
        page-popup-caption: #6e6e73,
        // --- end controls ---
        // --- media-capture ---
        capture-indicator: #d93025,
        capture-indicator-glyph: #ffffff,
        // --- end media-capture ---
    };
    in property <ChromeColors> dark-colours: {
        window-background: #0b0f14,
        toolbar-background: #11171f,
        toolbar-divider: #202832,
        content-background: #0c1117,
        field-background: #1a222c,
        field-border: #29323d,
        search-field-background: #171f29,
        search-field-border: #29333e,
        text: #edf4fa,
        text-secondary: #8c99a9,
        text-muted: #727f8f,
        placeholder: #717e8e,
        accent: #ffb547,
        button-label: #9aa6b5,
        button-label-hover: #ffc46b,
        button-hover: #19222c,
        button-pressed: #222d39,
        tab-active: #161e28,
        tab-hover: #111820,
        tab-title-inactive: #8b98a8,
        tab-close-hover: #222c37,
        tab-close-pressed: #2b3744,
        tab-close-label: #7f8c9c,
        status-background: #1a222c,
        status-border: #29323d,
        status-text: #c9d3de,
        notice-background: #2a2212,
        notice-border: #5c4a1f,
        info-background: #1e1830,
        info-border: #3d3160,
        info-text: #edf4fa,
        popup-background: #161e28,
        popup-border: #2b3744,
        item-hover: #1f2a36,
        item-selected: #e8892e,
        item-selected-text: #1a1233,
        separator: #29323d,
        shortcut-text: #7f8c9c,
        disabled-text: #5d6a7a,
        scrim: #00000099,
        sheet-background: #141b24,
        shadow: #00000080,
        primary-button-background: #ffb547,
        primary-button-hover: #ffc46b,
        primary-button-pressed: #f59e2f,
        primary-button-text: #1a1233,
        danger: #ff9e94,
        focus-ring: #ffd08a,
        match-highlight: #ffc46b,
        // --- controls: page popups ---
        page-popup-background: #2b2b2e,
        page-popup-border: #4b4b50,
        page-popup-caption: #a2a2a8,
        // --- end controls ---
        // --- media-capture ---
        capture-indicator: #ff5f57,
        capture-indicator-glyph: #ffffff,
        // --- end media-capture ---
    };

    out property <color> window-background: root.dark ? root.dark-colours.window-background : root.light-colours.window-background;
    out property <color> toolbar-background: root.dark ? root.dark-colours.toolbar-background : root.light-colours.toolbar-background;
    out property <color> toolbar-divider: root.dark ? root.dark-colours.toolbar-divider : root.light-colours.toolbar-divider;
    out property <color> content-background: root.dark ? root.dark-colours.content-background : root.light-colours.content-background;
    out property <color> field-background: root.dark ? root.dark-colours.field-background : root.light-colours.field-background;
    out property <color> field-border: root.dark ? root.dark-colours.field-border : root.light-colours.field-border;
    out property <color> search-field-background: root.dark ? root.dark-colours.search-field-background : root.light-colours.search-field-background;
    out property <color> search-field-border: root.dark ? root.dark-colours.search-field-border : root.light-colours.search-field-border;
    out property <color> text: root.dark ? root.dark-colours.text : root.light-colours.text;
    out property <color> text-secondary: root.dark ? root.dark-colours.text-secondary : root.light-colours.text-secondary;
    out property <color> text-muted: root.dark ? root.dark-colours.text-muted : root.light-colours.text-muted;
    out property <color> placeholder: root.dark ? root.dark-colours.placeholder : root.light-colours.placeholder;
    // Accents (this, the hover labels, selections, primary buttons, focus rings and match
    // highlights) are the brand's Sun orange; tests/palette_contrast.rs checks that each one meets
    // WCAG AA on every surface it is drawn on, in Light and in Dark.
    out property <color> accent: root.dark ? root.dark-colours.accent : root.light-colours.accent;
    out property <color> button-label: root.dark ? root.dark-colours.button-label : root.light-colours.button-label;
    out property <color> button-label-hover: root.dark ? root.dark-colours.button-label-hover : root.light-colours.button-label-hover;
    out property <color> button-hover: root.dark ? root.dark-colours.button-hover : root.light-colours.button-hover;
    out property <color> button-pressed: root.dark ? root.dark-colours.button-pressed : root.light-colours.button-pressed;
    out property <color> tab-active: root.dark ? root.dark-colours.tab-active : root.light-colours.tab-active;
    out property <color> tab-hover: root.dark ? root.dark-colours.tab-hover : root.light-colours.tab-hover;
    out property <color> tab-title-inactive: root.dark ? root.dark-colours.tab-title-inactive : root.light-colours.tab-title-inactive;
    out property <color> tab-close-hover: root.dark ? root.dark-colours.tab-close-hover : root.light-colours.tab-close-hover;
    out property <color> tab-close-pressed: root.dark ? root.dark-colours.tab-close-pressed : root.light-colours.tab-close-pressed;
    out property <color> tab-close-label: root.dark ? root.dark-colours.tab-close-label : root.light-colours.tab-close-label;
    out property <color> status-background: root.dark ? root.dark-colours.status-background : root.light-colours.status-background;
    out property <color> status-border: root.dark ? root.dark-colours.status-border : root.light-colours.status-border;
    out property <color> status-text: root.dark ? root.dark-colours.status-text : root.light-colours.status-text;
    // A warning bar (the settings notice).
    out property <color> notice-background: root.dark ? root.dark-colours.notice-background : root.light-colours.notice-background;
    out property <color> notice-border: root.dark ? root.dark-colours.notice-border : root.light-colours.notice-border;
    // An information bar (for example "restore your tabs?"); text on it uses `info-text`.
    out property <color> info-background: root.dark ? root.dark-colours.info-background : root.light-colours.info-background;
    out property <color> info-border: root.dark ? root.dark-colours.info-border : root.light-colours.info-border;
    out property <color> info-text: root.dark ? root.dark-colours.info-text : root.light-colours.info-text;

    // Popups and menus.
    out property <color> popup-background: root.dark ? root.dark-colours.popup-background : root.light-colours.popup-background;
    out property <color> popup-border: root.dark ? root.dark-colours.popup-border : root.light-colours.popup-border;
    out property <color> item-hover: root.dark ? root.dark-colours.item-hover : root.light-colours.item-hover;
    out property <color> item-selected: root.dark ? root.dark-colours.item-selected : root.light-colours.item-selected;
    out property <color> item-selected-text: root.dark ? root.dark-colours.item-selected-text : root.light-colours.item-selected-text;
    out property <color> separator: root.dark ? root.dark-colours.separator : root.light-colours.separator;
    // A shortcut shown beside a menu item.
    out property <color> shortcut-text: root.dark ? root.dark-colours.shortcut-text : root.light-colours.shortcut-text;
    out property <color> disabled-text: root.dark ? root.dark-colours.disabled-text : root.light-colours.disabled-text;

    // Dialog sheets.
    // Laid over the page behind a sheet.
    out property <color> scrim: root.dark ? root.dark-colours.scrim : root.light-colours.scrim;
    out property <color> sheet-background: root.dark ? root.dark-colours.sheet-background : root.light-colours.sheet-background;
    out property <color> shadow: root.dark ? root.dark-colours.shadow : root.light-colours.shadow;
    out property <color> primary-button-background: root.dark ? root.dark-colours.primary-button-background : root.light-colours.primary-button-background;
    out property <color> primary-button-hover: root.dark ? root.dark-colours.primary-button-hover : root.light-colours.primary-button-hover;
    out property <color> primary-button-pressed: root.dark ? root.dark-colours.primary-button-pressed : root.light-colours.primary-button-pressed;
    out property <color> primary-button-text: root.dark ? root.dark-colours.primary-button-text : root.light-colours.primary-button-text;
    // Errors and destructive actions; readable as text on `sheet-background` and the windows.
    out property <color> danger: root.dark ? root.dark-colours.danger : root.light-colours.danger;
    // The outline of the control that has keyboard focus.
    out property <color> focus-ring: root.dark ? root.dark-colours.focus-ring : root.light-colours.focus-ring;

    // The part of a suggestion that matches what was typed.
    out property <color> match-highlight: root.dark ? root.dark-colours.match-highlight : root.light-colours.match-highlight;

    // --- controls: page popups ---
    // Select lists, colour pickers and context menus a page opens: neutral grey, unlike the
    // blue-grey `popup-*` of the browser's own menus, so they never pass for browser UI.
    out property <color> page-popup-background: root.dark ? root.dark-colours.page-popup-background : root.light-colours.page-popup-background;
    out property <color> page-popup-border: root.dark ? root.dark-colours.page-popup-border : root.light-colours.page-popup-border;
    // The line naming the page above a select list or colour picker.
    out property <color> page-popup-caption: root.dark ? root.dark-colours.page-popup-caption : root.light-colours.page-popup-caption;
    // --- end controls ---

    // --- media-capture ---
    // The mark of a page that may use the camera or microphone: on its tab and beside the
    // address bar. Red, as other browsers and macOS's own indicators use for recording.
    out property <color> capture-indicator: root.dark ? root.dark-colours.capture-indicator : root.light-colours.capture-indicator;
    // A glyph drawn on `capture-indicator`.
    out property <color> capture-indicator-glyph: root.dark ? root.dark-colours.capture-indicator-glyph : root.light-colours.capture-indicator-glyph;
    // --- end media-capture ---
}
