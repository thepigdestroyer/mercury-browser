// SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
// SPDX-FileCopyrightText: 2026 Mrinal Joshi and the Mercury Browser contributors
// The Orbit overview (SPEC design/ui-final/SPEC.md §4.6): a full-window overlay with the title bar, the
// sun and the planets (level 1), one group's ring with its tab previews (level 2) and one tab almost
// full size (level 3), the "New group" ring, the key hints and the new-group popover. Rust
// (src/orbit_view) decides what is where and what a click means; this file draws and reports.
//
// The properties and callbacks the lane scaffold named are the contract that the desktop glue
// (item 5) and layout-switch build on; nothing was renamed or removed. ADDED by item 4 `view`:
//   - `search-text` is `in-out` (it follows what the user types; Rust still sets it to clear it);
//   - `focus-tab` (in): the tab the keyboard focus is on at level 2 (the centre ring's focus ring);
//   - `public function focus-search()` (the machine's `FocusSearch`) and `focus-view()` (the
//     overlay's key scope takes the keyboard focus when Orbit opens);
//   - drag and drop payloads (brief D11): `pure payload-for(kind, id) -> data-transfer` (what a
//     `DragArea` carries: kind "tab" or "group"; an empty `DataTransfer` makes it undraggable),
//     `pure payload-accepts(data, kind, id, slot) -> bool` (what `DropArea.can-drop` asks; kind
//     "group" for a planet, a chip and the centre ring, "new-group", "empty"; slot -1 = at the end),
//     `payload-dropped(data, kind, id, slot) -> bool`;
//   - `drag-over(kind, id, x, y)`: a `DragArea` drag is over a drop target, in stage coordinates
//     (also the pointer position for the ghost);
//   - `drag-source-started(kind, id)` / `drag-source-finished(accepted)`: a `DragArea` drag began and
//     ended (kind "tab" for a preview, "group" for a planet);
//   - `public function cancel-ring-drag()` (ends every ring's own drag; it also runs by itself on a
//     level change) and `out property ring-drag-source` (the tab a ring is dragging, -1 for none);
// The Command key reaches `key-pressed` as its second argument and Control as the fifth (Slint calls
// the Command key `control` and the Control key `meta` on macOS).
//
// ADDED by the fix round (review F1, F2, F3, F5, F8, F12, F20):
//   - `out property <bool> text-field-focused`: the search field or the popover's name field has the
//     keyboard focus (the host lets such a key through to the field);
//   - `public function play-open()` and `out property <float> open-progress` (0..1; with the derived
//     `open-scale` and `open-opacity`): the 320 ms open animation (SPEC §7: 80 ms the page lifts into
//     a card, 160 ms it shrinks toward its group, 80 ms it settles); progress is 1 at once with
//     `reduce-motion`, and 1 is exactly the static frame;
//   - `focus-view()` also ends a pinch that never ended (`pinch-live`, `pinch-progress`);
//   - the keyboard focus ring (ChromePalette.focus-ring, 2 px) on the level-3 card, the focused
//     preview and the two buttons "Back to the page" and "New group".

import { RingDropTarget, RingHit } from "../groups/ring-bands.slint";
import { ChromePalette } from "../theme/chrome-palette.slint";
import { PlanetRing } from "planet-ring.slint";
import { LetterChip, PreviewCard, TabPicture } from "preview-card.slint";
import { Sun } from "sun.slint";
import { OrbitCard, OrbitChip, OrbitDragView, OrbitLevel, OrbitNeighbour, OrbitNewGroup, OrbitPlanet, OrbitPopover, OrbitPreviewCard, OrbitSun } from "orbit-models.slint";
export { OrbitCard, OrbitChip, OrbitDragView, OrbitLevel, OrbitNeighbour, OrbitNewGroup, OrbitPlanet, OrbitPopover, OrbitPreviewCard, OrbitSun } from "orbit-models.slint";

// A key of the footer hints: 22 px high, radius 6.
component Keycap inherits Rectangle {
    in property <string> label;

    height: 22px;
    width: max(22px, cap.preferred-width + 12px);
    border-radius: 6px;
    border-width: 1px;
    border-color: ChromePalette.separator;
    background: ChromePalette.item-hover;

    cap := Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        font-size: 11.5px;
        font-weight: 600;
        color: ChromePalette.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// One hint: its keys, then what they do.
component Hint inherits HorizontalLayout {
    in property <[string]> keys;
    in property <string> label;

    spacing: 4px;
    alignment: start;

    for key in root.keys: Keycap {
        label: key;
    }
    Text {
        text: root.label;
        font-size: 12px;
        color: ChromePalette.text-secondary;
        vertical-alignment: center;
        accessible-role: none;
    }
}

export component OrbitView inherits Rectangle {
    // What to draw (Rust: orbit_view::data::OrbitModels).
    in property <OrbitLevel> level: OrbitLevel.groups;
    in property <[OrbitPlanet]> planets;
    // The group's ring at levels 2 and 3 (a planet row with its own ring size).
    in property <OrbitPlanet> centre;
    in property <bool> has-centre;
    in property <[OrbitPreviewCard]> previews;
    // "+N more" when a group has more tabs than the two preview rings show.
    in property <int> more-previews;
    in property <[OrbitChip]> chips;
    in property <[OrbitNeighbour]> neighbours;
    in property <OrbitCard> card;
    in property <OrbitSun> sun;
    in property <OrbitNewGroup> new-group;
    in property <OrbitDragView> drag;
    in property <OrbitPopover> popover;
    // "Orbit", then the group, then the tab.
    in property <[string]> crumbs;
    // What the empty search field says ("Search 40 tabs"): the host sets it.
    in property <string> search-placeholder: "Search tabs";
    in-out property <string> search-text <=> field.text;
    in property <bool> query-active;
    // The tab the keyboard focus is on at level 2 (draws the focus ring in the centre ring).
    in property <int> focus-tab: -1;
    // The container's accessible label ("Orbit, every group", ...).
    in property <string> container-label: "Orbit";
    // A one-line notice (a drop that was refused), empty for none.
    in property <string> notice;
    // The pinch's progress, -1..1, while a pinch runs (the stage scales with it); 0 at rest.
    in-out property <float> pinch-progress: 0;
    // true from the first to the last update of a pinch (the stage follows the fingers at once, no
    // spring-back); the view sets it. Hosts leave it alone; `focus-view` clears a stale one.
    in-out property <bool> pinch-live: false;
    in property <bool> reduce-motion: false;
    in property <bool> animate-spinners: true;
    // The search field or the popover's name field has the keyboard focus.
    out property <bool> text-field-focused: field.has-focus || (root.popover.visible && root.popover-field-focus);
    // The open animation, 0 to 1 (`play-open`); 1 at rest.
    out property <float> open-progress: 1;
    // What the stage draws at that progress: 0.94 to 0.98 and opacity 0 to 0.6 in the first quarter,
    // on to 1.02 and opacity 1 by the third, back to 1 at the end (exactly 1 and 1 at progress 1).
    out property <float> open-scale: root.open-progress >= 1 ? 1 : 0.94 + 0.04 * clamp(root.open-progress / 0.25, 0, 1) + 0.04 * clamp((root.open-progress - 0.25) / 0.5, 0, 1) - 0.02 * clamp((root.open-progress - 0.75) / 0.25, 0, 1);
    out property <float> open-opacity: root.open-progress >= 1 ? 1 : 0.6 * clamp(root.open-progress / 0.25, 0, 1) + 0.4 * clamp((root.open-progress - 0.25) / 0.5, 0, 1);

    // What happened (Rust: orbit_view::machine::OrbitMachine). Ids are row ids.
    callback planet-hovered(int);       // -1: none
    callback planet-clicked(int);
    callback preview-hovered(int);      // -1: none
    callback preview-clicked(int);
    callback chip-clicked(int);
    callback card-clicked();
    callback neighbour-clicked(int);
    callback backdrop-clicked();
    callback new-group-clicked();
    callback back-clicked();            // "Back to the page"
    callback search-edited(string);
    // A key the view did not use itself: text, command, shift, alt, control. true = handled.
    callback key-pressed(string, bool, bool, bool, bool) -> bool;
    callback pinch-started(length, length);
    callback pinch-updated(float);      // the cumulative scale
    callback pinch-ended();
    callback pinch-cancelled();
    // A tab dragged inside a planet's ring or the centre ring (RingBands' own drag), reported with
    // the planet's group id; the moved point is in stage coordinates.
    callback ring-drag-started(int, int);   // group, tab
    callback ring-drag-moved(length, length);   // stage coordinates
    callback ring-dropped(int, int);        // group, insertion slot
    callback ring-drag-cancelled();
    callback popover-name-edited(string);
    callback popover-colour-chosen(int);
    callback popover-confirmed();
    callback popover-cancelled();
    // The pure hit tests of the planets' rings (group id first): forwarded to RingBandsData.
    pure callback ring-hit-test(int, length, length, int) -> RingHit;
    pure callback ring-drop-target(int, length, length, int) -> RingDropTarget;
    // Drag and drop with DragArea and DropArea (see the list of additions above).
    pure callback payload-for(string, int) -> data-transfer;
    pure callback payload-accepts(data-transfer, string, int, int) -> bool;
    callback payload-dropped(data-transfer, string, int, int) -> bool;
    callback drag-over(string, int, length, length);
    callback drag-source-started(string, int);
    callback drag-source-finished(bool);

    public function focus-search() {
        field.focus();
    }

    // The overlay's key scope takes the keyboard focus (Orbit opens, the search or the popover
    // closes). It also ends a pinch whose `ended` never came: the stage goes back to its size at
    // once (the progress is set while the pinch counts as live, so it does not animate) and the next
    // spring-back runs its 160 ms.
    public function focus-view() {
        root.pinch-live = true;
        root.pinch-progress = 0;
        root.pinch-live = false;
        scope.focus();
    }

    // Starts the open animation: progress 0, then 1 in 320 ms (linear: 80, 160 and 80 ms are the three
    // phases of `open-scale` and `open-opacity`). With `reduce-motion` it is 1 at once.
    public function play-open() {
        root.open-snap = true;
        root.open-progress = root.reduce-motion ? 1 : 0;
        root.open-snap = false;
        root.open-progress = 1;
    }

    // Ends the drag of every ring (the planets and the centre ring), as a release outside every slot
    // does: `ring-drag-cancelled` fires for a ring that had a live drag, nothing else happens. Hosts
    // call it on Esc and when Orbit closes. The rings end their drag in a change handler, which Slint
    // runs before the next event or frame.
    public function cancel-ring-drag() {
        root.cancel-tick += 1;
        root.ring-drag-source = -1;
    }

    // A level change while a ring is dragged cannot leave a ghost.
    changed level => {
        root.cancel-ring-drag();
    }

    // The tab a ring is dragging now (RingBands' own drag), -1 for none.
    out property <int> ring-drag-source: -1;
    private property <int> cancel-tick: 0;
    private property <bool> l1: root.level == OrbitLevel.groups;
    private property <bool> l2: root.level == OrbitLevel.group;
    private property <bool> l3: root.level == OrbitLevel.tab;
    private property <bool> open-snap: false;
    private property <bool> popover-field-focus: false;
    private property <duration> fade: root.reduce-motion ? 0ms : 90ms;
    // The mockup's window is 1440 x 900; the ellipses shrink with a smaller one, never grow.
    private property <float> ellipse-scale: min(1, min(root.width / 1440px, root.height / 900px));
    private property <float> ellipse-cx: root.width / 1px / 2;
    // The stage is the area between the title bar (48) and the footer strip (8): its middle.
    private property <float> ellipse-cy: root.height / 1px / 2 + 20;
    private property <float> ellipse-rx: (root.l2 ? 520 : 470) * root.ellipse-scale;
    private property <float> ellipse-ry: (root.l2 ? 292 : 290) * root.ellipse-scale;
    private property <string> group-name: root.crumbs.length > 1 ? root.crumbs[1] : "";
    private property <length> chips-end: root.chips.length > 0 ? root.chips[root.chips.length - 1].x + root.chips[root.chips.length - 1].width : 0px;

    animate pinch-progress { duration: root.pinch-live || root.reduce-motion ? 0ms : 160ms; easing: ease-out; }
    animate open-progress { duration: root.open-snap || root.reduce-motion ? 0ms : 320ms; easing: linear; }

    background: ChromePalette.window-background;
    accessible-role: none;

    scope := FocusScope {
        key-pressed(event) => {
            if root.key-pressed(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt, event.modifiers.meta) {
                return accept;
            }
            return reject;
        }

        gesture := ScaleRotateGestureHandler {
            started => {
                root.pinch-live = true;
                root.pinch-started(self.center.x, self.center.y);
            }
            updated => {
                root.pinch-progress = clamp((self.scale - 1) / 0.35, -1, 1);
                root.pinch-updated(self.scale);
            }
            ended => {
                root.pinch-live = false;
                root.pinch-ended();
            }
            cancelled => {
                root.pinch-live = false;
                root.pinch-cancelled();
            }

            stage := Rectangle {
                width: parent.width;
                height: parent.height;
                clip: true;
                transform-scale: (1 + root.pinch-progress * 0.08) * root.open-scale;
                opacity: root.open-opacity;
                accessible-role: list;
                accessible-label: root.container-label;

                // The title bar: the mark, "Orbit" and the breadcrumb, the search field, the way back.
                Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: 48px;
                    background: ChromePalette.toolbar-background;

                    Rectangle {
                        y: parent.height - 1px;
                        width: parent.width;
                        height: 1px;
                        background: ChromePalette.toolbar-divider;
                    }
                    Rectangle {
                        x: 87px;
                        y: 9px;
                        width: 30px;
                        height: 30px;
                        border-radius: 15px;
                        border-width: 2px;
                        border-color: ChromePalette.accent;
                        background: ChromePalette.accent.transparentize(0.8);
                    }
                    HorizontalLayout {
                        x: 126px;
                        y: 0;
                        height: 48px;
                        spacing: 8px;
                        alignment: start;

                        for crumb[i] in root.crumbs: HorizontalLayout {
                            spacing: 8px;

                            if i > 0: Text {
                                text: "›";
                                font-size: 14px;
                                color: ChromePalette.text-muted;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                            Text {
                                text: crumb;
                                font-size: 14px;
                                font-weight: i == 0 || i == root.crumbs.length - 1 ? 700 : 400;
                                color: i == 0 || i == root.crumbs.length - 1 ? ChromePalette.text : ChromePalette.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                    }
                    // 500 x 40, centred (mockup); a narrow window gives the breadcrumb and the way
                    // back their room first.
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: 4px;
                        width: max(120px, min(500px, parent.width - 760px));
                        height: 40px;
                        border-radius: 20px;
                        border-width: 1px;
                        border-color: field.has-focus ? ChromePalette.accent : ChromePalette.search-field-border;
                        background: ChromePalette.search-field-background;

                        Path {
                            x: 14px;
                            y: 13px;
                            width: 14px;
                            height: 14px;
                            viewbox-width: 16;
                            viewbox-height: 16;
                            commands: "M2.5 7 A4.5 4.5 0 1 0 11.5 7 A4.5 4.5 0 1 0 2.5 7 M10.3 10.3 L13.5 13.5";
                            stroke: ChromePalette.placeholder;
                            stroke-width: 1.5px;
                            accessible-role: none;
                        }
                        Text {
                            x: 36px;
                            height: parent.height;
                            text: root.search-placeholder;
                            font-size: 13px;
                            color: ChromePalette.placeholder;
                            vertical-alignment: center;
                            visible: field.text == "";
                            accessible-role: none;
                        }
                        field := TextInput {
                            x: 36px;
                            width: parent.width - 52px;
                            height: parent.height;
                            font-size: 13px;
                            color: ChromePalette.text;
                            vertical-alignment: center;
                            single-line: true;
                            accessible-label: "Search tabs";
                            accessible-placeholder-text: root.search-placeholder;
                            edited => {
                                root.search-edited(self.text);
                            }
                            accepted => {
                                root.key-pressed("\n", false, false, false, false);
                            }
                        }
                    }
                    Rectangle {
                        x: parent.width - self.width - 16px;
                        width: back-row.preferred-width;
                        height: parent.height;
                        accessible-role: button;
                        accessible-label: "Back to the page";
                        accessible-action-default => {
                            root.back-clicked();
                        }

                        back-row := HorizontalLayout {
                            spacing: 8px;
                            alignment: center;

                            Rectangle {
                                width: 32px;
                                height: parent.height;
                                Keycap {
                                    y: (parent.height - self.height) / 2;
                                    width: 32px;
                                    label: "esc";
                                }
                            }
                            Text {
                                text: "Back to the page";
                                font-size: 12.5px;
                                color: ChromePalette.text-secondary;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.back-clicked();
                            }
                        }
                        // The button takes the keyboard focus (Slint's own focus traversal, or an
                        // assistive technology's focus action) and shows the focus ring then.
                        back-focus := FocusScope {
                            width: parent.width;
                            height: parent.height;
                            // A click is the TouchArea's; the ring is for the keyboard.
                            focus-on-click: false;
                            key-pressed(event) => {
                                if event.text == "\n" || event.text == " " {
                                    root.back-clicked();
                                    return accept;
                                }
                                return reject;
                            }
                        }
                        Rectangle {
                            x: 2px;
                            y: 4px;
                            width: parent.width - 4px;
                            height: parent.height - 8px;
                            border-radius: 8px;
                            border-width: 2px;
                            border-color: ChromePalette.focus-ring;
                            visible: back-focus.has-focus;
                        }
                    }
                }

                // The stage below the title bar. Its content keeps window coordinates (the inner box
                // starts 48 px up), so the title bar comes first in the reading order and still
                // covers what the huge ring of level 3 draws under it.
                Rectangle {
                    y: 48px;
                    width: parent.width;
                    height: parent.height - 48px;
                    clip: true;

                    Rectangle {
                        y: -48px;
                        width: root.width;
                        height: root.height;

                        // The orbits: the sun's ellipse and a second, faint one.
                        Path {
                            width: parent.width;
                            height: parent.height;
                            viewbox-width: self.width / 1px;
                            viewbox-height: self.height / 1px;
                            commands: "M \{root.ellipse-cx - root.ellipse-rx} \{root.ellipse-cy} A \{root.ellipse-rx} \{root.ellipse-ry} 0 1 0 \{root.ellipse-cx + root.ellipse-rx} \{root.ellipse-cy} A \{root.ellipse-rx} \{root.ellipse-ry} 0 1 0 \{root.ellipse-cx - root.ellipse-rx} \{root.ellipse-cy}";
                            stroke: ChromePalette.separator;
                            stroke-width: 1.5px;
                            accessible-role: none;
                        }
                        Path {
                            width: parent.width;
                            height: parent.height;
                            viewbox-width: self.width / 1px;
                            viewbox-height: self.height / 1px;
                            commands: "M \{root.ellipse-cx - 640 * root.ellipse-scale} \{root.ellipse-cy} A \{640 * root.ellipse-scale} \{400 * root.ellipse-scale} 0 1 0 \{root.ellipse-cx + 640 * root.ellipse-scale} \{root.ellipse-cy} A \{640 * root.ellipse-scale} \{400 * root.ellipse-scale} 0 1 0 \{root.ellipse-cx - 640 * root.ellipse-scale} \{root.ellipse-cy}";
                            stroke: ChromePalette.separator;
                            stroke-width: 1px;
                            opacity: 0.6;
                            accessible-role: none;
                        }

                        // Empty space: a click there, and a drag released there (a new group).
                        backdrop := TouchArea {
                            y: 48px;
                            width: parent.width;
                            height: parent.height - 48px;
                            clicked => {
                                root.backdrop-clicked();
                            }
                        }
                        DropArea {
                            y: 48px;
                            width: parent.width;
                            height: parent.height - 48px;
                            can-drop(event) => {
                                root.drag-over("empty", -1, event.position.x, 48px + event.position.y);
                                if root.payload-accepts(event.data, "empty", -1, -1) {
                                    return DragAction.move;
                                }
                                return DragAction.none;
                            }
                            dropped(event) => {
                                if root.payload-accepts(event.data, "empty", -1, -1) && root.payload-dropped(event.data, "empty", -1, -1) {
                                    return DragAction.move;
                                }
                                return DragAction.none;
                            }
                        }

                        // The sun (level 1).
                        Sun {
                            x: root.sun.x - self.width / 2;
                            y: root.sun.y - self.height / 2;
                            radius: root.sun.radius;
                            title: root.sun.title;
                            subtitle: root.sun.subtitle;
                            label: root.sun.accessible-label;
                            opacity: root.sun.opacity;
                            visible: root.sun.opacity > 0.01;
                        }

                        // The spokes from the centre ring to the previews (level 2).
                        for spoke in root.previews: Path {
                            // The box is the spoke's own and a margin on every side: a vertical or
                            // horizontal spoke has a box one px wide and its 1.5 px stroke would be
                            // clipped away at the box's edge.
                            x: min(spoke.spoke-x1, spoke.spoke-x2) - 2px;
                            y: min(spoke.spoke-y1, spoke.spoke-y2) - 2px;
                            width: abs(spoke.spoke-x2 - spoke.spoke-x1) + 4px;
                            height: abs(spoke.spoke-y2 - spoke.spoke-y1) + 4px;
                            viewbox-width: self.width / 1px;
                            viewbox-height: self.height / 1px;
                            commands: "M \{(spoke.spoke-x1 - self.x) / 1px} \{(spoke.spoke-y1 - self.y) / 1px} L \{(spoke.spoke-x2 - self.x) / 1px} \{(spoke.spoke-y2 - self.y) / 1px}";
                            stroke: spoke.shade.transparentize(0.6);
                            stroke-width: 1.5px;
                            accessible-role: none;
                        }

                        // The planets (level 1).
                        for row in root.planets: PlanetRing {
                            planet: row;
                            halo-enabled: root.l1;
                            interactive: root.l1;
                            reorderable: root.l1 && row.group != -2;
                            accepts-drops: root.l1;
                            cancel-tick: root.cancel-tick;
                            query-active: root.query-active;
                            reduce-motion: root.reduce-motion;
                            animate-spinners: root.animate-spinners;
                            accessible-role: button;
                            accessible-label: row.accessible-label;
                            accessible-action-default => {
                                root.planet-clicked(row.group);
                            }

                            clicked => {
                                root.planet-clicked(row.group);
                            }
                            tab-clicked(id) => {
                                root.planet-clicked(row.group);
                            }
                            hover-changed(over) => {
                                root.planet-hovered(over ? row.group : -1);
                            }
                            ring-drag-started(tab) => {
                                root.ring-drag-started(row.group, tab);
                            }
                            ring-drag-moved(x, y) => {
                                root.ring-drag-moved(x, y);
                            }
                            ring-dropped(group, slot) => {
                                root.ring-dropped(group, slot);
                            }
                            ring-drag-cancelled() => {
                                root.ring-drag-cancelled();
                            }
                            ring-drag-live(source) => {
                                root.ring-drag-source = source;
                            }
                            hit-test(x, y, hovered) => {
                                return root.ring-hit-test(row.group, x, y, hovered);
                            }
                            drop-target(x, y, dragging) => {
                                return root.ring-drop-target(row.group, x, y, dragging);
                            }
                            payload-for(kind, id) => {
                                return root.payload-for(kind, id);
                            }
                            payload-accepts(data, kind, id, slot) => {
                                return root.payload-accepts(data, kind, id, slot);
                            }
                            payload-dropped(data, kind, id, slot) => {
                                return root.payload-dropped(data, kind, id, slot);
                            }
                            drag-over(kind, id, x, y) => {
                                root.drag-over(kind, id, x, y);
                            }
                            drag-source-started() => {
                                root.drag-source-started("group", row.group);
                            }
                            drag-source-finished(accepted) => {
                                root.drag-source-finished(accepted);
                            }
                        }

                        // The group's ring: in the middle at level 2 (it takes the pointer), huge and behind
                        // the card at level 3 (it only draws).
                        if root.has-centre && !root.l1: PlanetRing {
                            planet: root.centre;
                            // Not a constant `false`: Slint 1.17.1's remove_unused pass panics on it.
                            halo-enabled: root.l1;
                            interactive: root.l2;
                            reorderable: false;
                            accepts-drops: root.l2;
                            focused-tab: root.focus-tab;
                            dim: root.l3 ? 0.4 : 1;
                            cancel-tick: root.cancel-tick;
                            query-active: root.query-active;
                            reduce-motion: root.reduce-motion;
                            animate-spinners: root.animate-spinners;

                            tab-clicked(id) => {
                                root.preview-clicked(id);
                            }
                            tab-hovered(id) => {
                                root.preview-hovered(id);
                            }
                            ring-drag-started(tab) => {
                                root.ring-drag-started(root.centre.group, tab);
                            }
                            ring-drag-moved(x, y) => {
                                root.ring-drag-moved(x, y);
                            }
                            ring-dropped(group, slot) => {
                                root.ring-dropped(group, slot);
                            }
                            ring-drag-cancelled() => {
                                root.ring-drag-cancelled();
                            }
                            ring-drag-live(source) => {
                                root.ring-drag-source = source;
                            }
                            hit-test(x, y, hovered) => {
                                return root.ring-hit-test(root.centre.group, x, y, hovered);
                            }
                            drop-target(x, y, dragging) => {
                                return root.ring-drop-target(root.centre.group, x, y, dragging);
                            }
                            payload-for(kind, id) => {
                                return root.payload-for(kind, id);
                            }
                            payload-accepts(data, kind, id, slot) => {
                                return root.payload-accepts(data, kind, id, slot);
                            }
                            payload-dropped(data, kind, id, slot) => {
                                return root.payload-dropped(data, kind, id, slot);
                            }
                            drag-over(kind, id, x, y) => {
                                root.drag-over(kind, id, x, y);
                            }
                        }

                        // The dashed "New group" ring (level 1): lit while a drag hovers it.
                        if root.new-group.visible && root.l1: Rectangle {
                            x: root.new-group.x - root.new-group.radius;
                            y: root.new-group.y - root.new-group.radius;
                            width: 2 * root.new-group.radius;
                            height: self.width;
                            accessible-role: button;
                            accessible-label: "New group";
                            accessible-action-default => {
                                root.new-group-clicked();
                            }
                            property <bool> lit: root.new-group.lit || group-drop.has-drag;

                            Rectangle {
                                width: parent.width;
                                height: parent.height;
                                border-radius: self.width / 2;
                                background: parent.lit ? ChromePalette.accent.transparentize(0.86) : transparent;
                            }
                            Path {
                                width: parent.width;
                                height: parent.height;
                                viewbox-width: 100;
                                viewbox-height: 100;
                                commands: "M50.00 0.00 A50 50 0 0 1 56.10 0.37 M61.13 1.25 A50 50 0 0 1 66.99 2.98 M71.69 4.95 A50 50 0 0 1 77.03 7.94 M81.17 10.91 A50 50 0 0 1 85.71 15.01 M89.09 18.83 A50 50 0 0 1 92.61 23.83 M95.05 28.31 A50 50 0 0 1 97.36 33.97 M98.75 38.87 A50 50 0 0 1 99.74 44.91 M100.00 50.00 A50 50 0 0 1 99.63 56.10 M98.75 61.13 A50 50 0 0 1 97.02 66.99 M95.05 71.69 A50 50 0 0 1 92.06 77.03 M89.09 81.17 A50 50 0 0 1 84.99 85.71 M81.17 89.09 A50 50 0 0 1 76.17 92.61 M71.69 95.05 A50 50 0 0 1 66.03 97.36 M61.13 98.75 A50 50 0 0 1 55.09 99.74 M50.00 100.00 A50 50 0 0 1 43.90 99.63 M38.87 98.75 A50 50 0 0 1 33.01 97.02 M28.31 95.05 A50 50 0 0 1 22.97 92.06 M18.83 89.09 A50 50 0 0 1 14.29 84.99 M10.91 81.17 A50 50 0 0 1 7.39 76.17 M4.95 71.69 A50 50 0 0 1 2.64 66.03 M1.25 61.13 A50 50 0 0 1 0.26 55.09 M0.00 50.00 A50 50 0 0 1 0.37 43.90 M1.25 38.87 A50 50 0 0 1 2.98 33.01 M4.95 28.31 A50 50 0 0 1 7.94 22.97 M10.91 18.83 A50 50 0 0 1 15.01 14.29 M18.83 10.91 A50 50 0 0 1 23.83 7.39 M28.31 4.95 A50 50 0 0 1 33.97 2.64 M38.87 1.25 A50 50 0 0 1 44.91 0.26";
                                stroke: parent.lit ? ChromePalette.accent : ChromePalette.text-muted;
                                stroke-width: 1.5px;
                                accessible-role: none;
                            }
                            Path {
                                x: parent.width / 2 - 8px;
                                y: parent.height / 2 - 18px;
                                width: 16px;
                                height: 16px;
                                viewbox-width: 16;
                                viewbox-height: 16;
                                commands: "M8 3 V13 M3 8 H13";
                                stroke: parent.lit ? ChromePalette.accent : ChromePalette.text-muted;
                                stroke-width: 2px;
                                accessible-role: none;
                            }
                            Text {
                                y: parent.height / 2 + 4px;
                                width: parent.width;
                                height: 20px;
                                text: "New group";
                                font-size: 12px;
                                font-weight: 600;
                                color: parent.lit ? ChromePalette.accent : ChromePalette.text-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                            TouchArea {
                                clicked => {
                                    root.new-group-clicked();
                                }
                            }
                            // The ring takes the keyboard focus like a button (see "Back to the page").
                            new-group-focus := FocusScope {
                                width: parent.width;
                                height: parent.height;
                                focus-on-click: false;
                                key-pressed(event) => {
                                    if event.text == "\n" || event.text == " " {
                                        root.new-group-clicked();
                                        return accept;
                                    }
                                    return reject;
                                }
                            }
                            Rectangle {
                                x: -4px;
                                y: -4px;
                                width: parent.width + 8px;
                                height: parent.height + 8px;
                                border-radius: self.width / 2;
                                border-width: 2px;
                                border-color: ChromePalette.focus-ring;
                                visible: new-group-focus.has-focus;
                            }
                            group-drop := DropArea {
                                width: parent.width;
                                height: parent.height;
                                can-drop(event) => {
                                    root.drag-over("new-group", -1, root.new-group.x - root.new-group.radius + event.position.x, root.new-group.y - root.new-group.radius + event.position.y);
                                    if root.payload-accepts(event.data, "new-group", -1, -1) {
                                        return DragAction.move;
                                    }
                                    return DragAction.none;
                                }
                                dropped(event) => {
                                    if root.payload-accepts(event.data, "new-group", -1, -1) && root.payload-dropped(event.data, "new-group", -1, -1) {
                                        return DragAction.move;
                                    }
                                    return DragAction.none;
                                }
                            }
                        }

                        // The previews of the group's tabs (level 2).
                        for row in root.previews: PreviewCard {
                            card: row;
                            focused: scope.has-focus && root.l2 && root.focus-tab == row.tab;
                            reduce-motion: root.reduce-motion;
                            animate-spinners: root.animate-spinners;
                            accessible-role: button;
                            accessible-label: row.accessible-label;
                            accessible-action-default => {
                                root.preview-clicked(row.tab);
                            }

                            clicked => {
                                root.preview-clicked(row.tab);
                            }
                            hover-changed(over) => {
                                root.preview-hovered(over ? row.tab : -1);
                            }
                            payload-for(kind, id) => {
                                return root.payload-for(kind, id);
                            }
                            drag-source-started() => {
                                root.drag-source-started("tab", row.tab);
                            }
                            drag-source-finished(accepted) => {
                                root.drag-source-finished(accepted);
                            }
                        }

                        // The other groups (level 2): chips along the bottom, each a drop target.
                        if root.l2 && root.chips.length > 0: Text {
                            x: 30px;
                            y: root.chips[0].y + (root.chips[0].height - self.height) / 2;
                            height: 18px;
                            text: "OTHER GROUPS";
                            font-size: 10.5px;
                            font-weight: 700;
                            color: ChromePalette.text-muted;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                        for chip in root.chips: Rectangle {
                            x: chip.x;
                            y: chip.y;
                            width: chip.width;
                            height: chip.height;
                            visible: root.l2;
                            accessible-role: button;
                            accessible-label: chip.accessible-label;
                            accessible-action-default => {
                                root.chip-clicked(chip.group);
                            }
                            property <bool> lit: chip-touch.has-hover || chip-drop.has-drag;

                            Rectangle {
                                width: parent.width;
                                height: parent.height;
                                border-radius: 8px;
                                background: parent.lit ? ChromePalette.item-hover : transparent;
                                border-width: chip-drop.has-drag ? 2px : 0px;
                                border-color: ChromePalette.accent;
                            }
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 8px;
                                spacing: 6px;
                                alignment: start;

                                Rectangle {
                                    width: 18px;
                                    height: parent.height;
                                    Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        width: 16px;
                                        height: 16px;
                                        border-radius: 8px;
                                        border-width: 3px;
                                        border-color: chip.colour;
                                    }
                                }
                                Text {
                                    text: chip.name;
                                    font-size: 12.5px;
                                    color: ChromePalette.text-secondary;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }
                                Text {
                                    text: chip.key-label;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: ChromePalette.accent;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }
                            }
                            chip-touch := TouchArea {
                                clicked => {
                                    root.chip-clicked(chip.group);
                                }
                            }
                            chip-drop := DropArea {
                                width: parent.width;
                                height: parent.height;
                                can-drop(event) => {
                                    root.drag-over("group", chip.group, parent.x + event.position.x, parent.y + event.position.y);
                                    if root.payload-accepts(event.data, "group", chip.group, -1) {
                                        return DragAction.move;
                                    }
                                    return DragAction.none;
                                }
                                dropped(event) => {
                                    if root.payload-accepts(event.data, "group", chip.group, -1) && root.payload-dropped(event.data, "group", chip.group, -1) {
                                        return DragAction.move;
                                    }
                                    return DragAction.none;
                                }
                            }
                        }

                        // The neighbours of the shown tab (level 3), half off the stage, dimmed.
                        for near in root.neighbours: Rectangle {
                            x: near.x;
                            y: near.y;
                            width: near.width;
                            height: near.height;
                            opacity: 0.6;
                            visible: root.l3;
                            border-radius: 12px;
                            background: ChromePalette.popup-background;
                            clip: true;
                            accessible-role: button;
                            accessible-label: near.accessible-label;
                            accessible-action-default => {
                                root.neighbour-clicked(near.tab);
                            }

                            TabPicture {
                                y: 0;
                                width: parent.width;
                                height: parent.height - 30px;
                                picture: near.picture;
                                has-picture: near.has-picture;
                                letter: near.letter;
                                shade: near.shade;
                                title: near.title;
                                host: "";
                                unit: 1;
                            }
                            Rectangle {
                                y: parent.height - 30px;
                                height: 30px;
                                width: parent.width;
                                LetterChip {
                                    x: 10px;
                                    y: (parent.height - self.height) / 2;
                                    letter: near.letter;
                                    shade: near.shade;
                                    size: 16px;
                                }
                                Text {
                                    x: 34px;
                                    width: parent.width - 44px;
                                    height: parent.height;
                                    text: near.title;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: ChromePalette.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    accessible-role: none;
                                }
                            }
                            Rectangle {
                                width: parent.width;
                                height: parent.height;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: ChromePalette.popup-border;
                            }
                            TouchArea {
                                clicked => {
                                    root.neighbour-clicked(near.tab);
                                }
                            }
                        }

                        // The keyboard focus ring of the card (the machine puts the focus on the shown
                        // tab's card at level 3): 2 px, a little outside the accent outline.
                        if root.card.visible && root.l3 && scope.has-focus: Rectangle {
                            x: root.card.x - 4px;
                            y: root.card.y - 4px;
                            width: root.card.width + 8px;
                            height: root.card.height + 8px;
                            border-radius: 20px;
                            border-width: 2px;
                            border-color: ChromePalette.focus-ring;
                        }

                        // The shown tab almost full size (level 3): 2.5 px accent outline, a 40 px header.
                        if root.card.visible && root.l3: Rectangle {
                            x: root.card.x;
                            y: root.card.y;
                            width: root.card.width;
                            height: root.card.height;
                            border-radius: 16px;
                            background: ChromePalette.popup-background;
                            drop-shadow-blur: 30px;
                            drop-shadow-color: ChromePalette.shadow;
                            drop-shadow-offset-y: 10px;
                            clip: true;
                            accessible-role: button;
                            accessible-label: root.card.accessible-label;
                            accessible-action-default => {
                                root.card-clicked();
                            }

                            TabPicture {
                                y: 40px;
                                width: parent.width;
                                height: parent.height - 40px;
                                picture: root.card.picture;
                                has-picture: root.card.has-picture;
                                letter: root.card.letter;
                                shade: root.card.shade;
                                title: root.card.title;
                                host: root.card.host;
                                unit: 1.8;
                            }
                            Rectangle {
                                x: 0;
                                y: 0;
                                height: 40px;
                                width: parent.width;
                                background: ChromePalette.popup-background;

                                LetterChip {
                                    x: 16px;
                                    y: (parent.height - self.height) / 2;
                                    letter: root.card.letter;
                                    shade: root.card.shade;
                                    size: 24px;
                                }
                                title-text := Text {
                                    x: 48px;
                                    width: min(self.preferred-width, parent.width / 2);
                                    height: parent.height;
                                    text: root.card.title;
                                    font-size: 16px;
                                    font-weight: 700;
                                    color: ChromePalette.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    accessible-role: none;
                                }
                                Text {
                                    x: title-text.x + title-text.width + 14px;
                                    height: parent.height;
                                    text: root.card.host;
                                    font-size: 12.5px;
                                    color: ChromePalette.text-muted;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }
                                Rectangle {
                                    x: parent.width - 16px - 10px;
                                    y: (parent.height - self.height) / 2;
                                    width: 10px;
                                    height: 10px;
                                    border-radius: 5px;
                                    background: root.card.group-colour;
                                }
                                Text {
                                    x: parent.width - 16px - 10px - 8px - self.width;
                                    width: self.preferred-width;
                                    height: parent.height;
                                    text: root.card.caption;
                                    font-size: 12.5px;
                                    color: ChromePalette.text-muted;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }
                            }
                            Rectangle {
                                width: parent.width;
                                height: parent.height;
                                border-radius: 16px;
                                border-width: 2.5px;
                                border-color: ChromePalette.accent;
                            }
                            TouchArea {
                                clicked => {
                                    root.card-clicked();
                                }
                            }
                        }

                        // The tooltip of the lit planet (level 1).
                        for row in root.planets: Rectangle {
                            x: row.tooltip-x;
                            y: row.tooltip-y;
                            width: tip.preferred-width + 24px;
                            height: 30px;
                            visible: root.l1 && row.lit && row.tooltip != "";
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: ChromePalette.popup-border;
                            background: ChromePalette.popup-background;

                            tip := Text {
                                x: 12px;
                                height: parent.height;
                                text: row.tooltip;
                                font-size: 12.5px;
                                font-weight: 600;
                                color: ChromePalette.text;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                        }

                        // The drag in flight: a dotted accent line from the source slot to the ghost, and
                        // the pill of the tab or group at the pointer.
                        for step in 36: Rectangle {
                            visible: root.drag.active && root.drag.has-from;
                            x: root.drag.from-x + (root.drag.ghost-x - root.drag.from-x) * (step + 0.5) / 36 - 1.25px;
                            y: root.drag.from-y + (root.drag.ghost-y - root.drag.from-y) * (step + 0.5) / 36 - 1.25px;
                            width: 2.5px;
                            height: 2.5px;
                            border-radius: 1.25px;
                            background: ChromePalette.accent;
                        }
                        if root.drag.active: Rectangle {
                            x: root.drag.ghost-x - self.width / 2;
                            y: root.drag.ghost-y - 12px;
                            width: ghost-text.preferred-width + 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: root.drag.ghost-colour;
                            drop-shadow-blur: 8px;
                            drop-shadow-color: ChromePalette.shadow;
                            drop-shadow-offset-y: 2px;

                            ghost-text := Text {
                                x: 12px;
                                height: parent.height;
                                text: root.drag.ghost-text;
                                font-size: 11px;
                                font-weight: 700;
                                color: ChromePalette.primary-button-text;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                        }

                        // The new-group popover: a name field and six colour dots.
                        if root.popover.visible: Rectangle {
                            x: root.popover.x;
                            y: root.popover.y;
                            width: 230px;
                            height: 100px;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: ChromePalette.popup-border;
                            background: ChromePalette.popup-background;
                            drop-shadow-blur: 18px;
                            drop-shadow-color: ChromePalette.shadow;
                            drop-shadow-offset-y: 4px;
                            accessible-role: groupbox;
                            accessible-label: "New group";

                            Rectangle {
                                x: 10px;
                                y: 10px;
                                width: parent.width - 20px;
                                height: 32px;
                                border-radius: 6px;
                                border-width: 2px;
                                border-color: ChromePalette.accent;
                                background: ChromePalette.field-background;

                                // The placeholder shows while the field is empty (the product opens it
                                // empty; the controller names the group "Group N" then).
                                Text {
                                    x: 8px;
                                    width: parent.width - 16px;
                                    height: parent.height;
                                    text: root.popover.placeholder;
                                    font-size: 13px;
                                    color: ChromePalette.placeholder;
                                    vertical-alignment: center;
                                    visible: name-field.text == "";
                                    accessible-role: none;
                                }
                                name-field := TextInput {
                                    x: 8px;
                                    width: parent.width - 16px;
                                    height: parent.height;
                                    text: root.popover.name;
                                    font-size: 13px;
                                    color: ChromePalette.text;
                                    vertical-alignment: center;
                                    single-line: true;
                                    accessible-label: "Group name";
                                    accessible-placeholder-text: root.popover.placeholder;
                                    init => {
                                        self.focus();
                                        self.select-all();
                                        root.popover-field-focus = self.has-focus;
                                    }
                                    changed has-focus => {
                                        root.popover-field-focus = self.has-focus;
                                    }
                                    edited => {
                                        root.popover-name-edited(self.text);
                                    }
                                    accepted => {
                                        root.popover-confirmed();
                                    }
                                }
                            }
                            for colour[i] in root.popover.colours: Rectangle {
                                x: 14px + i * 33px;
                                y: 58px;
                                width: 24px;
                                height: 24px;
                                accessible-role: radio-button;
                                accessible-label: i < root.popover.colour-names.length ? root.popover.colour-names[i] : "Colour";
                                accessible-checkable: true;
                                accessible-checked: i == root.popover.selected;
                                accessible-action-default => {
                                    root.popover-colour-chosen(i);
                                }

                                Rectangle {
                                    x: 3px;
                                    y: 3px;
                                    width: 18px;
                                    height: 18px;
                                    border-radius: 9px;
                                    background: colour;
                                }
                                Rectangle {
                                    width: parent.width;
                                    height: parent.height;
                                    border-radius: 12px;
                                    border-width: i == root.popover.selected ? 2px : 0px;
                                    border-color: ChromePalette.text;
                                }
                                TouchArea {
                                    clicked => {
                                        root.popover-colour-chosen(i);
                                    }
                                }
                            }
                        }

                        // A refused drop: one line at the bottom. A live region: a screen reader
                        // announces its text when it appears.
                        if root.notice != "": Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: parent.height - 96px;
                            width: notice-text.preferred-width + 32px;
                            height: 32px;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: ChromePalette.notice-border;
                            background: ChromePalette.notice-background;
                            accessible-role: text;
                            accessible-label: root.notice;
                            accessible-live-region: AccessibleLiveness.polite;

                            notice-text := Text {
                                x: 16px;
                                height: parent.height;
                                text: root.notice;
                                font-size: 12.5px;
                                color: ChromePalette.status-text;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                        }

                        // The key hints, centred in the free part of the footer (level 2: right of the
                        // "Other groups" chips).
                        HorizontalLayout {
                            x: root.l2 ? root.chips-end + 40px : 0px;
                            y: parent.height - 34px;
                            width: root.l2 ? parent.width - self.x - 40px : parent.width;
                            height: 22px;
                            spacing: 18px;
                            alignment: center;

                            if root.l1: Hint {
                                keys: ["⏎"];
                                label: "zoom in";
                            }
                            if root.l1: Hint {
                                keys: ["⌘↑"];
                                label: "zoom out";
                            }
                            if root.l1: Hint {
                                keys: ["N"];
                                label: "new group";
                            }
                            if root.l1: Hint {
                                keys: ["/"];
                                label: "search";
                            }
                            if root.l1: Hint {
                                keys: ["esc"];
                                label: "back to the page";
                            }
                            if root.l2: Hint {
                                keys: ["←", "→"];
                                label: "tab";
                            }
                            if root.l2: Hint {
                                keys: ["⏎"];
                                label: "open";
                            }
                            if root.l2: Hint {
                                keys: ["⌘↑"];
                                label: "zoom out";
                            }
                            if root.l3: Hint {
                                keys: ["⏎"];
                                label: "open the tab";
                            }
                            if root.l3: Hint {
                                keys: ["←", "→"];
                                label: "previous / next tab";
                            }
                            if root.l3: Hint {
                                keys: ["⌘↑"];
                                label: root.group-name == "" ? "zoom out" : "back to \{root.group-name}";
                            }
                        }

                    }
                }
            }
        }
    }
}

// A 1440 x 900 window around one OrbitView with every property and callback forwarded, for the
// lane's examples and tests and for the other lanes' renders. Not used by the browser's windows.
export component OrbitPreview inherits Window {
    preferred-width: 1440px;
    preferred-height: 900px;
    background: ChromePalette.window-background;

    in property <OrbitLevel> level <=> view.level;
    in property <[OrbitPlanet]> planets <=> view.planets;
    in property <OrbitPlanet> centre <=> view.centre;
    in property <bool> has-centre <=> view.has-centre;
    in property <[OrbitPreviewCard]> previews <=> view.previews;
    in property <int> more-previews <=> view.more-previews;
    in property <[OrbitChip]> chips <=> view.chips;
    in property <[OrbitNeighbour]> neighbours <=> view.neighbours;
    in property <OrbitCard> card <=> view.card;
    in property <OrbitSun> sun <=> view.sun;
    in property <OrbitNewGroup> new-group <=> view.new-group;
    in property <OrbitDragView> drag <=> view.drag;
    in property <OrbitPopover> popover <=> view.popover;
    in property <[string]> crumbs <=> view.crumbs;
    in property <string> search-placeholder <=> view.search-placeholder;
    in-out property <string> search-text <=> view.search-text;
    in property <bool> query-active <=> view.query-active;
    in property <int> focus-tab <=> view.focus-tab;
    in property <string> container-label <=> view.container-label;
    in property <string> notice <=> view.notice;
    in-out property <float> pinch-progress <=> view.pinch-progress;
    in-out property <bool> pinch-live <=> view.pinch-live;
    in property <bool> reduce-motion <=> view.reduce-motion;
    in property <bool> animate-spinners <=> view.animate-spinners;
    out property <bool> text-field-focused <=> view.text-field-focused;
    out property <float> open-progress <=> view.open-progress;
    out property <float> open-scale <=> view.open-scale;
    out property <float> open-opacity <=> view.open-opacity;

    callback planet-hovered <=> view.planet-hovered;
    callback planet-clicked <=> view.planet-clicked;
    callback preview-hovered <=> view.preview-hovered;
    callback preview-clicked <=> view.preview-clicked;
    callback chip-clicked <=> view.chip-clicked;
    callback card-clicked <=> view.card-clicked;
    callback neighbour-clicked <=> view.neighbour-clicked;
    callback backdrop-clicked <=> view.backdrop-clicked;
    callback new-group-clicked <=> view.new-group-clicked;
    callback back-clicked <=> view.back-clicked;
    callback search-edited <=> view.search-edited;
    callback key-pressed <=> view.key-pressed;
    callback pinch-started <=> view.pinch-started;
    callback pinch-updated <=> view.pinch-updated;
    callback pinch-ended <=> view.pinch-ended;
    callback pinch-cancelled <=> view.pinch-cancelled;
    callback ring-drag-started <=> view.ring-drag-started;
    callback ring-drag-moved <=> view.ring-drag-moved;
    callback ring-dropped <=> view.ring-dropped;
    callback ring-drag-cancelled <=> view.ring-drag-cancelled;
    callback popover-name-edited <=> view.popover-name-edited;
    callback popover-colour-chosen <=> view.popover-colour-chosen;
    callback popover-confirmed <=> view.popover-confirmed;
    callback popover-cancelled <=> view.popover-cancelled;
    pure callback ring-hit-test <=> view.ring-hit-test;
    pure callback ring-drop-target <=> view.ring-drop-target;
    pure callback payload-for <=> view.payload-for;
    pure callback payload-accepts <=> view.payload-accepts;
    callback payload-dropped <=> view.payload-dropped;
    callback drag-over <=> view.drag-over;
    callback drag-source-started <=> view.drag-source-started;
    callback drag-source-finished <=> view.drag-source-finished;
    out property <int> ring-drag-source <=> view.ring-drag-source;

    public function focus-search() {
        view.focus-search();
    }

    public function focus-view() {
        view.focus-view();
    }

    public function play-open() {
        view.play-open();
    }

    public function cancel-ring-drag() {
        view.cancel-ring-drag();
    }

    view := OrbitView {
        width: parent.width;
        height: parent.height;
    }
}
