// media-session lane: the sound indicator on a tab, which mutes or unmutes the tab when clicked.

import { ChromePalette } from "../theme/chrome-palette.slint";

export enum TabAudioState {
    silent,
    playing,
    muted,
}

export component TabAudioButton inherits Rectangle {
    in property <TabAudioState> state;
    in property <bool> active-tab;
    in property <string> tab-title;
    // False for the copy of a tab that follows the pointer while it is dragged: drawn only. It
    // takes no input, shows no tooltip and is announced as unavailable.
    in property <bool> interactive: true;
    // The speaker's size; the badge on a pinned tab makes the button and the speaker smaller.
    in property <length> icon-size: 14px;
    // Behind the speaker while the pointer is elsewhere: transparent, or the tab's own colour
    // for the badge on a pinned tab, so the speaker stays readable over the page icon.
    in property <brush> resting-background: transparent;
    callback clicked;

    // Muting is done inside the page, which can undo it; the description says so (a11y-base: it
    // was part of the label, which named the tab and then a parenthesis).
    property <string> action-text: root.state == TabAudioState.muted
        ? "Unmute tab: " + root.tab-title
        : "Mute tab: " + root.tab-title;

    // Colours: the chrome's palette, so the icon follows the theme.
    property <color> icon-color: root.active-tab ? ChromePalette.text : ChromePalette.tab-title-inactive;
    property <color> icon-hover-color: ChromePalette.button-label-hover;
    property <color> muted-icon-color: ChromePalette.danger;
    property <color> hover-background: ChromePalette.tab-close-hover;
    property <color> pressed-background: ChromePalette.tab-close-pressed;

    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: touch.pressed ? root.pressed-background : touch.has-hover ? root.hover-background : root.resting-background;
    accessible-role: button;
    accessible-label: root.action-text;
    accessible-description: root.state == TabAudioState.muted ? "" : "The page can override this";
    accessible-enabled: root.interactive;
    accessible-action-default => {
        if root.interactive {
            root.clicked();
        }
    }

    // Decorative: the button's label already says what it does, so the picture is not announced
    // as an image of its own.
    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.icon-size;
        height: root.icon-size;
        source: root.state == TabAudioState.muted ? @image-url("speaker-muted.svg") : @image-url("speaker.svg");
        colorize: touch.has-hover ? root.icon-hover-color : root.state == TabAudioState.muted ? root.muted-icon-color : root.icon-color;
        image-fit: contain;
        accessible-role: none;
    }

    if root.interactive: Tooltip {
        // Fixed text only: no page text goes through markdown.
        text: root.state == TabAudioState.muted ? @markdown("Unmute tab") : @markdown("Mute tab (the page can override this)");
    }

    touch := TouchArea {
        enabled: root.interactive;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}
