import { ListView } from "std-widgets.slint";
import { ChromePalette } from "../theme/chrome-palette.slint";

// One entry of the bookmarks bar. `x`, `width` and `shown` are the overflow layout's, computed
// from the widths the buttons report (`measured`).
export struct BookmarkBarItem {
    title: string,
    is-folder: bool,
    x: length,
    width: length,
    shown: bool,
}

export enum BookmarkRowKind {
    bookmark,
    folder,
    separator,
    // Goes back to the folder that holds the one shown.
    back,
    // "Empty" in a folder with nothing in it.
    empty,
}

// One row of a folder popup, of the overflow popup, or of the manager's lists.
export struct BookmarkMenuRow {
    title: string,
    url: string,
    kind: BookmarkRowKind,
    depth: int,
}

// A generic page or folder icon, drawn so that it needs no font glyph.
export component BookmarkIcon inherits Rectangle {
    in property <bool> folder;
    in property <color> stroke: ChromePalette.button-label;

    width: 16px;
    height: 16px;

    if root.folder: Rectangle {
        x: 1px;
        y: 2px;
        width: 6px;
        height: 4px;
        border-radius: 1px;
        background: root.stroke;
    }

    if root.folder: Rectangle {
        x: 1px;
        y: 4px;
        width: 14px;
        height: 10px;
        border-radius: 2px;
        border-width: 1.5px;
        border-color: root.stroke;
    }

    if !root.folder: Rectangle {
        x: 2px;
        y: 2px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        border-width: 1.5px;
        border-color: root.stroke;
    }

    if !root.folder: Rectangle {
        x: 7.25px;
        y: 2px;
        width: 1.5px;
        height: 12px;
        background: root.stroke;
    }
}

component BarButton inherits Rectangle {
    in property <BookmarkBarItem> item;
    out property <length> natural-width: Math.min(180px, 8px + 16px + 6px + label.preferred-width + 8px);
    // A click: whether it asks for a new background tab (Cmd-click on macOS, Ctrl-click
    // elsewhere, or a middle click).
    callback activated(bool);

    height: 26px;
    border-radius: 6px;
    background: touch.pressed
        ? ChromePalette.button-pressed
        : touch.has-hover ? ChromePalette.button-hover : transparent;
    accessible-role: button;
    accessible-label: root.item.title;
    accessible-action-default => {
        root.activated(false);
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: start;

        VerticalLayout {
            alignment: center;

            BookmarkIcon {
                folder: root.item.is-folder;
            }
        }

        label := Text {
            text: root.item.title == "" ? "(untitled)" : root.item.title;
            color: ChromePalette.text;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && self.has-hover {
                if event.button == PointerEventButton.left {
                    root.activated(event.modifiers.control);
                } else if event.button == PointerEventButton.middle {
                    root.activated(true);
                }
            }
        }
    }
}

// The rows of a folder popup; a folder row opens its folder in the same popup.
export component BookmarkMenuList inherits Rectangle {
    in property <[BookmarkMenuRow]> rows;
    callback row-activated(int, bool);

    width: 300px;
    height: Math.min(420px, Math.max(1, root.rows.length) * 28px + 12px);
    border-radius: 8px;
    border-width: 1px;
    border-color: ChromePalette.popup-border;
    background: ChromePalette.popup-background;
    drop-shadow-blur: 10px;
    drop-shadow-color: ChromePalette.shadow;
    accessible-role: list;

    ListView {
        x: 1px;
        y: 6px;
        width: parent.width - 2px;
        height: parent.height - 12px;

        for row[index] in root.rows: Rectangle {
            height: 28px;
            background: row-touch.has-hover && (row.kind == BookmarkRowKind.bookmark || row.kind == BookmarkRowKind.folder || row.kind == BookmarkRowKind.back)
                ? ChromePalette.item-hover
                : transparent;
            accessible-role: button;
            accessible-label: row.title;

            if row.kind == BookmarkRowKind.separator: Rectangle {
                x: 10px;
                y: parent.height / 2;
                width: parent.width - 20px;
                height: 1px;
                background: ChromePalette.separator;
            }

            if row.kind != BookmarkRowKind.separator: HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;

                if row.kind == BookmarkRowKind.bookmark || row.kind == BookmarkRowKind.folder: VerticalLayout {
                    alignment: center;

                    BookmarkIcon {
                        folder: row.kind == BookmarkRowKind.folder;
                    }
                }

                Text {
                    text: row.kind == BookmarkRowKind.back ? "‹  " + row.title : row.title == "" ? "(untitled)" : row.title;
                    color: row.kind == BookmarkRowKind.empty ? ChromePalette.text-secondary : ChromePalette.text;
                    font-size: 13px;
                    font-weight: row.kind == BookmarkRowKind.back ? 600 : 400;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                if row.kind == BookmarkRowKind.folder: Text {
                    text: "›";
                    color: ChromePalette.text-secondary;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }

            row-touch := TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.up && self.has-hover {
                        if event.button == PointerEventButton.left {
                            root.row-activated(index, event.modifiers.control);
                        } else if event.button == PointerEventButton.middle {
                            root.row-activated(index, true);
                        }
                    }
                }
            }
        }
    }
}

// The bookmarks bar under the toolbar. Rust lays it out: each button reports its natural width
// through `measured`, and Rust sets every item's `x`, `width` and `shown` and whether the "»"
// button is needed, from those widths and `available-width`.
export component BookmarksBar inherits Rectangle {
    in property <[BookmarkBarItem]> items;
    in property <bool> overflow;
    in property <[BookmarkMenuRow]> menu-rows;
    // The width the overflow layout may fill (the bar less its padding).
    out property <length> available-width: root.width - 2 * root.side-padding;
    in property <length> overflow-button-width: 28px;
    property <length> side-padding: 10px;
    property <length> menu-x;
    out property <bool> menu-open: menu.is-open;
    callback measured(int, length);
    callback available-width-changed(length);
    // A bar button: its index and whether a new background tab is asked for.
    callback item-activated(int, bool);
    // A bar folder was opened at this x (relative to the bar).
    callback folder-opened(int, length);
    callback overflow-opened(length);
    callback menu-row-activated(int, bool);

    public function show-menu(x: length) {
        root.menu-x = Math.max(0px, Math.min(x, root.width - 300px));
        menu.show();
    }

    public function close-menu() {
        menu.close();
    }

    changed available-width => {
        root.available-width-changed(self.available-width);
    }

    height: 34px;
    background: ChromePalette.toolbar-background;
    accessible-role: groupbox;
    accessible-label: "Bookmarks bar";

    if root.items.length == 0: Text {
        x: root.side-padding + 4px;
        height: parent.height;
        text: "Bookmarks you put in the bookmarks bar appear here.";
        color: ChromePalette.text-secondary;
        font-size: 12px;
        vertical-alignment: center;
    }

    for item[index] in root.items: BarButton {
        x: root.side-padding + item.x;
        y: (root.height - self.height) / 2 - 1px;
        width: item.shown ? item.width : 0px;
        visible: item.shown;
        item: item;
        init => {
            root.measured(index, self.natural-width);
        }
        activated(new-tab) => {
            if item.is-folder {
                root.folder-opened(index, self.x);
            } else {
                root.item-activated(index, new-tab);
            }
        }
    }

    if root.overflow: Rectangle {
        x: root.width - root.side-padding - root.overflow-button-width;
        y: (root.height - self.height) / 2 - 1px;
        width: root.overflow-button-width;
        height: 26px;
        border-radius: 6px;
        background: overflow-touch.pressed
            ? ChromePalette.button-pressed
            : overflow-touch.has-hover ? ChromePalette.button-hover : transparent;
        accessible-role: button;
        accessible-label: "More bookmarks";

        Text {
            text: "»";
            color: ChromePalette.button-label;
            font-size: 15px;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }

        overflow-touch := TouchArea {
            clicked => {
                root.overflow-opened(parent.x);
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: ChromePalette.toolbar-divider;
    }

    menu := PopupWindow {
        x: root.menu-x;
        y: root.height - 2px;
        // Sized explicitly: without it the popup is laid out at no width and its content is
        // centred off to the left.
        width: menu-list.width;
        height: menu-list.height;
        close-policy: PopupClosePolicy.close-on-click-outside;

        menu-list := BookmarkMenuList {
            x: 0px;
            y: 0px;
            rows: root.menu-rows;
            row-activated(index, new-tab) => {
                root.menu-row-activated(index, new-tab);
            }
        }
    }
}
