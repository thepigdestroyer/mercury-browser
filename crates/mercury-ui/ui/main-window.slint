// SPDX-License-Identifier: MPL-2.0
import { Palette } from "std-widgets.slint";
import { DownloadsButton, DownloadsPopover, DownloadsPanel, QuitDownloadsPrompt, DownloadOfferBar, DownloadsPalette, DownloadRow, DownloadAction } from "downloads/downloads.slint"; // downloads-ui lane
export { DownloadsPalette, DownloadRow, DownloadAction }
import { ChromePalette } from "theme/chrome-palette.slint";
export { ChromePalette, ChromeTheme } from "theme/chrome-palette.slint";
// settings-ui
import { SettingsNotice } from "settings/settings-notice.slint";
export { SearchEngineRow, SettingsWindow } from "settings/settings-window.slint";
import { PageRequestSheet, PageRequestStyle, PageRequestView, PermissionPrompt } from "dialogs/page-requests.slint";
// controls
import { ColorPicker, ContextMenuPopup, ContextMenuRow, PopupBackdrop, SelectPopup, SelectPopupRow } from "controls/controls.slint";
import { PopUpBlockedIndicator } from "tabs/pop-up-blocked.slint";
// menus
import { AddressBarEdit, BrowserMenu, BrowserMenuCommand, BrowserMenuEntry } from "menus/browser-menu.slint";
export { AboutLink, AboutWindow } from "about/about-window.slint";
// tabs-plus
import { BrowserTab, TabMenuCommand, TabPreview, TabStrip } from "tabs/tab-strip.slint";
export { BrowserTab, TabMenuCommand, TabMenuEntry } from "tabs/tab-strip.slint";
import { TabSearchPopup, TabSearchRow } from "tabs/tab-search.slint";
export { TabSearchRow } from "tabs/tab-search.slint";
// history lane
import { ClearDataDialog, HistoryPanel, HistoryRow, SuggestionList, SuggestionRow } from "history/history.slint";
// bookmarks
import { BookmarkStar, BookmarksBar, BookmarkBarItem, BookmarkMenuRow } from "bookmarks/bookmarks.slint";
export { BookmarkRowKind, BookmarksManager, BookmarksPreview } from "bookmarks/bookmarks.slint";
// import-ui
export { ImportPage, ImportProfileRow, ImportSummaryLine, ImportWindow } from "import/import-window.slint";
// session
import { SessionBar } from "session/session-bar.slint";
import { FindBar } from "find/find-bar.slint";

export enum WebViewPointerButton {
    left,
    middle,
    right,
    other,
}

export enum WebViewCursor {
    default,
    none,
    help,
    pointer,
    progress,
    wait,
    crosshair,
    text,
    alias,
    copy,
    move,
    no-drop,
    not-allowed,
    grab,
    grabbing,
    col-resize,
    row-resize,
    n-resize,
    e-resize,
    s-resize,
    w-resize,
    ne-resize,
    nw-resize,
    se-resize,
    sw-resize,
    ew-resize,
    ns-resize,
    nesw-resize,
    nwse-resize,
}

component ChromeButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;

    width: 36px;
    height: 34px;
    border-radius: 7px;
    background: button-area.pressed && root.enabled
        ? ChromePalette.button-pressed
        : button-area.has-hover && root.enabled ? ChromePalette.button-hover : transparent;
    opacity: root.enabled ? 1 : 0.32;

    Text {
        text: root.label;
        color: button-area.has-hover && root.enabled ? ChromePalette.button-label-hover : ChromePalette.button-label;
        font-size: 17px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    button-area := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

export component MainWindow inherits Window {
    in property <[BrowserTab]> tabs;
    in property <int> active-tab-index: 0;
    in property <string> page-title: "New tab";
    in-out property <string> address: "";
    in property <bool> can-go-back: false;
    in property <bool> can-go-forward: false;
    in property <bool> is-loading: false;
    in property <bool> is-new-tab: true;
    in property <bool> web-view-visible: false;
    in property <image> web-view-texture;
    out property <length> web-view-width: web-view-area.width;
    out property <length> web-view-height: web-view-area.height;
    in property <string> content-message: "Type an address or search with DuckDuckGo.";
    in property <int> zoom-percent: 100;
    in property <WebViewCursor> web-view-cursor: WebViewCursor.default;
    in property <string> status-text: "";
    // The page is fullscreen: the tab strip and toolbar are hidden.
    in property <bool> chrome-hidden: false;
    out property <bool> text-input-focused: address-input.has-focus || (root.is-new-tab && root.new-tab-search-focused) || root.history-search-focused || find-bar.field-focused;
    out property <bool> web-view-hovered: web-view-input.has-hover;
    out property <float> web-view-pointer-x: web-view-input.mouse-x / 1px;
    out property <float> web-view-pointer-y: web-view-input.mouse-y / 1px;
    property <bool> new-tab-search-focused: false;
    // The window's colour scheme as Slint determined it, used when winit reports none.
    out property <ColorScheme> system-color-scheme: Palette.color-scheme;
    // --- history lane ---
    // Suggestions under the address field.
    in property <[SuggestionRow]> suggestions;
    in property <int> suggestion-selected: -1;
    in property <bool> suggestions-open: false;
    out property <bool> address-focused: address-input.has-focus;
    callback address-edited(string);
    callback suggestion-chosen(int);
    // The field lost focus: the list closes, and a reply on its way is dropped.
    callback address-blurred();
    changed address-focused => {
        if !self.address-focused {
            root.address-blurred();
        }
    }
    // Puts `text` in the address field and selects from `start` to `end` (UTF-8 offsets).
    public function complete-address(text: string, start: int, end: int) {
        root.address = text;
        address-input.set-selection-offsets(start, end);
    }
    // The history window.
    in property <bool> history-open: false;
    in property <[HistoryRow]> history-rows;
    in property <string> history-message;
    in-out property <string> history-query;
    // The window's search field has focus (it counts as a focused text input).
    in-out property <bool> history-search-focused: false;
    callback history-search(string);
    callback history-open-entry(int, bool);
    callback history-delete-entry(int);
    callback history-delete-site(int);
    callback history-more();
    callback history-close();
    // "Clear browsing data".
    in property <bool> clear-dialog-open: false;
    in-out property <int> clear-period: 0;
    in-out property <bool> clear-history: true;
    in-out property <bool> clear-cookies: false;
    in-out property <bool> clear-cache: false;
    in property <bool> clear-busy: false;
    callback show-clear-dialog();
    callback clear-confirm();
    callback clear-cancel();
    // --- end history lane ---
    // --- session ---
    // Sessions that did not close properly, newest first, named for the chooser; while any are
    // listed the bar under the toolbar offers to restore them.
    in property <[string]> recovery-sessions;
    // A one-time message about the saved session, shown in the same bar.
    in property <string> session-notice;
    // Whether "Restore previous session" and "Reopen closed tab" have anything to do.
    in property <bool> can-restore-previous-session;
    in property <bool> can-reopen-closed-tab;
    callback restore-recovered-session(int);
    callback dismiss-recovered-sessions();
    callback dismiss-session-notice();
    callback restore-previous-session();
    // --- end session ---
    // --- media-session ---
    // Mute or unmute a tab. The argument is the tab's id (`BrowserTab.id`), not its index in the
    // strip, so it still means that tab if the strip changed since the click.
    callback toggle-tab-muted(int);
    // --- end media-session ---

    callback navigate(string);
    callback go-back;
    callback go-forward;
    callback reload;
    callback new-tab;
    callback select-tab(int);
    callback close-tab(int);
    callback web-view-pointer-moved(float, float);
    callback web-view-pointer-button(WebViewPointerButton, bool, float, float);
    callback web-view-scrolled(float, float, float, float);
    callback web-view-focus-changed(bool);
    callback web-view-pointer-left();
    // --- settings-ui ---
    in property <bool> show-home-button: false;
    // The zoom badge shows only when a page's zoom differs from this.
    in property <int> default-zoom-percent: 100;
    in property <string> search-engine-name: "DuckDuckGo";
    // One message about the settings file (damaged, or from a newer version); empty for none.
    in property <string> settings-notice: "";
    // Opens the settings window (Cmd+, and the menus).
    callback show-settings();
    callback go-home();
    callback dismiss-settings-notice();
    // --- end settings-ui ---

    // --- controls ---
    // Where the page area is in the window, for placing popups over page elements.
    out property <length> controls-page-x: web-view-area.absolute-position.x;
    out property <length> controls-page-y: web-view-area.absolute-position.y;
    // 0: none, 1: select list, 2: colour picker, 3: context menu.
    in property <int> controls-popup: 0;
    in property <length> controls-popup-x;
    in property <length> controls-popup-y;
    in property <length> controls-popup-width;
    in property <length> controls-popup-height;
    in property <string> controls-origin;
    in property <int> controls-highlighted: -1;
    in property <[SelectPopupRow]> controls-select-rows;
    in property <bool> controls-select-multiple;
    in-out property <length> controls-select-scroll-y;
    in property <[ContextMenuRow]> controls-menu-rows;
    in property <[color]> controls-color-swatches;
    in property <color> controls-color;
    in property <string> controls-color-hex;
    in property <bool> controls-color-hex-valid: true;
    in property <float> controls-color-hue;
    in property <float> controls-color-lightness;
    callback controls-dismissed();
    callback controls-row-clicked(int);
    callback controls-row-hovered(int);
    callback controls-select-done();
    callback controls-color-swatch-picked(int);
    callback controls-color-area-picked(float, float);
    callback controls-color-done();
    // The page area moved or was resized.
    callback controls-page-changed();
    changed controls-page-x => {
        root.controls-page-changed();
    }
    changed controls-page-y => {
        root.controls-page-changed();
    }
    changed web-view-width => {
        root.controls-page-changed();
    }
    changed web-view-height => {
        root.controls-page-changed();
    }
    // --- end controls ---

    // --- bookmarks ---
    in property <bool> bookmark-star-enabled: false;
    in property <bool> bookmark-star-filled: false;
    in property <bool> bookmark-popover-is-new;
    in-out property <string> bookmark-popover-name;
    in property <[string]> bookmark-popover-folders;
    in-out property <int> bookmark-popover-folder-index;
    in property <bool> bookmarks-bar-shown: true;
    in property <[BookmarkBarItem]> bookmarks-bar-items;
    in property <bool> bookmarks-bar-overflow;
    in property <[BookmarkMenuRow]> bookmarks-menu-rows;
    out property <length> bookmarks-bar-available-width: bookmarks-bar.available-width;
    out property <bool> bookmarks-menu-open: bookmarks-bar.menu-open;
    callback bookmark-star-clicked();
    callback bookmark-popover-done();
    callback bookmark-popover-remove();
    callback bookmark-popover-dismissed();
    callback bookmarks-bar-measured(int, length);
    callback bookmarks-bar-width-changed(length);
    callback bookmarks-bar-item-activated(int, bool);
    callback bookmarks-bar-folder-opened(int, length);
    callback bookmarks-bar-overflow-opened(length);
    callback bookmarks-menu-row-activated(int, bool);

    public function open-bookmark-popover() {
        bookmark-star.open-popover();
    }

    public function close-bookmark-popover() {
        bookmark-star.close-popover();
    }

    public function show-bookmarks-menu(x: length) {
        bookmarks-bar.show-menu(x);
    }

    public function close-bookmarks-menu() {
        bookmarks-bar.close-menu();
    }
    // --- end bookmarks ---
    // --- downloads-ui ---
    in property <bool> downloads-button-visible: false;
    in property <bool> downloads-active: false;
    // 0 to 1; above 1 when no size is known.
    in property <float> downloads-progress: 0;
    in property <bool> downloads-popover-open: false;
    in property <[DownloadRow]> downloads-recent;
    in property <bool> downloads-panel-open: false;
    in property <[DownloadRow]> downloads-all;
    in property <bool> downloads-can-show-more: false;
    in property <string> downloads-show-label: "Show in Finder";
    in property <bool> quit-prompt-open: false;
    in property <string> quit-prompt-title;
    in property <string> quit-prompt-body;
    in property <string> quit-prompt-confirm-label;
    in property <string> quit-prompt-keep-label;
    in property <bool> downloads-attention: false;
    in property <bool> download-offer-visible: false;
    in property <string> download-offer-text;
    in property <string> download-offer-detail;
    // Set by the downloads button wherever the toolbar places it.
    property <length> downloads-anchor-right;
    property <length> downloads-anchor-bottom;
    callback downloads-toggle-popover();
    callback downloads-close-popover();
    callback downloads-action(string, DownloadAction);
    callback downloads-clear-list();
    callback downloads-show-all();
    callback downloads-show-more();
    callback downloads-close-panel();
    callback quit-prompt-confirm();
    callback quit-prompt-keep();
    callback download-offer-download();
    callback download-offer-block();
    callback download-offer-dismiss();
    // Gives the keyboard back to the page after the downloads list or question closes.
    public function downloads-focus-web-view() {
        web-view-focus.focus();
    }
    public function downloads-focus-address-bar() {
        address-input.focus();
    }
    // --- end downloads-ui ---

    pure function mouse-cursor-for(cursor: WebViewCursor) -> MouseCursor {
        if cursor == WebViewCursor.none {
            return MouseCursor.none;
        }
        if cursor == WebViewCursor.help {
            return MouseCursor.help;
        }
        if cursor == WebViewCursor.pointer {
            return MouseCursor.pointer;
        }
        if cursor == WebViewCursor.progress {
            return MouseCursor.progress;
        }
        if cursor == WebViewCursor.wait {
            return MouseCursor.wait;
        }
        if cursor == WebViewCursor.crosshair {
            return MouseCursor.crosshair;
        }
        if cursor == WebViewCursor.text {
            return MouseCursor.text;
        }
        if cursor == WebViewCursor.alias {
            return MouseCursor.alias;
        }
        if cursor == WebViewCursor.copy {
            return MouseCursor.copy;
        }
        if cursor == WebViewCursor.move {
            return MouseCursor.move;
        }
        if cursor == WebViewCursor.no-drop {
            return MouseCursor.no-drop;
        }
        if cursor == WebViewCursor.not-allowed {
            return MouseCursor.not-allowed;
        }
        if cursor == WebViewCursor.grab {
            return MouseCursor.grab;
        }
        if cursor == WebViewCursor.grabbing {
            return MouseCursor.grabbing;
        }
        if cursor == WebViewCursor.col-resize {
            return MouseCursor.col-resize;
        }
        if cursor == WebViewCursor.row-resize {
            return MouseCursor.row-resize;
        }
        if cursor == WebViewCursor.n-resize {
            return MouseCursor.n-resize;
        }
        if cursor == WebViewCursor.e-resize {
            return MouseCursor.e-resize;
        }
        if cursor == WebViewCursor.s-resize {
            return MouseCursor.s-resize;
        }
        if cursor == WebViewCursor.w-resize {
            return MouseCursor.w-resize;
        }
        if cursor == WebViewCursor.ne-resize {
            return MouseCursor.ne-resize;
        }
        if cursor == WebViewCursor.nw-resize {
            return MouseCursor.nw-resize;
        }
        if cursor == WebViewCursor.se-resize {
            return MouseCursor.se-resize;
        }
        if cursor == WebViewCursor.sw-resize {
            return MouseCursor.sw-resize;
        }
        if cursor == WebViewCursor.ew-resize {
            return MouseCursor.ew-resize;
        }
        if cursor == WebViewCursor.ns-resize {
            return MouseCursor.ns-resize;
        }
        if cursor == WebViewCursor.nesw-resize {
            return MouseCursor.nesw-resize;
        }
        if cursor == WebViewCursor.nwse-resize {
            return MouseCursor.nwse-resize;
        }
        return MouseCursor.default;
    }

    public function focus-address-bar() {
        address-input.focus();
        address-input.select-all();
    }

    public function reveal-active-tab() {
        // tabs-plus: the strip scrolls just enough to show the active tab
        tab-strip.reveal(root.active-tab-index);
    }

    // --- tabs ---
    out property <bool> address-has-focus: address-input.has-focus;
    // The active tab's committed address; Escape in the address field restores it.
    in property <string> committed-address: "";

    public function reset-address(text: string) {
        root.address = text;
        root.synced-address = text; // tabs-plus: not a draft
    }

    // The origin whose pop-up was blocked in the active tab; empty hides the indicator.
    in property <string> pop-up-blocked-origin: "";
    callback allow-pop-ups();
    callback dismiss-pop-up-blocked();
    // --- end tabs ---
    // --- dialogs ---
    // The active tab's oldest unanswered page request (style none when there is none).
    in property <PageRequestView> page-request;
    // id, accepted, text (prompt value or user name), password, checked ("Don't allow this page
    // to show more dialogs" or "... to ask again").
    callback page-request-answered(int, bool, string, string, bool);
    // --- end dialogs ---

    // --- menus ---
    // The browser menu's items above and below its zoom row (built in apps/mercury-desktop/src/menus).
    in property <[BrowserMenuEntry]> browser-menu-top-entries;
    in property <[BrowserMenuEntry]> browser-menu-bottom-entries;
    out property <bool> address-bar-focused: address-input.has-focus;
    callback browser-menu-activated(BrowserMenuCommand);
    // The address bar gained or lost keyboard focus: the Edit menu's enabled items change.
    callback address-bar-focus-changed(bool);
    changed address-bar-focused => {
        root.address-bar-focus-changed(self.address-bar-focused);
    }

    public function show-browser-menu() {
        browser-menu.show();
    }

    public function edit-address-bar(command: AddressBarEdit) {
        if !address-input.has-focus {
            return;
        }
        if command == AddressBarEdit.undo {
            address-input.undo();
        } else if command == AddressBarEdit.redo {
            address-input.redo();
        } else if command == AddressBarEdit.cut {
            address-input.cut();
        } else if command == AddressBarEdit.copy {
            address-input.copy();
        } else if command == AddressBarEdit.paste {
            address-input.paste();
        } else if command == AddressBarEdit.select-all {
            address-input.select-all();
        }
    }
    // --- end menus ---
    // --- find ---
    in property <bool> find-open: false;
    in-out property <string> find-query: "";
    in property <string> find-status: "";
    in property <bool> find-no-matches: false;
    in property <bool> find-match-case: false;
    out property <bool> find-field-focused: find-bar.field-focused;
    callback find-edited(string);
    callback find-next();
    callback find-previous();
    callback find-close();
    callback find-toggle-match-case();

    public function find-focus-field() {
        find-bar.focus-field();
    }

    public function find-select-all() {
        find-bar.select-all();
    }
    // --- end find ---

    // --- tabs-plus ---
    // What the application last wrote into the address field (or the text the user accepted
    // with Return): the field holds a draft of the user's while its text differs from this.
    out property <string> synced-address;
    // A navigation that did not come from the field's Return (a suggestion, the history window,
    // Home, a bookmark, Back, Forward, Reload): whatever the field holds is no longer a draft.
    public function accept-address-draft() {
        root.synced-address = root.address;
    }
    // The field's text could not be opened (it is no address and no search was possible): it
    // stays, as a draft, for the user to fix.
    public function keep-address-draft() {
        root.synced-address = root.committed-address;
    }
    // How many of `tabs` are pinned; they come first.
    in property <int> pinned-tab-count: 0;
    // Tab search: the rows matching the query, set by the application.
    in property <[TabSearchRow]> tab-search-rows;
    in-out property <string> tab-search-query;
    // The tab with this id goes to this index in the strip, pinned or not (a drag ended).
    callback move-tab(int, int, bool);
    // A command from a tab's menu, for the tab with this id.
    callback tab-menu-activated(int, TabMenuCommand);
    // The tab search query changed (also called with "" when it opens).
    callback tab-search-edited(string);
    // A tab was chosen in tab search: its id.
    callback tab-search-chosen(int);

    public function show-tab-search() {
        root.tab-search-query = "";
        root.tab-search-edited("");
        tab-search.show();
    }
    // --- end tabs-plus ---

    title: page-title + " — Mercury Browser";
    icon: @image-url("../../../apps/mercury-desktop/resources/mercury-browser.svg");
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 0px;
    min-height: 0px;
    max-width: 100000px;
    max-height: 100000px;
    background: ChromePalette.window-background;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: root.chrome-hidden ? 0px : 48px;
            visible: !root.chrome-hidden;
            background: ChromePalette.window-background;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 14px;
                padding-top: 7px;
                padding-bottom: 3px;
                spacing: 8px;

                // tabs-plus: pinned tabs, dragging, the tab menu and the "all tabs" button
                tab-strip := TabStrip {
                    horizontal-stretch: 1;
                    tabs: root.tabs;
                    pinned-count: root.pinned-tab-count;
                    select-tab(index) => {
                        root.select-tab(index);
                    }
                    close-tab(index) => {
                        root.close-tab(index);
                    }
                    audio-clicked(id) => {
                        root.toggle-tab-muted(id);
                    }
                    move-tab(id, index, pinned) => {
                        root.move-tab(id, index, pinned);
                    }
                    tab-menu-activated(id, command) => {
                        root.tab-menu-activated(id, command);
                    }
                    show-all-tabs => {
                        root.show-tab-search();
                    }
                }

                ChromeButton {
                    width: 34px;
                    height: 34px;
                    label: "+";
                    clicked => {
                        root.new-tab();
                    }
                }
            }
        }

        Rectangle {
            height: root.chrome-hidden ? 0px : 60px;
            visible: !root.chrome-hidden;
            background: ChromePalette.toolbar-background;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 11px;
                padding-bottom: 11px;
                spacing: 8px;

                ChromeButton {
                    label: "‹";
                    enabled: root.can-go-back;
                    clicked => {
                        root.go-back();
                    }
                }

                ChromeButton {
                    label: "›";
                    enabled: root.can-go-forward;
                    clicked => {
                        root.go-forward();
                    }
                }

                ChromeButton {
                    label: "↻";
                    clicked => {
                        root.reload();
                    }
                }

                // settings-ui: the home button, when the appearance setting asks for it.
                if root.show-home-button: ChromeButton {
                    label: "⌂";
                    clicked => {
                        root.go-home();
                    }
                }

                address-box := Rectangle {
                    horizontal-stretch: 1;
                    height: 38px;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: address-input.has-focus ? ChromePalette.accent : ChromePalette.field-border;
                    background: ChromePalette.field-background;

                    address-input := TextInput {
                        x: 14px;
                        width: parent.width - 28px - 30px;
                        height: parent.height;
                        text <=> root.address;
                        color: ChromePalette.text;
                        font-size: 14px;
                        vertical-alignment: center;
                        single-line: true;
                        accepted => {
                            // tabs: the page takes focus, so the field shows the committed URL
                            web-view-focus.focus();
                            if self.has-focus {
                                self.clear-focus();
                            }
                            root.synced-address = self.text; // tabs-plus: the draft is accepted
                            root.navigate(self.text);
                        }
                        edited => {
                            root.address-edited(self.text);
                        }
                        // tabs: Escape drops the draft and returns focus to the page
                        key-pressed(event) => {
                            if event.text != Key.Escape {
                                return reject;
                            }
                            // An input method's composition handles its own Escape.
                            if self.preedit-text != "" {
                                return reject;
                            }
                            // history lane: an open suggestion list has taken Escape already
                            // (`history_ui::handle_key`, before Slint sees the key).
                            root.reset-address(root.committed-address);
                            if root.web-view-visible {
                                web-view-focus.focus();
                            } else {
                                self.clear-focus();
                            }
                            accept
                        }
                    }

                    // bookmarks
                    bookmark-star := BookmarkStar {
                        x: parent.width - self.width - 4px;
                        y: (parent.height - self.height) / 2;
                        enabled: root.bookmark-star-enabled;
                        filled: root.bookmark-star-filled;
                        popover-is-new: root.bookmark-popover-is-new;
                        popover-name <=> root.bookmark-popover-name;
                        popover-folders: root.bookmark-popover-folders;
                        popover-folder-index <=> root.bookmark-popover-folder-index;
                        clicked => {
                            root.bookmark-star-clicked();
                        }
                        popover-done => {
                            root.bookmark-popover-done();
                        }
                        popover-remove => {
                            root.bookmark-popover-remove();
                        }
                        popover-dismissed => {
                            root.bookmark-popover-dismissed();
                        }
                    }
                }

                // tabs: a page's pop-up was blocked
                if root.pop-up-blocked-origin != "": PopUpBlockedIndicator {
                    origin: root.pop-up-blocked-origin;
                    allow => {
                        root.allow-pop-ups();
                    }
                    dismiss => {
                        root.dismiss-pop-up-blocked();
                    }
                }

                if root.zoom-percent != root.default-zoom-percent: Text {
                    text: root.zoom-percent + "%";
                    color: ChromePalette.button-label;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                // downloads-ui lane
                if root.downloads-button-visible: DownloadsButton {
                    active: root.downloads-active;
                    progress: root.downloads-progress;
                    open: root.downloads-popover-open;
                    attention: root.downloads-attention;
                    anchor-changed(right, bottom) => {
                        root.downloads-anchor-right = right;
                        root.downloads-anchor-bottom = bottom;
                    }
                    clicked => {
                        root.downloads-toggle-popover();
                    }
                }

                browser-menu-button := ChromeButton {
                    label: "⋮";
                    clicked => { root.show-browser-menu(); }

                    // menus: the browser menu, below the button, right edges aligned. A child of the
                    // button, not placed with `absolute-position`: in Slint 1.17.1 that counts an
                    // element's offset twice when the element has a property lowered to an injected
                    // parent, such as ChromeButton's `opacity` (the `Opacity` parent takes the
                    // geometry: lower_property_to_element.rs:85, object_tree.rs:3441-3446).
                    // Measured: x 1700 for a button at 850.
                    browser-menu := BrowserMenu {
                        x: browser-menu-button.width - self.width;
                        y: browser-menu-button.height + 4px;
                        top-entries: root.browser-menu-top-entries;
                        bottom-entries: root.browser-menu-bottom-entries;
                        zoom-percent: root.zoom-percent;
                        activated(command) => {
                            root.browser-menu-activated(command);
                        }
                    }
                }
            }

            Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: ChromePalette.toolbar-divider;
            }
        }

        // settings-ui: a message about the settings file.
        if root.settings-notice != "" && !root.chrome-hidden: SettingsNotice {
            text: root.settings-notice;
            dismissed => {
                root.dismiss-settings-notice();
            }
        }

        // bookmarks
        bookmarks-bar := BookmarksBar {
            height: root.bookmarks-bar-shown && !root.chrome-hidden ? 34px : 0px;
            visible: root.bookmarks-bar-shown && !root.chrome-hidden;
            items: root.bookmarks-bar-items;
            overflow: root.bookmarks-bar-overflow;
            menu-rows: root.bookmarks-menu-rows;
            measured(index, width) => {
                root.bookmarks-bar-measured(index, width);
            }
            available-width-changed(width) => {
                root.bookmarks-bar-width-changed(width);
            }
            item-activated(index, new-tab) => {
                root.bookmarks-bar-item-activated(index, new-tab);
            }
            folder-opened(index, x) => {
                root.bookmarks-bar-folder-opened(index, x);
            }
            overflow-opened(x) => {
                root.bookmarks-bar-overflow-opened(x);
            }
            menu-row-activated(index, new-tab) => {
                root.bookmarks-menu-row-activated(index, new-tab);
            }
        }

        // session: the offer to restore tabs after a crash
        if !root.chrome-hidden && (root.recovery-sessions.length > 0 || root.session-notice != ""): SessionBar {
            sessions: root.recovery-sessions;
            notice: root.session-notice;
            restore(index) => {
                root.restore-recovered-session(index);
            }
            dismiss => {
                root.dismiss-recovered-sessions();
            }
            dismiss-notice => {
                root.dismiss-session-notice();
            }
        }

        // find: the find bar, a row of its own under the toolbar
        find-bar := FindBar {
            height: root.find-open && !root.chrome-hidden ? 42px : 0px;
            shown: root.find-open && !root.chrome-hidden;
            query <=> root.find-query;
            status: root.find-status;
            no-matches: root.find-no-matches;
            match-case: root.find-match-case;
            edited(text) => {
                root.find-edited(text);
            }
            next => {
                root.find-next();
            }
            previous => {
                root.find-previous();
            }
            close => {
                root.find-close();
                web-view-focus.focus();
            }
            toggle-match-case => {
                root.find-toggle-match-case();
            }
        }

        web-view-area := Rectangle {
            vertical-stretch: 1;
            background: ChromePalette.content-background;

            if root.web-view-visible: Image {
                width: parent.width;
                height: parent.height;
                source: root.web-view-texture;
                image-fit: fill;
            }

            if root.is-loading: Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width * 45%;
                height: 2px;
                background: ChromePalette.accent;
            }

            if root.is-new-tab: Rectangle {
                background: ChromePalette.content-background;

                new-tab-content := Rectangle {
                    width: parent.width < 640px ? parent.width - 48px : 580px;
                    height: 300px;
                    x: (parent.width - self.width) / 2;
                    y: Math.max(24px, (parent.height - self.height) / 2 - 24px);
                    background: transparent;

                    VerticalLayout {
                        spacing: 11px;

                        HorizontalLayout {
                            alignment: center;
                            height: 84px;

                            Image {
                                width: 80px;
                                height: 80px;
                                source: @image-url("../../../apps/mercury-desktop/resources/mercury-browser.svg");
                                image-fit: contain;
                            }
                        }

                        Text {
                            text: "Mercury Browser";
                            color: ChromePalette.text;
                            font-size: 28px;
                            font-weight: 650;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Fast, lightweight and private by default";
                            color: ChromePalette.text-secondary;
                            font-size: 14px;
                            horizontal-alignment: center;
                        }

                        Rectangle {
                            height: 48px;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: new-tab-search.has-focus ? ChromePalette.accent : ChromePalette.search-field-border;
                            background: ChromePalette.search-field-background;

                            if new-tab-search.text == "": Text {
                                x: 18px;
                                width: parent.width - 82px;
                                height: parent.height;
                                text: "Search with " + root.search-engine-name + " or enter an address";
                                color: ChromePalette.placeholder;
                                font-size: 14px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            new-tab-search := TextInput {
                                x: 18px;
                                width: parent.width - 82px;
                                height: parent.height;
                                color: ChromePalette.text;
                                font-size: 14px;
                                vertical-alignment: center;
                                single-line: true;

                                changed has-focus => {
                                    root.new-tab-search-focused = self.has-focus;
                                }

                                accepted => {
                                    root.navigate(self.text);
                                }
                            }

                            search-button := Rectangle {
                                x: parent.width - 52px;
                                y: 6px;
                                width: 42px;
                                height: 36px;
                                border-radius: 8px;
                                background: search-touch.pressed
                                    ? ChromePalette.primary-button-pressed
                                    : search-touch.has-hover ? ChromePalette.primary-button-hover : ChromePalette.primary-button-background;

                                Text {
                                    text: "→";
                                    color: ChromePalette.primary-button-text;
                                    font-size: 20px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                search-touch := TouchArea {
                                    clicked => {
                                        root.navigate(new-tab-search.text);
                                    }
                                }
                            }
                        }

                        Text {
                            text: root.content-message;
                            color: ChromePalette.text-muted;
                            font-size: 12px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            if !root.web-view-visible && !root.is-new-tab: VerticalLayout {
                alignment: center;
                spacing: 10px;
                padding-left: 32px;
                padding-right: 32px;

                Text {
                    text: root.content-message;
                    color: ChromePalette.text-secondary;
                    font-size: 14px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            web-view-focus := FocusScope {
                enabled: root.web-view-visible;
                focus-on-click: false;
                focus-on-tab-navigation: false;

                focus-gained => {
                    root.web-view-focus-changed(true);
                }

                focus-lost => {
                    root.web-view-focus-changed(false);
                }

                web-view-input := TouchArea {
                    enabled: root.web-view-visible;
                    mouse-cursor: root.mouse-cursor-for(root.web-view-cursor);

                    changed has-hover => {
                        if !self.has-hover {
                            root.web-view-pointer-left();
                        }
                    }

                    property <WebViewPointerButton> active-button: WebViewPointerButton.other;

                    function map-pointer-button(
                        button: PointerEventButton,
                    ) -> WebViewPointerButton {
                        if button == PointerEventButton.left {
                            return WebViewPointerButton.left;
                        }

                        if button == PointerEventButton.middle {
                            return WebViewPointerButton.middle;
                        }

                        if button == PointerEventButton.right {
                            return WebViewPointerButton.right;
                        }

                        return WebViewPointerButton.other;
                    }

                    pointer-event(event) => {
                        if event.kind == PointerEventKind.move {
                            root.web-view-pointer-moved(
                                self.mouse-x / 1px,
                                self.mouse-y / 1px,
                            );
                        } else if event.kind == PointerEventKind.down {
                            web-view-focus.focus();
                            self.active-button = self.map-pointer-button(event.button);

                            root.web-view-pointer-button(
                                self.active-button,
                                true,
                                self.mouse-x / 1px,
                                self.mouse-y / 1px,
                            );
                        } else if event.kind == PointerEventKind.up {
                            root.web-view-pointer-button(
                                self.map-pointer-button(event.button),
                                false,
                                self.mouse-x / 1px,
                                self.mouse-y / 1px,
                            );

                            self.active-button = WebViewPointerButton.other;
                        } else if event.kind == PointerEventKind.cancel {
                            root.web-view-pointer-button(
                                self.active-button,
                                false,
                                self.mouse-x / 1px,
                                self.mouse-y / 1px,
                            );

                            self.active-button = WebViewPointerButton.other;
                        }
                    }

                    scroll-event(event) => {
                        root.web-view-scrolled(
                            event.delta-x / 1px,
                            event.delta-y / 1px,
                            self.mouse-x / 1px,
                            self.mouse-y / 1px,
                        );

                        accept
                    }
                }
            }

            // Drawn above the page; plain Rectangle and Text items do not take pointer input.
            if root.web-view-visible && root.web-view-hovered && root.status-text != "": Rectangle {
                x: 6px;
                y: parent.height - self.height - 6px;
                width: Math.min(status-label.preferred-width + 16px, parent.width * 60%);
                height: 24px;
                border-radius: 6px;
                border-width: 1px;
                border-color: ChromePalette.status-border;
                background: ChromePalette.status-background;

                status-label := Text {
                    x: 8px;
                    width: parent.width - 16px;
                    height: parent.height;
                    text: root.status-text;
                    color: ChromePalette.status-text;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    wrap: no-wrap;
                }
            }

            // dialogs
            if root.page-request.style != PageRequestStyle.none && root.page-request.style != PageRequestStyle.permission: PageRequestSheet {
                request: root.page-request;
                may-take-focus: !root.text-input-focused;
                answered(id, accepted, text, password, checked) => {
                    root.page-request-answered(id, accepted, text, password, checked);
                }
            }

            // dialogs
            if root.page-request.style == PageRequestStyle.permission: PermissionPrompt {
                request: root.page-request;
                anchor-x: address-input.absolute-position.x - 14px - web-view-area.absolute-position.x;
                answered(id, accepted) => {
                    root.page-request-answered(id, accepted, "", "", false);
                }
            }

            // downloads-ui lane
            if root.download-offer-visible: DownloadOfferBar {
                x: 0px;
                y: 0px;
                width: parent.width;
                text: root.download-offer-text;
                detail: root.download-offer-detail;
                download => {
                    root.download-offer-download();
                }
                block => {
                    root.download-offer-block();
                }
                dismiss => {
                    root.download-offer-dismiss();
                }
            }

            // downloads-ui lane
            if root.downloads-panel-open: DownloadsPanel {
                width: parent.width;
                height: parent.height;
                rows: root.downloads-all;
                show-label: root.downloads-show-label;
                can-show-more: root.downloads-can-show-more;
                action(guid, action) => {
                    root.downloads-action(guid, action);
                }
                clear-list => {
                    root.downloads-clear-list();
                }
                show-more => {
                    root.downloads-show-more();
                }
                close => {
                    root.downloads-close-panel();
                }
            }
        }
    }

    // controls
    if root.controls-popup != 0: PopupBackdrop {
        dismissed => {
            root.controls-dismissed();
        }
    }

    // controls
    if root.controls-popup == 1: SelectPopup {
        x: root.controls-popup-x;
        y: root.controls-popup-y;
        width: root.controls-popup-width;
        height: root.controls-popup-height;
        rows: root.controls-select-rows;
        highlighted: root.controls-highlighted;
        multiple: root.controls-select-multiple;
        origin: root.controls-origin;
        scroll-y <=> root.controls-select-scroll-y;
        row-clicked(index) => {
            root.controls-row-clicked(index);
        }
        row-hovered(index) => {
            root.controls-row-hovered(index);
        }
        done => {
            root.controls-select-done();
        }
    }

    // controls
    if root.controls-popup == 2: ColorPicker {
        x: root.controls-popup-x;
        y: root.controls-popup-y;
        width: root.controls-popup-width;
        height: root.controls-popup-height;
        origin: root.controls-origin;
        swatches: root.controls-color-swatches;
        current: root.controls-color;
        hex: root.controls-color-hex;
        hex-valid: root.controls-color-hex-valid;
        hue: root.controls-color-hue;
        lightness: root.controls-color-lightness;
        swatch-picked(index) => {
            root.controls-color-swatch-picked(index);
        }
        area-picked(hue, lightness) => {
            root.controls-color-area-picked(hue, lightness);
        }
        done => {
            root.controls-color-done();
        }
        cancelled => {
            root.controls-dismissed();
        }
    }

    // controls
    if root.controls-popup == 3: ContextMenuPopup {
        x: root.controls-popup-x;
        y: root.controls-popup-y;
        width: root.controls-popup-width;
        height: root.controls-popup-height;
        rows: root.controls-menu-rows;
        highlighted: root.controls-highlighted;
        row-clicked(index) => {
            root.controls-row-clicked(index);
        }
        row-hovered(index) => {
            root.controls-row-hovered(index);
        }
    }

    // tabs-plus: the hover preview of a tab, below the strip
    if !root.chrome-hidden && tab-strip.preview-index >= 0 && tab-strip.preview-index < root.tabs.length: TabPreview {
        x: clamp(tab-strip.absolute-position.x + tab-strip.preview-x, 8px, Math.max(8px, root.width - self.width - 8px));
        y: tab-strip.absolute-position.y + tab-strip.height + 4px;
        title: root.tabs[tab-strip.preview-index].title;
        url: root.tabs[tab-strip.preview-index].url;
    }

    // tabs-plus: tab search
    tab-search := TabSearchPopup {
        x: (root.width - self.width) / 2;
        y: 52px;
        rows: root.tab-search-rows;
        query <=> root.tab-search-query;
        query-edited(text) => {
            root.tab-search-edited(text);
        }
        chosen(id) => {
            root.tab-search-chosen(id);
        }
    }

    // history lane
    if root.history-open: HistoryPanel {
        x: 0px;
        y: web-view-area.absolute-position.y;
        width: root.width;
        height: web-view-area.height;
        rows: root.history-rows;
        message: root.history-message;
        query <=> root.history-query;
        init => {
            self.focus-search();
        }
        search(text) => {
            root.history-search(text);
        }
        search-focus-changed(focused) => {
            root.history-search-focused = focused;
        }
        open(entry, new-tab) => {
            root.history-open-entry(entry, new-tab);
        }
        delete-entry(entry) => {
            root.history-delete-entry(entry);
        }
        delete-site(entry) => {
            root.history-delete-site(entry);
        }
        more => {
            root.history-more();
        }
        close => {
            root.history-close();
        }
        clear-data => {
            root.show-clear-dialog();
        }
    }

    // history lane
    if root.suggestions-open && address-input.has-focus && root.suggestions.length > 0: SuggestionList {
        x: address-box.absolute-position.x;
        y: address-box.absolute-position.y + address-box.height + 6px;
        width: address-box.width;
        rows: root.suggestions;
        selected: root.suggestion-selected;
        chosen(index) => {
            root.suggestion-chosen(index);
        }
    }

    // history lane
    if root.clear-dialog-open: ClearDataDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        period <=> root.clear-period;
        history <=> root.clear-history;
        cookies <=> root.clear-cookies;
        cache <=> root.clear-cache;
        busy: root.clear-busy;
        init => {
            self.focus();
        }
        confirm => {
            root.clear-confirm();
        }
        cancel => {
            root.clear-cancel();
        }
    }

    // menus: keeps Slint's default macOS menu bar out; Mercury installs its own native menu.
    MenuBar {
        visible: false;
        Menu { }
    }

    // downloads-ui lane: a click outside the popover closes it.
    if root.downloads-popover-open: TouchArea {
        clicked => {
            root.downloads-close-popover();
        }
    }

    // downloads-ui lane
    if root.downloads-popover-open: DownloadsPopover {
        x: Math.max(8px, root.downloads-anchor-right - self.width);
        y: root.downloads-anchor-bottom + 6px;
        rows: root.downloads-recent;
        show-label: root.downloads-show-label;
        action(guid, action) => {
            root.downloads-action(guid, action);
        }
        clear-list => {
            root.downloads-clear-list();
        }
        show-all => {
            root.downloads-show-all();
        }
    }

    // downloads-ui lane
    if root.quit-prompt-open: QuitDownloadsPrompt {
        width: root.width;
        height: root.height;
        title: root.quit-prompt-title;
        body: root.quit-prompt-body;
        confirm-label: root.quit-prompt-confirm-label;
        keep-label: root.quit-prompt-keep-label;
        confirm => {
            root.quit-prompt-confirm();
        }
        keep => {
            root.quit-prompt-keep();
        }
    }
}
