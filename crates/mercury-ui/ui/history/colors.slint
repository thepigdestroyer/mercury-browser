// The history lane's colours, in one place until the settings lane's `ChromePalette` is
// merged. `dark` follows the chrome, which is dark; the light set is for when it is not.
export global HistoryColors {
    in-out property <bool> dark: true;
    out property <color> surface: dark ? #11171f : #ffffff;
    out property <color> raised: dark ? #161e28 : #f5f7fa;
    out property <color> field: dark ? #1a222c : #ffffff;
    out property <color> hover: dark ? #1d2732 : #e9eef4;
    out property <color> selected: dark ? #1d3a55 : #d6e8f8;
    out property <color> border: dark ? #29323d : #cfd7e1;
    out property <color> text: dark ? #edf4fa : #17202b;
    out property <color> dim: dark ? #8b98a8 : #5a6878;
    out property <color> accent: dark ? #62bfff : #0a66b2;
    out property <color> on-accent: dark ? #09131c : #ffffff;
    out property <color> danger: dark ? #ff8f87 : #b42318;
    out property <color> scrim: dark ? #000000a6 : #1720304d;
    out property <color> shadow: dark ? #00000060 : #17203033;
    out property <color> shadow-strong: dark ? #00000070 : #17203047;
}
