import { ListView } from "std-widgets.slint";
import { ChromePalette } from "../theme/chrome-palette.slint";

// One line of the history window: a day's heading, a visit, or "Show more" at the end.
export struct HistoryRow {
    is-day: bool,
    is-more: bool,
    label: string,
    time: string,
    title: string,
    url: string,
    // The host "Forget this site" deletes; empty when there is none.
    host: string,
    // Which visit, for the callbacks.
    entry: int,
}

component TextButton inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    in property <bool> primary: false;
    // The widest the button may grow; a longer label is elided.
    in property <length> widest: 1000px;
    // a11y-base: what a screen reader says when it is not the drawn label (the drawn "Close"
    // and "Clear browsing data…" are said as "Close history" and "Clear browsing data"), and
    // the page a per-row button acts on, as its description.
    in property <string> accessible-name;
    in property <string> hint;
    callback clicked;

    height: 28px;
    preferred-width: label-text.preferred-width + 20px;
    min-width: Math.min(label-text.preferred-width + 20px, root.widest);
    max-width: root.widest;
    border-radius: 6px;
    background: root.primary
        ? (touch.pressed ? ChromePalette.primary-button-background.darker(15%) : ChromePalette.primary-button-background)
        : touch.pressed ? ChromePalette.item-selected : touch.has-hover ? ChromePalette.item-hover : transparent;
    accessible-role: button;
    accessible-label: root.accessible-name != "" ? root.accessible-name : root.label;
    accessible-description: root.hint;
    accessible-action-default => {
        root.clicked();
    }

    label-text := Text {
        accessible-role: none;
        x: 10px;
        width: parent.width - 20px;
        text: root.label;
        overflow: elide;
        // A pressed plain button is filled with `item-selected`, where the accent and danger
        // colours do not read: its label takes `item-selected-text` then.
        color: root.primary
            ? ChromePalette.primary-button-text
            : touch.pressed ? ChromePalette.item-selected-text
            : root.danger ? ChromePalette.danger : ChromePalette.accent;
        font-size: 12px;
        font-weight: 550;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component HistoryPanel inherits FocusScope {
    in property <[HistoryRow]> rows;
    // Shown instead of the list: why history is unavailable, or that nothing matched.
    in property <string> message;
    in-out property <string> query;
    callback search(string);
    callback search-focus-changed(bool);
    callback open(int, bool);
    callback delete-entry(int);
    callback delete-site(int);
    callback more();
    callback close();
    callback clear-data();

    public function focus-search() {
        search-input.focus();
        search-input.select-all();
    }

    key-pressed(event) => {
        if event.text == Key.Escape {
            root.close();
            return accept;
        }
        reject
    }

    // a11y-base: the window is a region named by its heading, which is then hidden so that it
    // is not read twice.
    accessible-role: region;
    accessible-label: "History";

    Rectangle {
        background: ChromePalette.content-background;

        // Pointer input over the panel never reaches the page underneath.
        TouchArea { }

        VerticalLayout {
            padding-left: 28px;
            padding-right: 28px;
            padding-top: 20px;
            padding-bottom: 12px;
            spacing: 14px;

            HorizontalLayout {
                spacing: 12px;
                height: 36px;

                Text {
                    text: "History";
                    color: ChromePalette.text;
                    font-size: 20px;
                    font-weight: 650;
                    vertical-alignment: center;
                    accessible-role: none;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    max-width: 440px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: search-input.has-focus ? ChromePalette.accent : ChromePalette.search-field-border;
                    background: ChromePalette.search-field-background;

                    if search-input.text == "": Text {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        text: "Search history";
                        color: ChromePalette.text-secondary;
                        font-size: 13px;
                        vertical-alignment: center;
                        accessible-role: none;
                    }

                    search-input := TextInput {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        text <=> root.query;
                        color: ChromePalette.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        single-line: true;
                        accessible-label: "Search history";
                        accessible-placeholder-text: "Search history";
                        edited => {
                            root.search(self.text);
                        }
                        changed has-focus => {
                            root.search-focus-changed(self.has-focus);
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 0.01;
                }

                TextButton {
                    y: 4px;
                    label: "Clear browsing data…";
                    accessible-name: "Clear browsing data";
                    clicked => {
                        root.clear-data();
                    }
                }

                TextButton {
                    y: 4px;
                    label: "Close";
                    accessible-name: "Close history";
                    clicked => {
                        root.close();
                    }
                }
            }

            if root.message != "": Text {
                vertical-stretch: 1;
                text: root.message;
                color: ChromePalette.text-secondary;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }

            if root.message == "": ListView {
                vertical-stretch: 1;
                accessible-role: list;
                accessible-label: "Visited pages";

                for row[index] in root.rows: Rectangle {
                    height: row.is-day ? 40px : row.is-more ? 48px : 44px;
                    border-radius: 7px;
                    background: !row.is-day && !row.is-more && row-touch.has-hover ? ChromePalette.item-hover : transparent;

                    if row.is-more: TextButton {
                        x: (parent.width - self.width) / 2;
                        y: 10px;
                        label: "Show more";
                        clicked => {
                            root.more();
                        }
                    }

                    if row.is-day: Text {
                        x: 8px;
                        y: parent.height - self.height - 6px;
                        text: row.label;
                        color: ChromePalette.text;
                        font-size: 14px;
                        font-weight: 650;
                    }

                    row-touch := TouchArea {
                        enabled: !row.is-day && !row.is-more;
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.up
                                && event.button == PointerEventButton.middle {
                                root.open(row.entry, true);
                            }
                        }
                        clicked => {
                            root.open(row.entry, false);
                        }
                    }

                    // a11y-base: a visit is a list item named by its title (or its address when
                    // it has none) and described by its address and time, holding its three
                    // buttons. The wrapper fills the row, so nothing moves. Items of this list
                    // are counted with the day headings and "Show more": Slint cannot count
                    // only the visits.
                    if !row.is-day && !row.is-more: Rectangle {
                        accessible-role: list-item;
                        accessible-label: row.title == "" ? row.url : row.title;
                        accessible-description: row.title == "" ? row.time : row.time == "" ? row.url : row.url + ", " + row.time;
                        accessible-item-index: index;
                        accessible-item-count: root.rows.length;
                        accessible-action-default => {
                            root.open(row.entry, false);
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 14px;

                            Text {
                                width: 44px;
                                text: row.time;
                                color: ChromePalette.text-secondary;
                                font-size: 12px;
                                vertical-alignment: center;
                                accessible-role: none;
                            }

                            Text {
                                horizontal-stretch: 2;
                                // Column widths come from the stretch alone, the same on every row.
                                preferred-width: 0px;
                                min-width: 0px;
                                text: row.title;
                                color: ChromePalette.text;
                                font-size: 13px;
                                overflow: elide;
                                vertical-alignment: center;
                                accessible-role: none;
                            }

                            Text {
                                horizontal-stretch: 1;
                                preferred-width: 0px;
                                min-width: 0px;
                                text: row.url;
                                color: ChromePalette.text-secondary;
                                font-size: 12px;
                                overflow: elide;
                                vertical-alignment: center;
                                accessible-role: none;
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                // As wide as its buttons.
                                horizontal-stretch: 0;
                                alignment: end;

                                TextButton {
                                    y: 8px;
                                    label: "Open in new tab";
                                    hint: row.title == "" ? row.url : row.title;
                                    clicked => {
                                        root.open(row.entry, true);
                                    }
                                }

                                // Only this host's visits, unlike Firefox's "Forget About
                                // This Site".
                                if row.host != "": TextButton {
                                    y: 8px;
                                    label: "Delete all visits to " + row.host;
                                    hint: row.title == "" ? row.url : row.title;
                                    widest: 300px;
                                    danger: true;
                                    clicked => {
                                        root.delete-site(row.entry);
                                    }
                                }

                                TextButton {
                                    y: 8px;
                                    label: "Delete";
                                    hint: row.title == "" ? row.url : row.title;
                                    danger: true;
                                    clicked => {
                                        root.delete-entry(row.entry);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
