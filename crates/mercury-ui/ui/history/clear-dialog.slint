import { ChromePalette } from "../theme/chrome-palette.slint";

component Choice inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    // A round mark for one-of choices, a square one for check boxes.
    in property <bool> round: false;
    // a11y-base: for a round choice, its place among the time ranges, read as "n of m".
    in property <int> index;
    in property <int> count;
    callback toggled;

    height: 32px;
    border-radius: 6px;
    background: touch.has-hover ? ChromePalette.item-hover : transparent;

    HorizontalLayout {
        padding-left: 8px;
        spacing: 10px;

        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            border-radius: root.round ? 8px : 4px;
            border-width: root.checked ? 0px : 1.5px;
            border-color: ChromePalette.text-secondary;
            background: root.checked ? ChromePalette.primary-button-background : transparent;

            if root.checked: Text {
                text: root.round ? "●" : "✓";
                color: ChromePalette.primary-button-text;
                font-size: root.round ? 7px : 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
        }

        Text {
            text: root.label;
            color: ChromePalette.text;
            font-size: 13px;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        clicked => {
            root.toggled();
        }
    }

    // a11y-base: a role is a constant and cannot follow `round`, so each kind has an element of
    // its own that fills the choice and draws nothing: a radio button for a time range, a check
    // box for what to clear.
    if root.round: Rectangle {
        accessible-role: radio-button;
        accessible-label: root.label;
        accessible-checkable: true;
        accessible-checked: root.checked;
        accessible-item-index: root.index;
        accessible-item-count: root.count;
        accessible-action-default => {
            root.toggled();
        }
    }

    if !root.round: Rectangle {
        accessible-role: checkbox;
        accessible-label: root.label;
        accessible-checkable: true;
        accessible-checked: root.checked;
        accessible-action-default => {
            root.toggled();
        }
    }
}

component DialogButton inherits Rectangle {
    in property <string> label;
    // a11y-base: what a screen reader says when it is not the drawn label.
    in property <string> accessible-name;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;

    height: 32px;
    min-width: label-text.preferred-width + 28px;
    border-radius: 7px;
    border-width: root.primary ? 0px : 1px;
    border-color: ChromePalette.popup-border;
    opacity: root.enabled ? 1 : 0.45;
    background: root.primary
        ? (touch.pressed ? ChromePalette.danger.darker(15%) : ChromePalette.danger)
        : touch.has-hover && root.enabled ? ChromePalette.item-hover : transparent;
    accessible-role: button;
    accessible-label: root.accessible-name != "" ? root.accessible-name : root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    label-text := Text {
        accessible-role: none;
        text: root.label;
        color: root.primary ? ChromePalette.primary-button-text : ChromePalette.text;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// "Clear browsing data": a time range and what to clear. A browser dialog, not page content:
// it sits on a scrim over the whole window and names no page.
export component ClearDataDialog inherits FocusScope {
    // 0 last hour, 1 today, 2 last 7 days, 3 all time.
    in-out property <int> period: 0;
    in-out property <bool> history: true;
    in-out property <bool> cookies: false;
    in-out property <bool> cache: false;
    // While the clearing runs.
    in property <bool> busy: false;
    callback confirm();
    callback cancel();

    property <bool> anything: root.history || root.cookies || root.cache;

    key-pressed(event) => {
        if event.text == Key.Escape {
            root.cancel();
            return accept;
        }
        if event.text == Key.Return && root.anything && !root.busy {
            root.confirm();
            return accept;
        }
        reject
    }

    Rectangle {
        background: ChromePalette.scrim;

        // Clicks outside the dialog do nothing; they never reach the page.
        TouchArea { }

        card := Rectangle {
            width: Math.min(420px, parent.width - 32px);
            height: content.preferred-height;
            x: (parent.width - self.width) / 2;
            y: Math.max(16px, (parent.height - self.height) / 3);
            border-radius: 12px;
            border-width: 1px;
            border-color: ChromePalette.popup-border;
            background: ChromePalette.sheet-background;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: ChromePalette.shadow;
            // a11y-base: Slint has no dialog role: the card is a group named by its heading.
            accessible-role: groupbox;
            accessible-label: "Clear browsing data";

            TouchArea { }

            content := VerticalLayout {
                padding: 22px;
                spacing: 6px;

                Text {
                    text: "Clear browsing data";
                    color: ChromePalette.text;
                    font-size: 17px;
                    font-weight: 650;
                    accessible-role: none;
                }

                Text {
                    text: "Time range";
                    color: ChromePalette.text-secondary;
                    font-size: 12px;
                    font-weight: 600;
                }

                for label[index] in ["Last hour", "Today", "Last 7 days", "All time"]: Choice {
                    label: label;
                    round: true;
                    index: index;
                    count: 4;
                    checked: root.period == index;
                    toggled => {
                        root.period = index;
                    }
                }

                Rectangle {
                    height: 6px;
                }

                Text {
                    text: "What to clear";
                    color: ChromePalette.text-secondary;
                    font-size: 12px;
                    font-weight: 600;
                }

                Choice {
                    label: "Browsing and download history";
                    checked: root.history;
                    toggled => {
                        root.history = !root.history;
                    }
                }

                HorizontalLayout {
                    padding-left: 34px;

                    Text {
                        text: "The pages you visited and the list of your downloads. Downloaded files are kept, and downloads still running stay in the list.";
                        color: ChromePalette.text-secondary;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }

                Choice {
                    label: "Cookies and site data";
                    checked: root.cookies;
                    toggled => {
                        root.cookies = !root.cookies;
                    }
                }

                Choice {
                    label: "Cached files";
                    checked: root.cache;
                    toggled => {
                        root.cache = !root.cache;
                    }
                }

                if (root.cookies || root.cache) && root.period != 3: Text {
                    text: "Cookies, site data and cached files are cleared for all time: the engine cannot clear them by date.";
                    color: ChromePalette.text-secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    padding-top: 12px;
                    spacing: 8px;
                    alignment: end;

                    DialogButton {
                        label: "Cancel";
                        clicked => {
                            root.cancel();
                        }
                    }

                    DialogButton {
                        label: root.busy ? "Clearing…" : "Clear data";
                        accessible-name: root.busy ? "Clearing" : "Clear data";
                        primary: true;
                        enabled: root.anything && !root.busy;
                        clicked => {
                            root.confirm();
                        }
                    }
                }
            }
        }
    }
}
