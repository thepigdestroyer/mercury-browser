import { HistoryColors } from "colors.slint";

component Choice inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    // A round mark for one-of choices, a square one for check boxes.
    in property <bool> round: false;
    callback toggled;

    height: 32px;
    border-radius: 6px;
    background: touch.has-hover ? HistoryColors.hover : transparent;

    HorizontalLayout {
        padding-left: 8px;
        spacing: 10px;

        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            border-radius: root.round ? 8px : 4px;
            border-width: root.checked ? 0px : 1.5px;
            border-color: HistoryColors.dim;
            background: root.checked ? HistoryColors.accent : transparent;

            if root.checked: Text {
                text: root.round ? "●" : "✓";
                color: HistoryColors.on-accent;
                font-size: root.round ? 7px : 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.label;
            color: HistoryColors.text;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

component DialogButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;

    height: 32px;
    min-width: label-text.preferred-width + 28px;
    border-radius: 7px;
    border-width: root.primary ? 0px : 1px;
    border-color: HistoryColors.border;
    opacity: root.enabled ? 1 : 0.45;
    background: root.primary
        ? (touch.pressed ? HistoryColors.danger.darker(15%) : HistoryColors.danger)
        : touch.has-hover && root.enabled ? HistoryColors.hover : transparent;

    label-text := Text {
        text: root.label;
        color: root.primary ? HistoryColors.on-accent : HistoryColors.text;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// "Clear browsing data": a time range and what to clear. A browser dialog, not page content:
// it sits on a scrim over the whole window and names no page.
export component ClearDataDialog inherits FocusScope {
    // 0 last hour, 1 today, 2 last 7 days, 3 all time.
    in-out property <int> period: 0;
    in-out property <bool> history: true;
    in-out property <bool> cookies: false;
    in-out property <bool> cache: false;
    // While the clearing runs.
    in property <bool> busy: false;
    callback confirm();
    callback cancel();

    property <bool> anything: root.history || root.cookies || root.cache;

    key-pressed(event) => {
        if event.text == Key.Escape {
            root.cancel();
            return accept;
        }
        if event.text == Key.Return && root.anything && !root.busy {
            root.confirm();
            return accept;
        }
        reject
    }

    Rectangle {
        background: HistoryColors.scrim;

        // Clicks outside the dialog do nothing; they never reach the page.
        TouchArea { }

        card := Rectangle {
            width: Math.min(420px, parent.width - 32px);
            height: content.preferred-height;
            x: (parent.width - self.width) / 2;
            y: Math.max(16px, (parent.height - self.height) / 3);
            border-radius: 12px;
            border-width: 1px;
            border-color: HistoryColors.border;
            background: HistoryColors.raised;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000070;

            TouchArea { }

            content := VerticalLayout {
                padding: 22px;
                spacing: 6px;

                Text {
                    text: "Clear browsing data";
                    color: HistoryColors.text;
                    font-size: 17px;
                    font-weight: 650;
                }

                Text {
                    text: "Time range";
                    color: HistoryColors.dim;
                    font-size: 12px;
                    font-weight: 600;
                }

                for label[index] in ["Last hour", "Today", "Last 7 days", "All time"]: Choice {
                    label: label;
                    round: true;
                    checked: root.period == index;
                    toggled => {
                        root.period = index;
                    }
                }

                Rectangle {
                    height: 6px;
                }

                Text {
                    text: "What to clear";
                    color: HistoryColors.dim;
                    font-size: 12px;
                    font-weight: 600;
                }

                Choice {
                    label: "Browsing history";
                    checked: root.history;
                    toggled => {
                        root.history = !root.history;
                    }
                }

                Choice {
                    label: "Cookies and site data";
                    checked: root.cookies;
                    toggled => {
                        root.cookies = !root.cookies;
                    }
                }

                Choice {
                    label: "Cached files";
                    checked: root.cache;
                    toggled => {
                        root.cache = !root.cache;
                    }
                }

                if (root.cookies || root.cache) && root.period != 3: Text {
                    text: "Cookies, site data and cached files are cleared for all time: the engine cannot clear them by date.";
                    color: HistoryColors.dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    padding-top: 12px;
                    spacing: 8px;
                    alignment: end;

                    DialogButton {
                        label: "Cancel";
                        clicked => {
                            root.cancel();
                        }
                    }

                    DialogButton {
                        label: root.busy ? "Clearing…" : "Clear data";
                        primary: true;
                        enabled: root.anything && !root.busy;
                        clicked => {
                            root.confirm();
                        }
                    }
                }
            }
        }
    }
}
