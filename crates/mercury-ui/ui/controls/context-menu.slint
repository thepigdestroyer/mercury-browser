import { PopupColors, PopupStyle } from "page-popup.slint";

export struct ContextMenuRow {
    label: string,
    enabled: bool,
    separator: bool,
}

// The page context menu. Items are 26 px, separators 9 px, with 4 px above and below the list,
// mirrored in `apps/mercury-desktop/src/controls/context_menu.rs` and `controls/mod.rs`.
export component ContextMenuPopup inherits Rectangle {
    in property <[ContextMenuRow]> rows;
    in property <int> highlighted: -1;
    callback row-clicked(int);
    callback row-hovered(int);

    property <PopupColors> colors: PopupStyle.colors;

    background: root.colors.background;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.colors.border;
    drop-shadow-blur: 14px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: root.colors.shadow;
    clip: true;
    // a11y-base: Slint has no menu role, so the menu is a list of items. The rows are the
    // browser's own words (Back, Copy, ...), so it is named for where it opens, not for an origin.
    accessible-role: list;
    accessible-label: "Page context menu";

    VerticalLayout {
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 0px;

        for row[index] in root.rows: Rectangle {
            height: row.separator ? 9px : 26px;

            if row.separator: Rectangle {
                x: 10px;
                y: 4px;
                width: parent.width - 20px;
                height: 1px;
                background: root.colors.separator;
            }

            if !row.separator: Rectangle {
                x: 4px;
                width: parent.width - 8px;
                border-radius: 5px;
                background: row.enabled && index == root.highlighted ? root.colors.highlight : transparent;
                // a11y-base: one item of the list. The position counts separators too (they
                // are drawn but hidden from assistive technology), since a loop cannot skip them.
                accessible-role: list-item;
                accessible-label: row.label;
                accessible-enabled: row.enabled;
                accessible-item-selectable: true;
                accessible-item-selected: row.enabled && index == root.highlighted;
                accessible-item-index: index;
                accessible-item-count: root.rows.length;
                accessible-action-default => {
                    if row.enabled {
                        root.row-clicked(index);
                    }
                }

                Text {
                    x: 10px;
                    width: parent.width - 20px;
                    height: parent.height;
                    text: row.label;
                    color: !row.enabled
                        ? root.colors.disabled
                        : index == root.highlighted ? root.colors.highlight-text : root.colors.text;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: none; // a11y-base: the item's label
                }
            }

            TouchArea {
                enabled: !row.separator;

                changed has-hover => {
                    if self.has-hover {
                        root.row-hovered(index);
                    }
                }

                clicked => {
                    root.row-clicked(index);
                }
            }
        }
    }
}
