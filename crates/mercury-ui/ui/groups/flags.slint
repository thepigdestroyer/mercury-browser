// The small markers on a tab-group ring (SPEC design/ui-final/SPEC.md §3.2 and §4.2): the loading
// spinner, the speaker and muted badges, the unread dot, the crash and capture badges, the dot of
// the current tab and the digit chips shown while ⌥ is held. Rust (src/ring_bands/flags.rs)
// decides which pin a tab gets and where it sits; this file only draws what it is given.
//
// The enum and the struct are part of the pinned contract of lane ring-bands (sdd/lane-ring-bands-brief.md
// §3.1): later lanes may rely on them. The component body is filled in by the ring-bands lane.

export enum FlagKind {
    spinner,
    audible,
    muted,
    unread,
    crashed,
    capture,
    current,
    digit,
}

// One marker, centred on (x, y) in the ring's own coordinates (the same as `ArcSeg`). `tab` is a
// `TabRow.id`. `size` is the diameter. `progress` is 0..1 for a spinner, -1 when it is unknown.
// `label` is the digit of a `digit` chip.
export struct FlagPin {
    tab: int,
    kind: FlagKind,
    x: length,
    y: length,
    size: length,
    progress: float,
    label: string,
}

// Draws the pins; fills its parent. Speaker and muted pins are touch targets (`mute-clicked`).
export component RingFlags inherits Rectangle {
    in property <[FlagPin]> flags;
    // false: a spinner stands still (renders and tests).
    in property <bool> animate-spinners: true;
    // true: no animation at all (R12 §7); until the settings lane adds a global.
    in property <bool> reduce-motion: false;
    callback mute-clicked(int /* tab id */);
}
