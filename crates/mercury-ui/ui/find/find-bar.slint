// The find bar, shown as its own row between the toolbar and the page: it is part of the browser's
// chrome, the page cannot draw over it, and it never covers the match it scrolls into view.

// Every colour the find bar uses. Until the chrome palette lands these are the chrome's existing
// dark colours; at merge each becomes a `ChromePalette` role.
export global FindBarColors {
    out property <color> background: #11171f;
    out property <color> divider: #202832;
    out property <color> field-background: #1a222c;
    out property <color> field-border: #29323d;
    out property <color> field-border-focused: #62bfff;
    out property <color> field-border-no-matches: #e0626b;
    out property <color> text: #edf4fa;
    out property <color> placeholder: #717e8e;
    out property <color> secondary-text: #9aa6b5;
    out property <color> button-hover: #19222c;
    out property <color> button-pressed: #222d39;
    out property <color> button-text-hover: #71c5ff;
    out property <color> toggle-on-background: #1d3347;
    out property <color> toggle-on-text: #71c5ff;
}

component FindButton inherits Rectangle {
    in property <string> label;
    in property <string> tooltip;
    in property <bool> enabled: true;
    in property <bool> checked: false;
    in property <length> font-size: 15px;
    callback clicked;

    width: 30px;
    height: 28px;
    border-radius: 6px;
    background: root.checked
        ? FindBarColors.toggle-on-background
        : touch.pressed && root.enabled
            ? FindBarColors.button-pressed
            : touch.has-hover && root.enabled ? FindBarColors.button-hover : transparent;
    opacity: root.enabled ? 1 : 0.35;
    accessible-role: button;
    accessible-label: root.tooltip;
    accessible-checked: root.checked;

    Text {
        text: root.label;
        color: root.checked || (touch.has-hover && root.enabled)
            ? FindBarColors.toggle-on-text
            : FindBarColors.secondary-text;
        font-size: root.font-size;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

export component FindBar inherits Rectangle {
    // Whether the bar is shown; hiding it also takes focus away from its field.
    in property <bool> shown: false;
    in-out property <string> query;
    // "3 of 7", "No matches", or empty before a search.
    in property <string> status;
    in property <bool> no-matches: false;
    in property <bool> match-case: false;
    out property <bool> field-focused: field.has-focus;

    callback edited(string);
    callback next();
    callback previous();
    callback close();
    callback toggle-match-case();

    // Does nothing while the bar is hidden, so an invisible field never takes the keys.
    public function focus-field() {
        if root.shown {
            field.focus();
            field.select-all();
        }
    }

    public function select-all() {
        field.select-all();
    }

    changed shown => {
        if !self.shown {
            field.clear-focus();
        }
    }

    background: FindBarColors.background;
    visible: root.shown;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 6px;
        padding-bottom: 7px;
        spacing: 6px;

        Rectangle {
            width: 280px;
            border-radius: 7px;
            border-width: 1px;
            border-color: root.no-matches && root.query != ""
                ? FindBarColors.field-border-no-matches
                : field.has-focus ? FindBarColors.field-border-focused : FindBarColors.field-border;
            background: FindBarColors.field-background;

            if field.text == "": Text {
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                text: "Find in page";
                color: FindBarColors.placeholder;
                font-size: 13px;
                vertical-alignment: center;
            }

            field := TextInput {
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                text <=> root.query;
                color: FindBarColors.text;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                accessible-label: "Find in page";

                edited => {
                    root.edited(self.text);
                }
                // Return finds the next match; Shift+Return the previous one.
                accepted => {
                    root.next();
                }
                key-pressed(event) => {
                    if event.text == Key.Return && event.modifiers.shift {
                        root.previous();
                        return accept;
                    }
                    if event.text == Key.Escape {
                        root.close();
                        return accept;
                    }
                    reject
                }
            }
        }

        Text {
            min-width: 76px;
            text: root.status;
            color: FindBarColors.secondary-text;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        FindButton {
            label: "‹";
            font-size: 18px;
            tooltip: "Previous match";
            enabled: root.query != "";
            clicked => {
                root.previous();
            }
        }

        FindButton {
            label: "›";
            font-size: 18px;
            tooltip: "Next match";
            enabled: root.query != "";
            clicked => {
                root.next();
            }
        }

        FindButton {
            width: 34px;
            label: "Aa";
            font-size: 13px;
            tooltip: "Match case";
            checked: root.match-case;
            clicked => {
                root.toggle-match-case();
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        FindButton {
            label: "×";
            font-size: 17px;
            tooltip: "Close find bar";
            clicked => {
                root.close();
            }
        }
    }

    Rectangle {
        x: 0px;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: FindBarColors.divider;
    }
}
