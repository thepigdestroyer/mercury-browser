import { ChromePalette } from "../theme/chrome-palette.slint";

// Shown in the toolbar when the active tab's page tried to open a pop-up without a click or
// key press. It is part of the browser's chrome, never of the page area, and names the origin.
// Colours come from the chrome palette's information-bar roles.
export component PopUpBlockedIndicator inherits Rectangle {
    in property <string> origin;
    callback allow;
    callback dismiss;

    height: 34px;
    max-width: 420px;
    border-radius: 8px;
    border-width: 1px;
    border-color: ChromePalette.info-border;
    background: ChromePalette.info-background;
    // a11y-base: a group named by what happened; the button inside names the origin.
    accessible-role: groupbox;
    accessible-label: "Pop-up blocked";

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 8px;

        Text {
            text: "Pop-up blocked";
            color: ChromePalette.info-text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            accessible-role: none; // a11y-base: the group's label
        }

        allow-button := Rectangle {
            horizontal-stretch: 1;
            min-width: 80px;
            height: 26px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: allow-touch.pressed
                ? ChromePalette.button-pressed
                : allow-touch.has-hover ? ChromePalette.button-hover : transparent;
            // a11y-base: names the origin, as the button does on screen.
            accessible-role: button;
            accessible-label: "Allow pop-ups from " + root.origin;
            accessible-action-default => {
                root.allow();
            }

            Text {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: "Allow pop-ups from " + root.origin;
                color: ChromePalette.accent;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none; // a11y-base: the button's label
            }

            allow-touch := TouchArea {
                clicked => {
                    root.allow();
                }
            }
        }

        Rectangle {
            width: 24px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: dismiss-touch.has-hover ? ChromePalette.button-hover : transparent;
            // a11y-base: the cross is a glyph; the button says what it does.
            accessible-role: button;
            accessible-label: "Dismiss the pop-up notice";
            accessible-action-default => {
                root.dismiss();
            }

            Text {
                text: "×";
                color: ChromePalette.button-label;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none; // a11y-base: the button's label says it
            }

            dismiss-touch := TouchArea {
                clicked => {
                    root.dismiss();
                }
            }
        }
    }
}
