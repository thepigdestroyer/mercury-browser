+#[test]
+fn test_a_cleared_state_names_its_document_and_each_document_has_its_own_id() {
+    let test = InputMethodTest::new(
+        "<!DOCTYPE html> \
+        <input id=\"parent-input\" /> \
+        <iframe id=\"frame\" srcdoc=\"&lt;input id='frame-input'&gt;\"></iframe>",
+    );
+    test.wait_until("the iframe to load", || {
+        test.eval_string(
+            "(document.getElementById('frame').contentDocument && \
+              document.getElementById('frame').contentDocument.getElementById('frame-input')) \
+             ? 'yes' : 'no'",
+        ) == "yes"
+    });
+
+    test.focus("parent-input");
+    test.wait_for_state_messages(1);
+    let parent = test.last_state();
+
+    test.eval(
+        "document.getElementById('frame').contentDocument.getElementById('frame-input').focus();",
+    );
+    test.wait_until("the iframe's field to report", || {
+        test.state_messages()
+            .iter()
+            .flatten()
+            .any(|state| state.document != parent.document)
+    });
+    test.wait_until("the page to say that its field lost the focus", || {
+        test.delegate
+            .text_cleared_documents
+            .borrow()
+            .contains(&parent.document)
+    });
+
+    let in_frame = test
+        .state_messages()
+        .into_iter()
+        .flatten()
+        .find(|state| state.document != parent.document)
+        .expect("a state from the frame");
+    assert_ne!(in_frame.document, parent.document);
+    // The "cleared" message of the page names the page, never the frame: that is what lets the
+    // browser ignore it when it arrives after the frame's state.
+    assert!(
+        !test
+            .delegate
+            .text_cleared_documents
+            .borrow()
+            .contains(&in_frame.document)
+    );
+}
