+#[test]
+fn test_a_composition_left_behind_by_a_focus_change_ends_with_compositionend() {
+    let test = InputMethodTest::new_with_editing_hosts(
+        "<!DOCTYPE html> \
+        <div id=\"a\" contenteditable></div> \
+        <div id=\"b\" contenteditable></div>",
+    );
+    test.install_event_listeners("a");
+    test.install_event_listeners("b");
+    test.focus_editing_host("a");
+    test.set_marked("ni");
+    // The page moves the focus; the next input method event is for the other element.
+    test.focus_editing_host("b");
+    test.set_marked("wo");
+    test.commit("我");
+
+    let events = test.drain_received_events();
+    let position = |wanted: &InputMethodEvent, from: usize| {
+        events[from..]
+            .iter()
+            .position(|event| event == wanted)
+            .map(|found| found + from)
+    };
+    let first_end = position(&InputMethodEvent::CompositionEnd("ni".to_owned()), 0)
+        .expect("the first composition ends with its own text");
+    let second_start = events
+        .iter()
+        .enumerate()
+        .filter(|(_, event)| **event == InputMethodEvent::CompositionStart)
+        .map(|(index, _)| index)
+        .nth(1)
+        .expect("the second composition starts");
+    assert!(
+        first_end < second_start,
+        "compositionend of the left composition comes before the next compositionstart: {events:?}"
+    );
+    let ends = events
+        .iter()
+        .filter(|event| matches!(event, InputMethodEvent::CompositionEnd(_)))
+        .count();
+    assert_eq!(ends, 2, "one compositionend per composition: {events:?}");
+    let (in_a, in_b) = (test.get_text_content("a"), test.get_text_content("b"));
+    assert_eq!(
+        (in_a.as_str(), in_b.as_str()),
+        ("ni", "我"),
+        "the text of the two elements; events: {events:?}"
+    );
+}
