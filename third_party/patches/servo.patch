+#[test]
+fn test_a_reflow_that_changes_nothing_about_the_field_sends_no_message() {
+    // The flush after a reflow compares what the state is made of before it copies any text: a
+    // page that animates elsewhere does not make a focused text area send (or rebuild) its state.
+    let test = InputMethodTest::new(
+        "<!DOCTYPE html> \
+        <textarea id=\"my-input\" style=\"width: 200px; height: 100px;\"></textarea> \
+        <p id=\"other\">x</p>",
+    );
+    test.eval(
+        "const area = document.getElementById('my-input'); \
+         area.value = 'x'.repeat(100000); area.setSelectionRange(5, 5); area.focus();",
+    );
+    test.wait_for_state_messages(1);
+    test.wait_for_a_frame();
+    let count = test.state_messages().len();
+    for round in 0..3 {
+        test.eval(format!(
+            "document.getElementById('other').textContent = 'y'.repeat({});",
+            10 + round
+        ));
+        test.wait_for_a_frame();
+    }
+    assert_eq!(test.state_messages().len(), count);
+
+    // A real change still gets through.
+    test.key(Key::Character("z".to_owned()));
+    assert!(test.state_messages().len() > count);
+    assert_eq!(test.last_state().selection, 6..6);
+}
