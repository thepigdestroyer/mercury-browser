+impl InputMethodTest {
+    /// Wait for a frame to be painted after the page changed something, so that the
+    /// rendering update (and the text state flush that follows its reflow) has run.
+    fn wait_for_a_frame(&self) {
+        self.delegate.new_frame_ready.set(false);
+        self.eval(
+            "requestAnimationFrame(() => { \
+               document.body.style.outline = document.body.style.outline ? '' : '1px solid red'; \
+             });",
+        );
+        self.servo_test
+            .spin(|| !self.delegate.new_frame_ready.get());
+    }
+}
