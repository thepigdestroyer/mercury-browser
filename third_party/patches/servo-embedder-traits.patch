diff --git a/mercury/mod.rs b/mercury/mod.rs
new file mode 100644
--- /dev/null
+++ b/mercury/mod.rs
@@ -0,0 +1,140 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+// Mercury: this whole directory is Mercury's own (K0 engine base, R14 section 3.4). It holds the
+// one message variant, `EmbedderMsg::Mercury`, through which every Mercury lane sends its own
+// messages from the engine to the embedder, so that a lane adds variants in its own file here and
+// never in a shared enum. Nothing in upstream Servo refers to it.
+
+//! Messages from the engine to Mercury, one sub-enum per lane.
+//!
+//! [`EmbedderMsg::Mercury`](crate::EmbedderMsg::Mercury) carries a [`MercuryEmbedderMsg`]. Each
+//! lane owns exactly one file in this directory (`a11y.rs`, `core.rs`, `media.rs`, `net.rs`,
+//! `page.rs`, `text.rs`) and adds its variants, and the payload types they need, only there. The
+//! public items of every lane file are re-exported from this module and from the crate root, so
+//! they are reachable as `embedder_traits::*` and (through the `servo` crate) as `servo::*`.
+//!
+//! The lane files are private modules on purpose: names such as `core` and `net` must not become
+//! public names of the crate, where a glob re-export would shadow the `core` and `net` crates.
+//!
+//! The `Debug` implementations in this directory print only the variant path, for example
+//! `Core::Probe`, and never a payload: what a page sent must not reach a log.
+
+mod a11y;
+mod core;
+mod media;
+mod net;
+mod page;
+mod text;
+
+use std::fmt;
+
+use serde::{Deserialize, Serialize};
+use strum::IntoStaticStr;
+
+pub use self::a11y::*;
+pub use self::core::*;
+pub use self::media::*;
+pub use self::net::*;
+pub use self::page::*;
+pub use self::text::*;
+
+/// A message from the engine to Mercury, grouped by the lane that owns it.
+///
+/// Sent as [`EmbedderMsg::Mercury`](crate::EmbedderMsg::Mercury) and delivered to
+/// `WebViewDelegate::notify_mercury_message` (or, without a web view, to
+/// `ServoDelegate::notify_mercury_message`) in the `servo` crate. Like `EmbedderMsg` itself it
+/// crosses the process boundary, so every payload must be `Serialize + Deserialize`.
+#[derive(Deserialize, IntoStaticStr, Serialize)]
+pub enum MercuryEmbedderMsg {
+    /// Scaffold and test messages that belong to no lane.
+    Core(CoreMsg),
+    /// Accessibility (the `a11y` lane).
+    A11y(A11yMsg),
+    /// Media: MSE, EME, autoplay, capture and WebRTC (the `media` lane).
+    Media(MediaMsg),
+    /// Network and privacy messages that need the embedder (the `net` lane).
+    Net(NetMsg),
+    /// Page and document features: storage, locks, viewport (the `page` lane).
+    Page(PageMsg),
+    /// Text input and editing: IME, composition, spelling (the `text` lane).
+    Text(TextMsg),
+}
+
+impl fmt::Debug for MercuryEmbedderMsg {
+    fn fmt(&self, formatter: &mut fmt::Formatter) -> fmt::Result {
+        let lane: &'static str = self.into();
+        let variant: &'static str = match self {
+            Self::Core(message) => message.into(),
+            Self::A11y(message) => message.into(),
+            Self::Media(message) => message.into(),
+            Self::Net(message) => message.into(),
+            Self::Page(message) => message.into(),
+            Self::Text(message) => message.into(),
+        };
+        write!(formatter, "{lane}::{variant}")
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn assert_send_static<T: Send + 'static>() {}
+
+    #[test]
+    fn every_lane_type_is_send_and_static() {
+        assert_send_static::<MercuryEmbedderMsg>();
+        assert_send_static::<CoreMsg>();
+        assert_send_static::<A11yMsg>();
+        assert_send_static::<MediaMsg>();
+        assert_send_static::<NetMsg>();
+        assert_send_static::<PageMsg>();
+        assert_send_static::<TextMsg>();
+    }
+
+    #[test]
+    fn debug_prints_only_the_variant_path() {
+        let message = MercuryEmbedderMsg::Core(CoreMsg::Probe(0xDEAD_BEEF));
+        assert_eq!(format!("{message:?}"), "Core::Probe");
+        assert_eq!(format!("{:?}", CoreMsg::Probe(7)), "Probe");
+    }
+
+    #[test]
+    fn the_variant_is_named_for_its_lane() {
+        let message = MercuryEmbedderMsg::Core(CoreMsg::Probe(1));
+        let lane: &'static str = (&message).into();
+        assert_eq!(lane, "Core");
+    }
+
+    /// The size of `EmbedderMsg` in Servo 0.8.0 on a 64-bit target, measured on 7f1a78e before the
+    /// Mercury variant existed: its largest variant is `ShowEmbedderControl` (248 bytes with its tag).
+    /// Every message in the channel is this big, so the new variant must not grow the enum; the
+    /// allowance is one pointer.
+    #[cfg(target_pointer_width = "64")]
+    const EMBEDDER_MSG_SIZE_IN_SERVO_0_8: usize = 248;
+
+    #[cfg(target_pointer_width = "64")]
+    #[test]
+    fn the_mercury_variant_did_not_grow_the_embedder_message() {
+        use std::mem::size_of;
+
+        let size = size_of::<crate::EmbedderMsg>();
+        assert!(
+            size <= EMBEDDER_MSG_SIZE_IN_SERVO_0_8 + size_of::<usize>(),
+            "EmbedderMsg is {size} bytes; Servo 0.8.0 had {EMBEDDER_MSG_SIZE_IN_SERVO_0_8}"
+        );
+        // The variant itself (a web view id and a message) is far smaller than the largest one.
+        assert!(size_of::<(Option<servo_base::id::WebViewId>, MercuryEmbedderMsg)>() <= 32);
+    }
+
+    #[test]
+    fn the_engine_message_wrapper_names_only_itself() {
+        let message = crate::EmbedderMsg::Mercury(
+            None,
+            MercuryEmbedderMsg::Core(CoreMsg::Probe(0xDEAD_BEEF)),
+        );
+        assert_eq!(format!("{message:?}"), "Mercury");
+    }
+}
diff --git a/mercury/net.rs b/mercury/net.rs
new file mode 100644
--- /dev/null
+++ b/mercury/net.rs
@@ -0,0 +1,135 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+// Mercury: this file belongs to the net lane. Add variants (and the payload types they need) here
+// only, never in another lane's file or in a shared enum.
+
+use std::fmt;
+
+use content_security_policy::Destination;
+use serde::{Deserialize, Serialize};
+use servo_url::ServoUrl;
+use strum::IntoStaticStr;
+
+/// Messages from the engine to Mercury for the `net` lane (network policy, cookies, privacy).
+///
+/// Messages that come from the network thread rather than from script or the constellation reach the
+/// embedder as `NetToEmbedderMsg::Mercury` in `servo-net`, which carries a [`MercuryEmbedderMsg`] and
+/// ends in the same delivery function as the other lanes' messages.
+///
+/// `Debug` prints only the variant name, never a payload.
+///
+/// [`MercuryEmbedderMsg`]: crate::MercuryEmbedderMsg
+#[derive(Deserialize, IntoStaticStr, Serialize)]
+pub enum NetMsg {
+    /// A request was blocked as mixed content: a secure page asked for something that is not
+    /// potentially trustworthy, and the user has not allowed mixed content on the page's site (EC17).
+    /// Sent once for each blocked request, naming the web view the request belongs to when it has one.
+    MixedContentBlocked {
+        /// The URL of the blocked request (of the request, not of a response that was blocked after
+        /// it was answered).
+        url: ServoUrl,
+        /// What the blocked request was for (script, image, fetch and so on).
+        destination: Destination,
+    },
+}
+
+impl fmt::Debug for NetMsg {
+    fn fmt(&self, formatter: &mut fmt::Formatter) -> fmt::Result {
+        let variant: &'static str = self.into();
+        write!(formatter, "{variant}")
+    }
+}
+
+/// How the embedder changes a request before it goes on: the payload of
+/// `WebResourceResponseMsg::Rewrite` (EC37).
+///
+/// The network thread applies it with the rules of `servo-net/mercury_rewrite.rs` (the scheme must stay,
+/// the origin must stay unless the request is a top-level navigation, only `http` and `https`, no
+/// credential, cookie or connection headers, bounded sizes) and refuses the whole rewrite, leaving the
+/// request as it was, when any part breaks a rule. An empty rewrite changes nothing.
+///
+/// `Debug` shows only which parts are set, never a URL or a header value.
+#[derive(Clone, Default, Deserialize, Serialize)]
+pub struct WebResourceRewrite {
+    /// The new URL of the request's current hop. Must keep the scheme and, unless the request is a
+    /// top-level navigation, the origin.
+    pub url: Option<ServoUrl>,
+    /// Headers to set (replacing any value the request has), as (name, value).
+    pub set_headers: Vec<(String, String)>,
+    /// Names of headers to remove. Removals are done before the headers are set.
+    pub remove_headers: Vec<String>,
+}
+
+impl fmt::Debug for WebResourceRewrite {
+    fn fmt(&self, formatter: &mut fmt::Formatter) -> fmt::Result {
+        formatter
+            .debug_struct("WebResourceRewrite")
+            .field("url", &self.url.as_ref().map(|_| "<set>"))
+            .field("set_headers", &self.set_headers.len())
+            .field("remove_headers", &self.remove_headers.len())
+            .finish()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn mixed_content_message_debug_is_the_variant_name_only() {
+        let message = NetMsg::MixedContentBlocked {
+            url: ServoUrl::parse("http://insecure.example/script.js?token=secret").unwrap(),
+            destination: Destination::Script,
+        };
+        assert_eq!(format!("{message:?}"), "MixedContentBlocked");
+        let wrapped = crate::MercuryEmbedderMsg::Net(message);
+        assert_eq!(format!("{wrapped:?}"), "Net::MixedContentBlocked");
+    }
+
+    #[test]
+    fn mixed_content_message_is_send_and_static() {
+        fn assert_send_static<T: Send + 'static>() {}
+        assert_send_static::<NetMsg>();
+        assert_send_static::<WebResourceRewrite>();
+    }
+
+    #[test]
+    fn an_empty_rewrite_is_the_default_and_sets_nothing() {
+        let rewrite = WebResourceRewrite::default();
+        assert!(rewrite.url.is_none());
+        assert!(rewrite.set_headers.is_empty());
+        assert!(rewrite.remove_headers.is_empty());
+    }
+
+    #[test]
+    fn rewrite_debug_shows_no_url_and_no_header_value() {
+        let rewrite = WebResourceRewrite {
+            url: Some(ServoUrl::parse("https://a.example/?session=hunter2").unwrap()),
+            set_headers: vec![("X-Token".to_owned(), "hunter2".to_owned())],
+            remove_headers: vec!["X-Other".to_owned()],
+        };
+        let printed = format!("{rewrite:?}");
+        assert!(!printed.contains("hunter2"), "{printed}");
+        assert!(!printed.contains("a.example"), "{printed}");
+        assert!(!printed.contains("X-Token"), "{printed}");
+        assert!(printed.contains("set_headers: 1"), "{printed}");
+        assert!(printed.contains("remove_headers: 1"), "{printed}");
+    }
+
+    #[test]
+    fn the_net_message_did_not_make_the_wrapper_large() {
+        // `EmbedderMsg` and `NetToEmbedderMsg` carry `(Option<WebViewId>, MercuryEmbedderMsg)`; the
+        // scaffold's own test pins 32 bytes for that pair, and this variant (a URL pointer and a
+        // one-byte destination) has to fit.
+        #[cfg(target_pointer_width = "64")]
+        {
+            let size = std::mem::size_of::<(
+                Option<servo_base::id::WebViewId>,
+                crate::MercuryEmbedderMsg,
+            )>();
+            assert!(size <= 32, "{size} bytes");
+        }
+    }
+}
