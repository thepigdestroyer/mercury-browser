+fn context_of_a_page_on_localhost(probe: &Probe) -> FetchContext {
+    let context = blocking();
+    seed(&context, &probe.localhost("/"), &["session=1"]);
+    seed(&context, &probe.loopback("/"), &["tracker=1"]);
+    context
+}
