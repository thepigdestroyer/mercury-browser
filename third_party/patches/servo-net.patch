+        assert_eq!(calls.len(), 2, "{calls:?}");
+        let args = arguments(calls.iter().find(|c| c.starts_with("\"a, b")).unwrap());
+        assert_eq!(args, [r#""a, b ( ) {}""#, "f(x, y)", "'c'"]);
+        assert_eq!(inline_captures("{{x}} {} {:?} {y} {z:?}"), ["y", "z"]);
+    }
+}
