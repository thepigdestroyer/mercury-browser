+    #[test]
+    fn the_guard_reads_literals_and_nesting_correctly() {
+        let source = r#"
+            // not a call: some_info!(self.cookie.value())
+            debug!("a, b ( ) {}", f(x, y), 'c');
+            warn!("quote \" and paren ) in text, {}", self.cookie.name());
