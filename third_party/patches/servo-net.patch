+// SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
+// SPDX-FileCopyrightText: 2026 Mrinal Joshi and the Mercury Browser contributors
+// Mercury: sign-in prompts for the 401 of a `fetch` or XHR (EC29). This is a new Mercury file; nothing in it
+// is copied from Servo or another project. The hooks are two calls in `HttpState::request_authentication`
+// (`http_loader.rs`) and the `mod` lines in `lib.rs`; `MERCURY.md` lists them.
+
+//! When may a 401 answered to `fetch` or XHR open a sign-in prompt (EC29, decision D12).
+//!
+//! Servo 0.8 prompts only for navigations: `HttpState::request_authentication` answers `None` for every
+//! other request, so a page that calls `fetch("/api")` on a site behind Basic authentication gets its 401
+//! back and the user is never asked. Browsers do ask in that case, but a prompt that any request can raise
+//! is a phishing and spam surface, so Mercury asks only when **all** of these hold:
+//!
+//! * the request is a `fetch` or XHR (destination none, mode not `Navigate`): images, scripts, styles,
+//!   fonts, frames and workers never prompt;
+//! * it has a web view (without one there is nowhere to show the prompt);
+//! * the page asked for **its own origin** (request origin == the URL's origin): a page cannot make the
+//!   user type a password for somebody else's server;
+//! * the page is a document of the web view's **top-level site** ([`Party::First`] by the policy's
+//!   record): an embedded frame or a worker of another site cannot raise a prompt over the page;
+//! * no prompt for the same (web view, origin) is open ([`PromptDecision::InFlight`]), and the user did not
+//!   refuse one in the last [`REFUSAL_SILENCE`] ([`PromptDecision::Silenced`]).
+//!
+//! Everything else keeps today's answer: the 401 goes back to the page. A 407 (proxy) is not changed: the
+//! caller must not ask this module about one, see "Hook" below. Navigations keep prompting exactly as before
+//! and do not use the limiter.
+//!
+//! The prompt itself carries no realm or initiator line (non-goal of this lane: the sign-in dialog shows the
+//! URL only).
+//!
+//! # Hook
+//!
+//! `HttpState::request_authentication` (`http_loader.rs`) asks [`subresource_prompt_allowed`] for a request
+//! whose mode is not `Navigate` (and never for a 407, which it refuses first: only the caller knows the
+//! status), and calls [`prompt_finished`] for such a request when the embedder has answered. A navigation is
+//! not asked and does not touch the limiter; asked anyway, this module says `true` for one, so a call site
+//! that replaces the old `mode != Navigate` test with this function keeps navigations as they were.
+//!
+//! # Limiter
+//!
+//! [`AuthLimiter`] is a small bounded map under a `Mutex` (at most [`MAX_ENTRIES`] keys; a key that is not
+//! in flight is evicted before another, oldest first; when every slot is in flight the answer is
+//! [`PromptDecision::Full`], which is a refusal). It reads time from an injectable [`Clock`], so the
+//! 60 second silence is tested without waiting. It lives in the network policy
+//! ([`NetPolicy::auth_limiter`](crate::net_policy::NetPolicy::auth_limiter)), one per process, shared by
+//! the public and the private `HttpState`.
+
+use std::collections::HashMap;
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use log::debug;
+use net_traits::request::{Destination, Origin, Request, RequestMode};
+use parking_lot::Mutex;
+use servo_base::id::WebViewId;
+
+use crate::http_loader::HttpState;
+use crate::net_policy::{NetPolicy, Party};
+
+/// How many (web view, origin) pairs the limiter remembers.
+pub const MAX_ENTRIES: usize = 256;
+
+/// How long a refused prompt silences the same (web view, origin).
+pub const REFUSAL_SILENCE: Duration = Duration::from_secs(60);
+
+/// The limiter's source of time. Tests give it a clock they can move.
+pub trait Clock: Send + Sync {
+    fn now(&self) -> Instant;
+}
+
+/// The wall clock (monotonic).
+#[derive(Clone, Copy, Debug, Default)]
+pub struct SystemClock;
+
+impl Clock for SystemClock {
+    fn now(&self) -> Instant {
+        Instant::now()
+    }
+}
+
+/// What the limiter says about a new prompt.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum PromptDecision {
+    /// Go ahead: the pair is now marked as in flight until [`AuthLimiter::finish`].
+    Allowed,
+    /// A prompt for this (web view, origin) is open.
+    InFlight,
+    /// The user refused a prompt for this (web view, origin) less than [`REFUSAL_SILENCE`] ago.
+    Silenced,
+    /// Every slot is a prompt in flight; nothing can be recorded, so nothing is allowed.
+    Full,
+}
+
+#[derive(Clone, Copy, Debug)]
+enum State {
+    InFlight,
+    SilentUntil(Instant),
+}
+
+#[derive(Debug)]
+struct Slot {
+    state: State,
+    /// Counts up with every touch; the smallest value is the oldest.
+    touched: u64,
+}
+
+#[derive(Debug, Default)]
+struct Inner {
+    slots: HashMap<(WebViewId, String), Slot>,
+    ticks: u64,
+}
+
+impl Inner {
+    fn touch(&mut self) -> u64 {
+        self.ticks = self.ticks.wrapping_add(1);
+        self.ticks
+    }
+}
+
+/// At most one prompt in flight per (web view, origin), and a silence after a refusal. See the module
+/// documentation.
+pub struct AuthLimiter {
+    clock: Arc<dyn Clock>,
+    capacity: usize,
+    silence: Duration,
+    inner: Mutex<Inner>,
+}
+
+impl Default for AuthLimiter {
+    fn default() -> AuthLimiter {
+        AuthLimiter::with_clock(Arc::new(SystemClock))
+    }
+}
+
+impl std::fmt::Debug for AuthLimiter {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("AuthLimiter")
+            .field("capacity", &self.capacity)
+            .field("silence", &self.silence)
+            .field("entries", &self.len())
+            .finish()
+    }
+}
+
+impl AuthLimiter {
+    /// A limiter with the default bound and silence that reads time from `clock`.
+    pub fn with_clock(clock: Arc<dyn Clock>) -> AuthLimiter {
+        AuthLimiter::with_parts(clock, MAX_ENTRIES, REFUSAL_SILENCE)
+    }
+
+    /// A limiter with its own bound and silence (tests use a small bound). A bound of 0 refuses everything.
+    pub fn with_parts(clock: Arc<dyn Clock>, capacity: usize, silence: Duration) -> AuthLimiter {
+        AuthLimiter {
+            clock,
+            capacity,
+            silence,
+            inner: Mutex::new(Inner::default()),
+        }
+    }
+
+    /// How many (web view, origin) pairs are recorded.
+    pub fn len(&self) -> usize {
+        self.inner.lock().slots.len()
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.len() == 0
+    }
+
+    /// Ask to open a prompt for `origin` (an ASCII serialisation) in `webview`. On
+    /// [`PromptDecision::Allowed`] the pair is in flight, and the caller must call [`AuthLimiter::finish`]
+    /// when the prompt is over, whatever the user did.
+    pub fn begin(&self, webview: WebViewId, origin: &str) -> PromptDecision {
+        let now = self.clock.now();
+        let mut inner = self.inner.lock();
+        let key = (webview, origin.to_owned());
+
+        match inner.slots.get(&key).map(|slot| slot.state) {
+            Some(State::InFlight) => return PromptDecision::InFlight,
+            Some(State::SilentUntil(until)) if now < until => return PromptDecision::Silenced,
+            // A silence that has run out: the slot is reused below.
+            Some(State::SilentUntil(_)) => {}
+            None => {
+                if inner.slots.len() >= self.capacity && !self.make_room(&mut inner, now) {
+                    return PromptDecision::Full;
+                }
+            }
+        }
+
+        let touched = inner.touch();
+        inner.slots.insert(
+            key,
+            Slot {
+                state: State::InFlight,
+                touched,
+            },
+        );
+        PromptDecision::Allowed
+    }
+
+    /// The prompt for (`webview`, `origin`) is over. `answered` is true when the user supplied
+    /// credentials: the pair is forgotten. Otherwise (cancelled, dismissed, nobody there) the pair is
+    /// silenced for the refusal period. A pair that is not in flight is left alone.
+    pub fn finish(&self, webview: WebViewId, origin: &str, answered: bool) {
+        let now = self.clock.now();
+        let mut inner = self.inner.lock();
+        let key = (webview, origin.to_owned());
+        if !matches!(
+            inner.slots.get(&key).map(|slot| slot.state),
+            Some(State::InFlight)
+        ) {
+            return;
+        }
+        if answered {
+            inner.slots.remove(&key);
+        } else {
+            let touched = inner.touch();
+            inner.slots.insert(
+                key,
+                Slot {
+                    state: State::SilentUntil(now + self.silence),
+                    touched,
+                },
+            );
+        }
+    }
+
+    /// Free one slot: drop every silence that has run out, then, if still full, the oldest silence. A
+    /// prompt in flight is never dropped (that would allow a second one). Returns whether a slot is free.
+    fn make_room(&self, inner: &mut Inner, now: Instant) -> bool {
+        inner.slots.retain(|_, slot| match slot.state {
+            State::InFlight => true,
+            State::SilentUntil(until) => now < until,
+        });
+        if inner.slots.len() < self.capacity {
+            return true;
+        }
+        let oldest_silence = inner
+            .slots
+            .iter()
+            .filter(|(_, slot)| matches!(slot.state, State::SilentUntil(_)))
+            .min_by_key(|(_, slot)| slot.touched)
+            .map(|(key, _)| key.clone());
+        match oldest_silence {
+            Some(key) => {
+                inner.slots.remove(&key);
+                true
+            }
+            None => false,
+        }
+    }
+}
+
+/// The request's own origin as an ASCII serialisation, when the request is one that may prompt: a
+/// `fetch` or XHR (not a navigation) whose origin is the origin of its URL, and a tuple origin. `None`
+/// for everything else.
+fn own_origin_of_subresource(request: &Request) -> Option<String> {
+    if request.mode == RequestMode::Navigate || request.destination != Destination::None {
+        return None;
+    }
+    let Origin::Origin(origin) = &request.origin else {
+        return None;
+    };
+    if !origin.is_tuple() || *origin != request.current_url().origin() {
+        return None;
+    }
+    Some(origin.ascii_serialization().into_owned())
+}
+
+/// Whether a 401 answered to `request` may open a sign-in prompt. See the module documentation for the
+/// rules. A navigation is not this module's business and gives `true` (it prompts as it always did).
+///
+/// A `true` for a non-navigation request has recorded the prompt as in flight: call [`prompt_finished`]
+/// when it is over.
+pub fn subresource_prompt_allowed(state: &HttpState, request: &Request) -> bool {
+    if request.mode == RequestMode::Navigate {
+        return true;
+    }
+    let Some(webview) = request.target_webview_id else {
+        return false;
+    };
+    let Some(origin) = own_origin_of_subresource(request) else {
+        return false;
+    };
+    // The page must be a document of the web view's top-level site.
+    if state.net_policy.sites_of_request(request).party != Party::First {
+        debug!("sign-in prompt for a subresource refused: not the top-level site's own request");
+        return false;
+    }
+    match state.net_policy.auth_limiter().begin(webview, &origin) {
+        PromptDecision::Allowed => true,
+        decision => {
+            debug!("sign-in prompt for a subresource refused: {decision:?}");
+            false
+        }
+    }
+}
+
+/// The prompt that [`subresource_prompt_allowed`] allowed is over; `answered` is whether the user
+/// supplied credentials (true clears the limiter's record, false silences the pair for
+/// [`REFUSAL_SILENCE`]). Does nothing for a navigation or for a request that could not have been allowed.
+pub fn prompt_finished(state: &HttpState, request: &Request, answered: bool) {
+    let Some(webview) = request.target_webview_id else {
+        return;
+    };
+    let Some(origin) = own_origin_of_subresource(request) else {
+        return;
+    };
+    state
+        .net_policy
+        .auth_limiter()
+        .finish(webview, &origin, answered);
+}
+
+/// The mark "a prompt for this (web view, origin) is open" that [`subresource_prompt_allowed`] set, owned by
+/// the fetch that waits for the answer. [`PromptGuard::finish`] ends it with the user's answer; when the guard
+/// is dropped without that (the fetch future was dropped while the prompt was open: an aborted `fetch`, a
+/// navigation away) it ends it as a refusal, so the pair is silenced for [`REFUSAL_SILENCE`] and not stuck "in
+/// flight" for the life of the web view. A silence, not a release, because the prompt of the embedder may still
+/// be on screen: a page must not be able to stack prompts by aborting its own requests.
+#[must_use = "dropping the guard ends the prompt as a refusal"]
+pub struct PromptGuard {
+    policy: NetPolicy,
+    webview: WebViewId,
+    origin: String,
+    finished: bool,
+}
+
+impl PromptGuard {
+    /// The guard of the prompt that [`subresource_prompt_allowed`] allowed for `request`. `None` for a request
+    /// that cannot have been allowed (a navigation, no web view, not its own origin).
+    pub fn of(state: &HttpState, request: &Request) -> Option<PromptGuard> {
+        Some(PromptGuard {
+            policy: state.net_policy.clone(),
+            webview: request.target_webview_id?,
+            origin: own_origin_of_subresource(request)?,
+            finished: false,
+        })
+    }
+
+    /// The prompt is over; `answered` is whether the user supplied credentials (see [`prompt_finished`]).
+    pub fn finish(mut self, answered: bool) {
+        self.finished = true;
+        self.policy
+            .auth_limiter()
+            .finish(self.webview, &self.origin, answered);
+    }
+}
+
+impl Drop for PromptGuard {
+    fn drop(&mut self) {
+        if !self.finished {
+            self.policy
+                .auth_limiter()
+                .finish(self.webview, &self.origin, false);
+        }
+    }
+}
diff --git a/mercury_cookies.rs b/mercury_cookies.rs
new file mode 100644
--- /dev/null
+++ b/mercury_cookies.rs
@@ -0,0 +1,304 @@
+// SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
+// SPDX-FileCopyrightText: 2026 Mrinal Joshi and the Mercury Browser contributors
+// Mercury: the cookie rules of the network policy: third-party cookies blocked (EC5) and SameSite enforced
+// (EC6). A new Mercury file, written from RFC 6265bis (draft 20, sections 5.2, 5.5 and 5.8) and the net-1
+// lane brief; nothing in it is copied from Servo or another project. The hooks are in `http_loader.rs`,
+// `resource_thread.rs`, `cookie.rs`, `cookie_storage.rs` and `servo-script`'s `document.rs`; `MERCURY.md`
+// lists them.
+
+//! Cookie rules that need to know who is asking.
+//!
+//! Servo's jar answers by URL alone. Mercury's policy ([`NetPolicy`]) asks two more questions before a cookie
+//! goes out or comes in:
+//!
+//! * **Is the request third party?** With third-party cookies blocked (EC5), a request whose site differs
+//!   from the top-level page's (or whose top-level site is unknown) gets no `Cookie` header, its `Set-Cookie`
+//!   is ignored, and `document.cookie` of a third-party frame reads `""` and drops writes. Decision D5.
+//! * **Is the request same-site?** With SameSite enforced (EC6), an explicit `SameSite=Strict` cookie is sent
+//!   only on a same-site request and an explicit `SameSite=Lax` cookie also on a top-level navigation that
+//!   uses a safe method; a `Set-Cookie` with either is accepted only from a same-site request or a top-level
+//!   navigation; `SameSite=None` needs `Secure` (also for `document.cookie`). A cookie without the attribute
+//!   is unrestricted (Lax-by-default, [`NetPolicy::same_site_lax_default`], stays off in Mercury, decision D8).
+//!
+//! A request is **same-site** when the site that started it, every site in its URL list (so no redirect
+//! crossed sites) and the top-level site are one site. An opaque initiator on a top-level navigation that the
+//! **browser** started also counts (a typed URL, a bookmark, a reload: decision D8), which is what lets a typed
+//! URL send its `Strict` cookies; a script navigation from an opaque origin does not. A document that reads `document.cookie` is same-site when its own site is the
+//! top-level site.
+//!
+//! The functions here are pure over [`RequestContext`] and the cookie, so the rules are tested without a
+//! network (`tests/cookie_policy.rs`).
+
+use cookie::{Cookie, SameSite};
+use http::Method;
+use hyper_serde::Serde;
+use net_traits::CookieSource;
+use net_traits::pub_domains::Site;
+use net_traits::request::{Request, RequestBuilder};
+use servo_url::ServoUrl;
+
+use crate::cookie::ServoCookie;
+use crate::cookie_storage::CookieStorage;
+use crate::http_loader::HttpState;
+use crate::net_policy::{
+    NetPolicy, Party, RequestParts, RequestSites, site_key_of_origin, site_key_of_url,
+};
+
+/// What the cookie rules need to know about one request, a WebSocket handshake or a document.
+#[derive(Clone, Debug)]
+pub(crate) struct RequestContext {
+    /// The sites of the request (top-level, request, initiator, party).
+    pub(crate) sites: RequestSites,
+    /// The RFC 6265bis "same-site request" test: see the module documentation.
+    pub(crate) same_site: bool,
+    /// The request's method is safe (`GET`, `HEAD`, `OPTIONS`, `TRACE`).
+    pub(crate) safe_method: bool,
+}
+
+impl RequestContext {
+    /// The context of a request, at the hop it is at now.
+    pub(crate) fn of_request(policy: &NetPolicy, request: &Request) -> RequestContext {
+        RequestContext::of_parts(policy, &RequestParts::of_request(request))
+    }
+
+    /// The context of a request that is still a builder (the WebSocket handshake).
+    pub(crate) fn of_builder(policy: &NetPolicy, request: &RequestBuilder) -> RequestContext {
+        RequestContext::of_parts(policy, &RequestParts::of_builder(request))
+    }
+
+    /// The context of a document that reads or writes `document.cookie`.
+    pub(crate) fn of_document(
+        policy: &NetPolicy,
+        url: &ServoUrl,
+        partition_key: &Option<Site>,
+    ) -> RequestContext {
+        let sites = policy.sites_of_document(url, partition_key);
+        RequestContext {
+            // A document is same-site with the top-level page when its site is the top-level site.
+            same_site: sites.party == Party::First,
+            safe_method: true,
+            sites,
+        }
+    }
+
+    fn of_parts(policy: &NetPolicy, parts: &RequestParts<'_>) -> RequestContext {
+        let sites = policy.sites_of_parts(parts);
+        RequestContext {
+            same_site: is_same_site_request(parts, &sites),
+            safe_method: is_safe_method(parts.method),
+            sites,
+        }
+    }
+}
+
+/// RFC 9110 section 9.2.1: the safe methods.
+fn is_safe_method(method: &Method) -> bool {
+    matches!(
+        *method,
+        Method::GET | Method::HEAD | Method::OPTIONS | Method::TRACE
+    )
+}
+
+/// RFC 6265bis section 5.2, as decided in the lane brief (D8) and tightened by the net-1 review: the
+/// initiator's site, every site in the URL list and the top-level site are one site. An initiator with no
+/// site (an opaque origin) counts only for a top-level navigation that **the browser** started (a typed
+/// address, a bookmark, a reload): a script that navigates from a sandboxed frame or a `data:` document has an
+/// opaque origin too and is cross-site (finding 2). An unknown or opaque top-level site never counts (fail
+/// closed).
+///
+/// Not covered: the ancestor chain. A frame of `a.test` inside `b.test` inside `a.test` has the top-level site
+/// `a.test` and is judged same-site, where a browser that walks the ancestors would call it cross-site (finding
+/// 9). The chain is not on the request; it needs the ancestor list of the document, like the partition key.
+fn is_same_site_request(parts: &RequestParts<'_>, sites: &RequestSites) -> bool {
+    let Some(top_level) = sites.top_level.as_deref().filter(|site| !site.is_empty()) else {
+        return false;
+    };
+    // No redirect hop (and not the first URL) may be on another site.
+    if parts
+        .urls
+        .iter()
+        .any(|url| site_key_of_origin(&url.origin()) != top_level)
+    {
+        return false;
+    }
+    match sites.initiator.as_deref() {
+        Some(initiator) => initiator == top_level,
+        // Opaque or missing: only a navigation that the browser itself started is same-site.
+        None => sites.top_level_navigation && parts.is_browser_initiated_navigation(),
+    }
+}
+
+/// How a cookie is restricted by its `SameSite` attribute.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Restriction {
+    /// `SameSite=None`, or no attribute (while Lax-by-default is off).
+    Unrestricted,
+    Lax,
+    Strict,
+}
+
+fn restriction_of(policy: &NetPolicy, cookie: &Cookie<'_>) -> Restriction {
+    match cookie.same_site() {
+        Some(SameSite::Strict) => Restriction::Strict,
+        Some(SameSite::Lax) => Restriction::Lax,
+        Some(SameSite::None) => Restriction::Unrestricted,
+        None if policy.same_site_lax_default() => Restriction::Lax,
+        None => Restriction::Unrestricted,
+    }
+}
+
+/// RFC 6265bis section 5.8.3 (the "retrieval" steps for `SameSite`): whether `cookie` may go with the request
+/// or be read by the document. With SameSite not enforced every cookie may.
+pub(crate) fn cookie_may_be_sent(
+    policy: &NetPolicy,
+    context: &RequestContext,
+    cookie: &Cookie<'_>,
+) -> bool {
+    if !policy.same_site_enforcement() {
+        return true;
+    }
+    match restriction_of(policy, cookie) {
+        Restriction::Unrestricted => true,
+        Restriction::Strict => context.same_site,
+        Restriction::Lax => {
+            context.same_site || (context.sites.top_level_navigation && context.safe_method)
+        },
+    }
+}
+
+/// RFC 6265bis section 5.5 (storage steps for `SameSite`) and the `SameSite=None` needs `Secure` rule (decision
+/// D6): whether a cookie that arrived with this request or from this document is stored. With SameSite not
+/// enforced every cookie is.
+pub(crate) fn accept_set_cookie(
+    policy: &NetPolicy,
+    context: &RequestContext,
+    cookie: &Cookie<'_>,
+) -> bool {
+    if !policy.same_site_enforcement() {
+        return true;
+    }
+    if cookie.same_site() == Some(SameSite::None) && !cookie.secure().unwrap_or(false) {
+        return false;
+    }
+    match restriction_of(policy, cookie) {
+        Restriction::Unrestricted => true,
+        // Same-site, or a navigation of the top-level page (which may set a cookie for the site it is going to).
+        Restriction::Strict | Restriction::Lax => {
+            context.same_site || context.sites.top_level_navigation
+        },
+    }
+}
+
+/// The `Cookie` header text for a `GET` that the **browser** makes for a top-level page of its own, outside the
+/// engine's fetch (the `view-source:` page re-fetches the address it shows): a top-level navigation, first
+/// party by construction, with no initiator, exactly the context `RequestContext::of_request` builds for such a
+/// request. `earlier_hops` are the addresses the request has already been through (redirects): one of another
+/// site makes the request cross-site, as for the engine's own redirects, so `Strict` cookies stay home.
+/// Blocked cookies and every other rule of the policy apply as they do to a page load; the answer is `None`
+/// when there is nothing to send.
+pub fn cookies_for_browser_navigation(
+    policy: &NetPolicy,
+    cookie_jar: &mut CookieStorage,
+    url: &ServoUrl,
+    earlier_hops: &[ServoUrl],
+) -> Option<String> {
+    let site = site_key_of_url(url);
+    let context = RequestContext {
+        same_site: earlier_hops
+            .iter()
+            .all(|hop| site_key_of_url(hop) == site),
+        safe_method: true,
+        sites: RequestSites {
+            top_level: Some(site.clone()),
+            request: site,
+            initiator: None,
+            top_level_navigation: true,
+            party: Party::First,
+        },
+    };
+    if !policy.cookies_allowed(&context.sites) {
+        return None;
+    }
+    cookie_jar.remove_expired_cookies_for_url(url);
+    cookie_jar.cookies_for_request(url, CookieSource::HTTP, &|cookie| {
+        cookie_may_be_sent(policy, &context, cookie)
+    })
+}
+
+/// `document.cookie` read: the cookie string the document may see, or `None`. A third-party document (or one
+/// whose top-level site is unknown) sees nothing while third-party cookies are blocked.
+pub(crate) fn document_cookie_string(
+    state: &HttpState,
+    url: &ServoUrl,
+    partition_key: &Option<Site>,
+    source: CookieSource,
+) -> Option<String> {
+    let policy = &state.net_policy;
+    let context = RequestContext::of_document(policy, url, partition_key);
+    if !policy.cookies_allowed(&context.sites) {
+        return None;
+    }
+    let mut cookie_jar = state.cookie_jar.write();
+    cookie_jar.remove_expired_cookies_for_url(url);
+    cookie_jar.cookies_for_request(url, source, &|cookie| {
+        cookie_may_be_sent(policy, &context, cookie)
+    })
+}
+
+/// `document.cookie` write: the cookies the document may store. A third-party document's writes are dropped
+/// while third-party cookies are blocked.
+pub(crate) fn store_document_cookies(
+    state: &HttpState,
+    url: &ServoUrl,
+    partition_key: &Option<Site>,
+    cookies: Vec<Serde<Cookie<'static>>>,
+    source: CookieSource,
+) {
+    let policy = &state.net_policy;
+    let context = RequestContext::of_document(policy, url, partition_key);
+    if !policy.cookies_allowed(&context.sites) {
+        return;
+    }
+    let mut cookie_jar = state.cookie_jar.write();
+    for cookie in cookies {
+        let cookie = cookie.into_inner();
+        if !accept_set_cookie(policy, &context, &cookie) {
+            continue;
+        }
+        if let Some(cookie) = ServoCookie::new_wrapped(cookie, url, source) {
+            cookie_jar.push(cookie, url, source);
+        }
+    }
+}
+
+/// Whether the `cookieStore` messages (`*Async`) are answered as if no cookie existed. They carry no site
+/// context, so while third-party blocking is on the resource thread cannot tell a first party from a third
+/// (decisions D5 and D7). `cookieStore` is pinned off in Mercury, so this is the fail-closed half.
+pub(crate) fn async_cookie_messages_refused(state: &HttpState) -> bool {
+    state.net_policy.block_third_party_cookies()
+}
+
+/// For the WebSocket handshake (`websocket_loader.rs`): the `Cookie` header value to send, or `None`. The
+/// caller builds the context once, with [`RequestContext::of_builder`], and passes it to
+/// [`websocket_may_store_cookies`] and [`accept_set_cookie`] for the response.
+pub(crate) fn websocket_cookie_header(
+    state: &HttpState,
+    context: &RequestContext,
+    url: &ServoUrl,
+) -> Option<String> {
+    let policy = &state.net_policy;
+    if !policy.cookies_allowed(&context.sites) {
+        return None;
+    }
+    let mut cookie_jar = state.cookie_jar.write();
+    cookie_jar.remove_expired_cookies_for_url(url);
+    cookie_jar.cookies_for_request(url, CookieSource::HTTP, &|cookie| {
+        cookie_may_be_sent(policy, context, cookie)
+    })
+}
+
+/// For the WebSocket handshake response: whether the `Set-Cookie` headers that came with it may be looked at
+/// at all (third-party blocking). Each cookie must then pass [`accept_set_cookie`].
+pub(crate) fn websocket_may_store_cookies(state: &HttpState, context: &RequestContext) -> bool {
+    state.net_policy.cookies_allowed(&context.sites)
+}
diff --git a/mercury_log.rs b/mercury_log.rs
new file mode 100644
--- /dev/null
+++ b/mercury_log.rs
@@ -0,0 +1,598 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! Mercury: keeps cookie values and credentials out of the logs (EC13).
+//!
+//! Servo's HTTP loader logs every request and response header at `debug` level, and the cookie jar logged
+//! the cookie string it sent at `info` level. Both carry session cookies and credentials. The functions
+//! here replace the value of `Cookie`, `Set-Cookie`, `Authorization` and `Proxy-Authorization` with
+//! [`REDACTED`] and leave every other header as it was, so a debug log still shows what was sent.
+//!
+//! This is a Mercury file, not an upstream one. Drop it (with its two call sites in `http_loader.rs`, the
+//! two log lines in `cookie.rs` and `cookie_storage.rs`, and the `mod mercury_log;` line in `lib.rs`) at the
+//! Servo release that no longer logs these values.
+
+use http::header::{HeaderMap, HeaderName, HeaderValue};
+use servo_url::ServoUrl;
+
+/// What the value of a secret header is replaced with.
+pub(crate) const REDACTED: &str = "<redacted>";
+
+/// Headers whose value is a credential. Compared without regard to case.
+const SECRET_HEADERS: [&str; 4] = [
+    "cookie",
+    "set-cookie",
+    "authorization",
+    "proxy-authorization",
+];
+
+fn is_secret(name: &HeaderName) -> bool {
+    SECRET_HEADERS
+        .iter()
+        .any(|secret| name.as_str().eq_ignore_ascii_case(secret))
+}
+
+/// The value as the log shows it: quoted like `HeaderValue`'s own `Debug`, or [`REDACTED`] for a secret.
+fn value_for_log(name: &HeaderName, value: &HeaderValue) -> String {
+    if is_secret(name) {
+        format!("{REDACTED:?}")
+    } else {
+        format!("{value:?}")
+    }
+}
+
+/// One header as a log line shows it: `("name", "value")`, the same shape as `{:?}` of the pair that
+/// `HeaderMap::iter` yields, with the value of a secret header redacted.
+pub(crate) fn header_for_log(name: &HeaderName, value: &HeaderValue) -> String {
+    format!("({name:?}, {})", value_for_log(name, value))
+}
+
+/// A whole header map as a log line shows it: `{"name": "value", ...}`, the same shape as `{:?}` of a
+/// `HeaderMap`, with the values of secret headers redacted.
+pub(crate) fn headers_for_log(headers: &HeaderMap) -> String {
+    let entries: Vec<String> = headers
+        .iter()
+        .map(|(name, value)| format!("{name:?}: {}", value_for_log(name, value)))
+        .collect();
+    format!("{{{}}}", entries.join(", "))
+}
+
+/// A URL as a log line shows it: scheme, host, port and path, without the user name and password, the query
+/// string and the fragment (they carry session tokens and credentials). A URL that has no host and no path to
+/// speak of (`data:`, `blob:`, `javascript:`) shows only its scheme.
+pub(crate) fn url_for_log(url: &ServoUrl) -> String {
+    let url = url.as_url();
+    if url.cannot_be_a_base() {
+        return format!("{}:", url.scheme());
+    }
+    let mut shown = format!("{}://", url.scheme());
+    if let Some(host) = url.host_str() {
+        shown.push_str(host);
+    }
+    if let Some(port) = url.port() {
+        shown.push_str(&format!(":{port}"));
+    }
+    shown.push_str(url.path());
+    shown
+}
+
+/// What a message, or an action on a connection, is called, without its content: the names of the variants
+/// from the outside in (`Some(Ok(Text("secret")))` is `Some/Ok/Text`). Takes them from the `Debug` text: a name
+/// is an identifier directly followed by `(`; the content of a message is a string or a byte list, which never
+/// start that way.
+pub(crate) fn variant_for_log<T: std::fmt::Debug>(value: &T) -> String {
+    let text = format!("{value:?}");
+    let mut names: Vec<&str> = Vec::new();
+    let mut rest = text.as_str();
+    loop {
+        let end = rest
+            .find(|c: char| !(c.is_alphanumeric() || c == '_'))
+            .unwrap_or(rest.len());
+        let (name, after) = rest.split_at(end);
+        if !name.is_empty() {
+            names.push(name);
+        }
+        match after.strip_prefix('(') {
+            Some(inner) if !name.is_empty() => rest = inner,
+            _ => break,
+        }
+    }
+    if names.is_empty() {
+        "(unknown)".to_owned()
+    } else {
+        names.join("/")
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use http::header::{ACCEPT, AUTHORIZATION, COOKIE, PROXY_AUTHORIZATION, SET_COOKIE};
+
+    use super::*;
+
+    const SECRET: &str = "sessionid=s3cr3t-value-1234";
+
+    fn value(text: &str) -> HeaderValue {
+        HeaderValue::from_str(text).unwrap()
+    }
+
+    #[test]
+    fn the_value_of_each_secret_header_is_redacted() {
+        for name in [COOKIE, SET_COOKIE, AUTHORIZATION, PROXY_AUTHORIZATION] {
+            let line = header_for_log(&name, &value(SECRET));
+            assert!(!line.contains("s3cr3t"), "{name}: {line}");
+            assert!(line.contains(REDACTED), "{name}: {line}");
+            // The name stays, so the log still says which header was sent.
+            assert!(line.contains(name.as_str()), "{name}: {line}");
+        }
+    }
+
+    #[test]
+    fn the_names_are_matched_without_regard_to_case() {
+        for spelled in [
+            "Cookie",
+            "COOKIE",
+            "cOoKiE",
+            "Set-Cookie",
+            "AUTHORIZATION",
+            "Proxy-Authorization",
+        ] {
+            let name = HeaderName::from_bytes(spelled.as_bytes()).unwrap();
+            let line = header_for_log(&name, &value(SECRET));
+            assert!(!line.contains("s3cr3t"), "{spelled}: {line}");
+            assert!(line.contains(REDACTED), "{spelled}: {line}");
+        }
+    }
+
+    #[test]
+    fn other_headers_are_printed_as_before() {
+        let accept = value("text/html,application/xhtml+xml");
+        // The shape of the old `debug!(" - {:?}", header)`: a `(name, value)` pair.
+        assert_eq!(
+            header_for_log(&ACCEPT, &accept),
+            format!("{:?}", (&ACCEPT, &accept))
+        );
+        assert_eq!(
+            header_for_log(&ACCEPT, &accept),
+            r#"("accept", "text/html,application/xhtml+xml")"#
+        );
+    }
+
+    #[test]
+    fn an_empty_secret_value_is_redacted_too() {
+        // Not telling a log reader whether the credential was empty costs nothing.
+        let line = header_for_log(&AUTHORIZATION, &value(""));
+        assert_eq!(line, format!("(\"authorization\", {REDACTED:?})"));
+    }
+
+    #[test]
+    fn a_header_map_keeps_every_entry_and_hides_the_secrets() {
+        let mut headers = HeaderMap::new();
+        headers.insert(ACCEPT, value("*/*"));
+        headers.insert(COOKIE, value(SECRET));
+        headers.insert(AUTHORIZATION, value("Bearer t0ken-abcdef"));
+        headers.append(SET_COOKIE, value("a=first-secret; Path=/"));
+        headers.append(SET_COOKIE, value("b=second-secret; Secure"));
+
+        let line = headers_for_log(&headers);
+        for leaked in ["s3cr3t", "t0ken", "first-secret", "second-secret"] {
+            assert!(!line.contains(leaked), "{leaked} leaked: {line}");
+        }
+        assert!(line.starts_with('{') && line.ends_with('}'), "{line}");
+        assert!(line.contains(r#""accept": "*/*""#), "{line}");
+        // Two Set-Cookie headers are two entries, as in `HeaderMap::iter`.
+        assert_eq!(
+            line.matches(r#""set-cookie": "<redacted>""#).count(),
+            2,
+            "{line}"
+        );
+        assert!(line.contains(r#""cookie": "<redacted>""#), "{line}");
+        assert!(line.contains(r#""authorization": "<redacted>""#), "{line}");
+    }
+
+    #[test]
+    fn an_empty_header_map_prints_empty_braces() {
+        assert_eq!(headers_for_log(&HeaderMap::new()), "{}");
+    }
+
+    // ---- The guard: nobody may log a cookie value again --------------------------------------------
+
+    /// Every logging macro call in `source`, as the text between its parentheses.
+    fn log_macro_calls(source: &str) -> Vec<&str> {
+        const MACROS: [&str; 8] = [
+            "info", "debug", "trace", "warn", "error", "println", "eprintln", "dbg",
+        ];
+        let bytes = source.as_bytes();
+        let is_ident = |b: u8| b.is_ascii_alphanumeric() || b == b'_';
+        let mut calls = Vec::new();
+        for name in MACROS {
+            let needle = format!("{name}!(");
+            let mut from = 0;
+            while let Some(found) = source[from..].find(&needle) {
+                let start = from + found;
+                from = start + needle.len();
+                if start > 0 && is_ident(bytes[start - 1]) {
+                    continue; // `some_info!(`, not the log macro
+                }
+                if let Some(end) = matching_paren(source, from) {
+                    calls.push(&source[from..end]);
+                }
+            }
+        }
+        calls
+    }
+
+    /// The index of the `)` that closes a `(` opened just before `from`, skipping string and char literals.
+    fn matching_paren(source: &str, from: usize) -> Option<usize> {
+        let bytes = source.as_bytes();
+        let mut depth = 1usize;
+        let mut i = from;
+        while i < bytes.len() {
+            match bytes[i] {
+                b'"' => i = end_of_string(bytes, i)?,
+                b'\'' => i += char_literal_len(bytes, i) - 1,
+                b'(' | b'[' | b'{' => depth += 1,
+                b')' | b']' | b'}' => {
+                    depth -= 1;
+                    if depth == 0 {
+                        return Some(i);
+                    }
+                },
+                _ => {},
+            }
+            i += 1;
+        }
+        None
+    }
+
+    /// The index of the closing quote of the string literal that opens at `open`.
+    fn end_of_string(bytes: &[u8], open: usize) -> Option<usize> {
+        let mut i = open + 1;
+        while i < bytes.len() {
+            match bytes[i] {
+                b'\\' => i += 1,
+                b'"' => return Some(i),
+                _ => {},
+            }
+            i += 1;
+        }
+        None
+    }
+
+    /// How many bytes a `'` at `at` takes: a char literal (`'x'`, `'\n'`), or 1 for a lifetime.
+    fn char_literal_len(bytes: &[u8], at: usize) -> usize {
+        match (bytes.get(at + 1), bytes.get(at + 2), bytes.get(at + 3)) {
+            (Some(b'\\'), _, Some(b'\'')) => 4,
+            (Some(_), Some(b'\''), _) => 3,
+            _ => 1,
+        }
+    }
+
+    /// The comma-separated arguments of a macro call, trimmed; commas inside brackets and literals do not split.
+    fn arguments(call: &str) -> Vec<&str> {
+        let bytes = call.as_bytes();
+        let mut parts = Vec::new();
+        let (mut depth, mut start, mut i) = (0usize, 0usize, 0usize);
+        while i < bytes.len() {
+            match bytes[i] {
+                b'"' => match end_of_string(bytes, i) {
+                    Some(end) => i = end,
+                    None => break,
+                },
+                b'\'' => i += char_literal_len(bytes, i) - 1,
+                b'(' | b'[' | b'{' => depth += 1,
+                b')' | b']' | b'}' => depth = depth.saturating_sub(1),
+                b',' if depth == 0 => {
+                    parts.push(call[start..i].trim());
+                    start = i + 1;
+                },
+                _ => {},
+            }
+            i += 1;
+        }
+        parts.push(call[start..].trim());
+        parts.retain(|part| !part.is_empty());
+        parts
+    }
+
+    /// Names captured inline by a format string, such as `{value}` or `{value:?}`.
+    fn inline_captures(literal: &str) -> Vec<String> {
+        let mut names = Vec::new();
+        let mut chars = literal.char_indices().peekable();
+        while let Some((i, c)) = chars.next() {
+            if c != '{' {
+                continue;
+            }
+            if chars.peek().map(|&(_, next)| next) == Some('{') {
+                chars.next(); // `{{` is a literal brace
+                continue;
+            }
+            let name: String = literal[i + 1..]
+                .chars()
+                .take_while(|ch| ch.is_alphanumeric() || *ch == '_')
+                .collect();
+            if !name.is_empty() {
+                names.push(name);
+            }
+        }
+        names
+    }
+
+    /// Problems with the logging calls in a cookie file: every argument must be one of `allowed`, and no
+    /// format string may capture a variable by name (that would hide a value from this check).
+    fn cookie_log_problems(file: &str, source: &str, allowed: &[&str]) -> Vec<String> {
+        let mut problems = Vec::new();
+        for call in log_macro_calls(source) {
+            let args = arguments(call);
+            let Some((literal, rest)) = args.split_first() else {
+                continue;
+            };
+            for name in inline_captures(literal) {
+                problems.push(format!(
+                    "{file}: `{{{name}}}` in `{literal}` captures a variable"
+                ));
+            }
+            for arg in rest {
+                if !allowed.contains(arg) {
+                    problems.push(format!("{file}: logs `{arg}` in `{literal}`"));
+                }
+            }
+        }
+        problems
+    }
+
+    /// Problems with the logging calls in `http_loader.rs`: a header or a header map may only be logged
+    /// through `header_for_log` or `headers_for_log`.
+    fn header_log_problems(file: &str, source: &str) -> Vec<String> {
+        let mut problems = Vec::new();
+        for call in log_macro_calls(source) {
+            let args = arguments(call);
+            let Some((literal, rest)) = args.split_first() else {
+                continue;
+            };
+            for name in inline_captures(literal) {
+                if name == "header" || name == "headers" {
+                    problems.push(format!(
+                        "{file}: `{{{name}}}` in `{literal}` captures headers"
+                    ));
+                }
+            }
+            for arg in rest {
+                let mentions_headers = arg
+                    .split(|c: char| !(c.is_alphanumeric() || c == '_'))
+                    .any(|word| word == "header" || word == "headers");
+                let redacted =
+                    arg.starts_with("header_for_log(") || arg.starts_with("headers_for_log(");
+                if mentions_headers && !redacted {
+                    problems.push(format!(
+                        "{file}: logs `{arg}` in `{literal}` without redacting"
+                    ));
+                }
+            }
+        }
+        problems
+    }
+
+    /// The only things the cookie jar may log: a cookie's name, domain and path, and how many were sent.
+    const ALLOWED_COOKIE_LOG_ARGS: [&str; 4] = [
+        "self.cookie.name()",
+        "self.cookie.domain()",
+        "self.cookie.path()",
+        "sent_count",
+    ];
+
+    #[test]
+    fn the_cookie_files_do_not_log_a_cookie_value() {
+        for (file, source) in [
+            ("cookie_storage.rs", include_str!("cookie_storage.rs")),
+            ("cookie.rs", include_str!("cookie.rs")),
+        ] {
+            assert!(
+                !log_macro_calls(source).is_empty(),
+                "{file}: the guard found no logging call; it is looking at the wrong text"
+            );
+            let problems = cookie_log_problems(file, source, &ALLOWED_COOKIE_LOG_ARGS);
+            assert!(
+                problems.is_empty(),
+                "a cookie value or the cookie string would reach the log (EC13); if a new log line is \
+                 safe, add its arguments to ALLOWED_COOKIE_LOG_ARGS:\n{}",
+                problems.join("\n")
+            );
+        }
+    }
+
+    #[test]
+    fn the_http_loader_logs_headers_only_through_the_redacting_helpers() {
+        let source = include_str!("http_loader.rs");
+        let problems = header_log_problems("http_loader.rs", source);
+        assert!(
+            problems.is_empty(),
+            "a header value would reach the log unredacted (EC13):\n{}",
+            problems.join("\n")
+        );
+        // The guard is alive: the two header dumps and the CORS line really use the helpers.
+        assert!(
+            source.matches("header_for_log(").count() >= 2,
+            "the two header-dump loops no longer use header_for_log"
+        );
+        assert!(
+            source.contains("headers_for_log("),
+            "the CORS debug line no longer uses headers_for_log"
+        );
+    }
+
+    // ---- URLs and message bodies -----------------------------------------------------------------------
+
+    fn shown(url: &str) -> String {
+        url_for_log(&ServoUrl::parse(url).unwrap())
+    }
+
+    #[test]
+    fn a_url_is_shown_without_credentials_query_and_fragment() {
+        assert_eq!(
+            shown("https://user:pass@example.com:8443/a/b.html?token=s3cr3t&x=1#frag"),
+            "https://example.com:8443/a/b.html"
+        );
+        assert_eq!(shown("http://example.com"), "http://example.com/");
+        assert_eq!(
+            shown("wss://example.com/socket?ticket=s3cr3t"),
+            "wss://example.com/socket"
+        );
+        assert_eq!(shown("http://[::1]:3000/x?q=1"), "http://[::1]:3000/x");
+    }
+
+    #[test]
+    fn a_url_that_carries_its_content_shows_only_its_scheme() {
+        assert_eq!(shown("data:text/plain;base64,c2VjcmV0"), "data:");
+        assert_eq!(shown("blob:https://example.com/0d9f"), "blob:");
+        assert_eq!(shown("javascript:alert('s3cr3t')"), "javascript:");
+    }
+
+    #[test]
+    fn a_message_is_shown_by_its_variant_not_its_content() {
+        #[derive(Debug)]
+        #[allow(dead_code)]
+        enum Frame {
+            Text(String),
+            Binary(Vec<u8>),
+            Close { reason: String },
+            Ping,
+        }
+        let frames = [
+            (
+                Some(Ok::<_, ()>(Frame::Text("s3cr3t".into()))),
+                "Some/Ok/Text",
+            ),
+            (Some(Ok(Frame::Binary(vec![115, 51]))), "Some/Ok/Binary"),
+            (
+                Some(Ok(Frame::Close {
+                    reason: "s3cr3t".into(),
+                })),
+                "Some/Ok/Close",
+            ),
+            (Some(Ok(Frame::Ping)), "Some/Ok/Ping"),
+            (None, "None"),
+        ];
+        for (frame, expected) in frames {
+            let line = variant_for_log(&frame);
+            assert!(!line.contains("s3cr3t") && !line.contains("115"), "{line}");
+            assert_eq!(line, expected);
+        }
+        assert_eq!(variant_for_log(&"s3cr3t"), "(unknown)");
+    }
+
+    /// Problems with the logging calls in a network file: a URL may only be logged through `url_for_log`,
+    /// and a WebSocket message or action only through `variant_for_log`.
+    fn url_log_problems(file: &str, source: &str) -> Vec<String> {
+        const URLS: [&str; 6] = ["url", "url1", "url2", "resource_url", "current_url", "uri"];
+        const MESSAGES: [&str; 3] = ["dom_action", "dom_msg", "ws_msg"];
+        let mut problems = Vec::new();
+        for call in log_macro_calls(source) {
+            let args = arguments(call);
+            let Some((literal, rest)) = args.split_first() else {
+                continue;
+            };
+            for name in inline_captures(literal) {
+                if URLS.contains(&name.as_str()) || MESSAGES.contains(&name.as_str()) {
+                    problems.push(format!(
+                        "{file}: `{{{name}}}` in `{literal}` captures a URL or message"
+                    ));
+                }
+            }
+            for arg in rest {
+                let mentions = |names: &[&str]| {
+                    arg.split(|c: char| !(c.is_alphanumeric() || c == '_'))
+                        .any(|word| names.contains(&word))
+                };
+                let wrapped =
+                    arg.starts_with("url_for_log(") || arg.starts_with("variant_for_log(");
+                if (mentions(&URLS) || mentions(&MESSAGES)) && !wrapped {
+                    problems.push(format!("{file}: logs `{arg}` in `{literal}` unredacted"));
+                }
+            }
+        }
+        problems
+    }
+
+    #[test]
+    fn the_http_and_websocket_loaders_log_urls_and_messages_only_through_the_helpers() {
+        for (file, source) in [
+            ("http_loader.rs", include_str!("http_loader.rs")),
+            ("websocket_loader.rs", include_str!("websocket_loader.rs")),
+        ] {
+            let problems = url_log_problems(file, source);
+            assert!(
+                problems.is_empty(),
+                "a query string, credentials or a message body would reach the log (EC13):\n{}",
+                problems.join("\n")
+            );
+            assert!(
+                source.contains("url_for_log("),
+                "{file} no longer uses url_for_log"
+            );
+        }
+        assert!(include_str!("websocket_loader.rs").contains("variant_for_log("));
+    }
+
+    #[test]
+    fn the_url_guard_finds_the_lines_servo_used_to_have() {
+        let old = [
+            r#"info!("{:?} request for {}", request.method, url);"#,
+            r#"debug!("finished response for {:?}", url2);"#,
+            r#"trace!("starting WS connection to {}", client.url());"#,
+            r#"trace!("processing websocket http response for {}", resource_url);"#,
+            r#"trace!("processing WS stream: {:?}", ws_msg);"#,
+            r#"trace!("handling WS DOM action: {:?}", dom_action);"#,
+            r#"info!("request for {url}");"#,
+        ];
+        for line in old {
+            assert_eq!(url_log_problems("old", line).len(), 1, "{line}");
+        }
+        let new = r#"info!("request for {}", url_for_log(&url)); trace!("{}", variant_for_log(&ws_msg));"#;
+        assert!(url_log_problems("new", new).is_empty());
+    }
+
+    #[test]
+    fn the_guard_finds_the_lines_servo_used_to_have() {
+        // The upstream 0.8 lines, verbatim. If the guard did not flag these it would guard nothing.
+        let old_storage = r#"info!(" === COOKIES SENT: {}", result);"#;
+        let old_cookie = r#"debug!(
+            " === SENT COOKIE : {} {} {:?} {:?}",
+            self.cookie.name(),
+            self.cookie.value(),
+            self.cookie.domain(),
+            self.cookie.path()
+        );"#;
+        let captured = r#"info!("sent {result}");"#;
+        let problems = cookie_log_problems("old", old_storage, &ALLOWED_COOKIE_LOG_ARGS);
+        assert_eq!(problems.len(), 1, "{problems:?}");
+        let problems = cookie_log_problems("old", old_cookie, &ALLOWED_COOKIE_LOG_ARGS);
+        assert_eq!(problems.len(), 1, "{problems:?}");
+        assert!(problems[0].contains("self.cookie.value()"), "{problems:?}");
+        let problems = cookie_log_problems("old", captured, &ALLOWED_COOKIE_LOG_ARGS);
+        assert_eq!(problems.len(), 1, "{problems:?}");
+
+        let old_dump = r#"for header in request.headers.iter() { debug!(" - {:?}", header); }"#;
+        let old_cors =
+            r#"debug!("CORS check: {:?}, current headers: {:?}", header_names, request.headers);"#;
+        assert_eq!(header_log_problems("old", old_dump).len(), 1);
+        assert_eq!(header_log_problems("old", old_cors).len(), 1);
+        let redacted = r#"debug!(" - {}", header_for_log(name, value)); debug!("{}", headers_for_log(&request.headers));"#;
+        assert!(header_log_problems("new", redacted).is_empty());
+    }
+
+    #[test]
+    fn the_guard_reads_literals_and_nesting_correctly() {
+        let source = r#"
+            // not a call: some_info!(self.cookie.value())
+            debug!("a, b ( ) {}", f(x, y), 'c');
+            warn!("quote \" and paren ) in text, {}", self.cookie.name());
+        "#;
+        let calls = log_macro_calls(source);
+        assert_eq!(calls.len(), 2, "{calls:?}");
+        let args = arguments(calls.iter().find(|c| c.starts_with("\"a, b")).unwrap());
+        assert_eq!(args, [r#""a, b ( ) {}""#, "f(x, y)", "'c'"]);
+        assert_eq!(inline_captures("{{x}} {} {:?} {y} {z:?}"), ["y", "z"]);
+    }
+}
diff --git a/mercury_mixed_content.rs b/mercury_mixed_content.rs
new file mode 100644
--- /dev/null
+++ b/mercury_mixed_content.rs
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
+// SPDX-FileCopyrightText: 2026 Mrinal Joshi and the Mercury Browser contributors
+// Mercury: the per-site allow of mixed content and the report of a block to the embedder (EC17). This is
+// a new Mercury file; the source is the Mixed Content specification and Mercury's own design, and nothing
+// in it is copied from Servo or another project. The hooks are the two calls in `fetch/methods.rs`;
+// `MERCURY.md` lists them.
+
+//! Mixed content: the user's allow, and the report of a block.
+//!
+//! Servo 0.8 blocks mixed content by the algorithms of <https://w3c.github.io/webappsec-mixed-content/>
+//! (`should_request_be_blocked_as_mixed_content` and `should_response_be_blocked_as_mixed_content` in
+//! `fetch/methods.rs`) but leaves out step 1.3, "the user agent has been instructed to allow mixed
+//! content", and tells nobody when it blocks. This file adds both, without changing those two functions:
+//!
+//! * [`request_is_blocked`] and [`response_is_blocked`] take the specification's answer. When it says
+//!   "block", they ask `NetPolicy::mixed_content_allowed` about the page's site (the top level site
+//!   that `NetPolicy::sites_of_request` finds; a request whose top-level site is not known is not
+//!   allowed, so the answer fails closed). An allowed request goes on and nothing is reported.
+//! * When the request is blocked, [`report_blocked`] sends `NetToEmbedderMsg::Mercury(web view,
+//!   NetMsg::MixedContentBlocked { url, destination })`, so Mercury can count the blocks of a tab and one
+//!   day offer "load unsafe content" in the page's site settings.
+//!
+//! Exactly one message is sent for each blocked request. The two checks cannot both fire for one fetch:
+//! the response check only runs for a response that is not already a network error, and a request that was
+//! blocked has one.
+//!
+//! Known gap, by decision: step 6 of main fetch still upgrades a passive request (image, audio, video) to
+//! `https` before the check, also on a site where mixed content is allowed, so an allowed site loads such a
+//! resource over `https` when the host answers there. The allow lifts the block, not the upgrade.
+//!
+//! Drop with the two hooks in `fetch/methods.rs` if Servo implements step 1.3 and a report.
+
+use embedder_traits::{MercuryEmbedderMsg, NetMsg};
+use net_traits::request::Request;
+
+use crate::embedder::NetToEmbedderMsg;
+use crate::fetch::methods::FetchContext;
+
+/// Whether `request` is blocked as mixed content, given the specification's answer `blocked_by_spec` for
+/// the request (`should_request_be_blocked_as_mixed_content`). A block is reported to the embedder.
+pub(crate) fn request_is_blocked(
+    context: &FetchContext,
+    request: &Request,
+    blocked_by_spec: bool,
+) -> bool {
+    blocked(context, request, blocked_by_spec)
+}
+
+/// Whether the response to `request` is blocked as mixed content, given the specification's answer
+/// `blocked_by_spec` for the response (`should_response_be_blocked_as_mixed_content`). A block is reported
+/// to the embedder.
+pub(crate) fn response_is_blocked(
+    context: &FetchContext,
+    request: &Request,
+    blocked_by_spec: bool,
+) -> bool {
+    blocked(context, request, blocked_by_spec)
+}
+
+fn blocked(context: &FetchContext, request: &Request, blocked_by_spec: bool) -> bool {
+    if !blocked_by_spec {
+        return false;
+    }
+    let policy = &context.state.net_policy;
+    // Step 1.3: the user agent has been instructed to allow mixed content (for this page's site).
+    if policy.mixed_content_allowed(&policy.sites_of_request(request)) {
+        return false;
+    }
+    report_blocked(context, request);
+    true
+}
+
+/// Tell the embedder that `request` was blocked as mixed content: one message, naming the web view the
+/// request belongs to (none for a request that has no web view, which then reaches the whole `Servo`
+/// instance's delegate). The URL is the request's current URL, also when the block came from the response.
+pub(crate) fn report_blocked(context: &FetchContext, request: &Request) {
+    context.state.embedder_proxy.send(NetToEmbedderMsg::Mercury(
+        request.target_webview_id,
+        MercuryEmbedderMsg::Net(NetMsg::MixedContentBlocked {
+            url: request.current_url(),
+            destination: request.destination,
+        }),
+    ));
+}
diff --git a/mercury_rewrite.rs b/mercury_rewrite.rs
new file mode 100644
--- /dev/null
+++ b/mercury_rewrite.rs
@@ -0,0 +1,876 @@
+// SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
+// SPDX-FileCopyrightText: 2026 Mrinal Joshi and the Mercury Browser contributors
+// Mercury: what the request interceptor tells the embedder about a request (frame identity, EC38 and
+// decision D17) and what the embedder may answer to change it (a rewrite, EC37 and decision D9). This is
+// a new Mercury file; the sources are the Fetch and HTML specifications and Mercury's own design, and
+// nothing in it is copied from Servo or another project. The hooks are in `request_interceptor.rs` and
+// `fetch/methods.rs`; `MERCURY.md` lists them.
+
+//! The two Mercury halves of the request interceptor.
+//!
+//! **What the embedder is told** ([`FrameIdentity`]). Servo 0.8 reports a request to the embedder with a
+//! method, headers, URL, destination, referrer and a flag `is_for_main_frame` that is `destination ==
+//! Document`. A frame that a script or a link navigates is fetched with the destination `Document` too, so
+//! the flag was true for every ad frame an ad script navigated. Mercury's flag is true only for a
+//! navigation of the top-level frame (a destination of `Document` and a client that is not a nested
+//! browsing context; with no client the old test stays). The request also gets its frame identity: the
+//! site of the top-level document, the origin that started it and whether it is third party, all from
+//! [`NetPolicy::sites_of_request`], so the embedder no longer infers third party from the `Referer`.
+//!
+//! **What the embedder may answer** ([`apply`]). `WebResourceResponseMsg::Rewrite` changes the request's
+//! URL and headers and lets it go on; it is terminal, so the embedder is asked once per hop. The network
+//! thread applies a rewrite whole or not at all, and refuses it when any part breaks a rule:
+//!
+//! * only `http` and `https` requests, and never a WebSocket;
+//! * the scheme stays (HSTS may upgrade the new URL afterwards: `fetch/methods.rs` applies it again);
+//! * the origin stays, unless the request is a `GET` navigation of the top-level frame without a body: a
+//!   frame's navigation was checked against the parent's `frame-src` for the old URL, and a body would go
+//!   to the new origin (when the origin does change, the referrer is worked out again for the new URL);
+//! * the user name and password in the URL stay;
+//! * the URL may not grow past 8 KiB (a longer URL may only shrink or stay);
+//! * header changes: at most 16 sets and 16 removals; names of at most 128 bytes, values of at most 4 KiB
+//!   of visible ASCII; none of the names the Fetch standard forbids a page to set (`Cookie`, `Origin`,
+//!   `Referer`, `Host`, `Content-Length`, `Transfer-Encoding`, `Connection`, `Upgrade`, `Accept-Encoding`,
+//!   `Via` and the rest), `Authorization`, and any name that starts with `Sec-` or `Proxy-`. Removing one of
+//!   them is refused too.
+//!
+//! A refusal is logged once at `warn` with its reason and no URL, header name or value, and the request
+//! goes on as it was. Mercury's first user of the hook is the content blocker's `$removeparam` (D10).
+//!
+//! Drop with the hooks (the two in `request_interceptor.rs`, the three in `fetch/methods.rs`, the variant in
+//! `servo-embedder-traits` and the `mod` line in `lib.rs`) if Servo grows an equivalent request-rewrite
+//! point.
+
+use std::fmt;
+
+use embedder_traits::WebResourceRewrite;
+use http::Method;
+use http::header::{HeaderName, HeaderValue};
+use log::warn;
+use net_traits::request::{Origin, Referrer, Request, RequestMode};
+use servo_url::ServoUrl;
+
+use crate::http_loader::determine_requests_referrer;
+use crate::net_policy::{NetPolicy, Party, RequestParts};
+
+/// A rewritten URL may be this long even if the original was shorter; a longer original may only shrink.
+const MAX_URL_BYTES: usize = 8 * 1024;
+/// At most this many headers set and, separately, removed by one rewrite.
+const MAX_HEADER_CHANGES: usize = 16;
+const MAX_HEADER_NAME_BYTES: usize = 128;
+const MAX_HEADER_VALUE_BYTES: usize = 4 * 1024;
+
+/// Request header names a rewrite may neither set nor remove, in lower case: the Fetch standard's forbidden
+/// request-header names (<https://fetch.spec.whatwg.org/#forbidden-request-header>) and `Authorization`.
+/// The `Sec-` and `Proxy-` prefixes are checked separately.
+const FORBIDDEN_HEADERS: [&str; 22] = [
+    "accept-charset",
+    "accept-encoding",
+    "access-control-request-headers",
+    "access-control-request-method",
+    "authorization",
+    "connection",
+    "content-length",
+    "cookie",
+    "cookie2",
+    "date",
+    "dnt",
+    "expect",
+    "host",
+    "keep-alive",
+    "origin",
+    "referer",
+    "set-cookie",
+    "te",
+    "trailer",
+    "transfer-encoding",
+    "upgrade",
+    "via",
+];
+
+/// Whether the request is a navigation of the top-level frame (D17): the destination is `Document` and the
+/// client is not a nested browsing context. A request without a client keeps the old test, the destination
+/// alone. A frame navigated by a script or a link has the destination `Document` as well, but its client
+/// is nested.
+pub(crate) fn is_top_level_document(request: &Request) -> bool {
+    // One definition, shared with the network policy's "top-level navigation" (net-1 review, minor 8).
+    RequestParts::of_request(request).is_top_level_document()
+}
+
+/// The ASCII serialisation of the origin that started the request: the request's origin, or the client's
+/// when the request's is still "client". `None` for an opaque origin (a typed address, a sandbox, `data:`).
+fn initiator_origin(request: &Request) -> Option<String> {
+    let origin = match &request.origin {
+        Origin::Origin(origin) => origin,
+        Origin::Client => match &request.client.as_ref()?.origin {
+            Origin::Origin(origin) => origin,
+            Origin::Client => return None,
+        },
+    };
+    origin
+        .is_tuple()
+        .then(|| origin.ascii_serialization().into_owned())
+}
+
+/// What the embedder is told about a request besides its URL, headers and destination (EC38, D17).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct FrameIdentity {
+    pub is_for_main_frame: bool,
+    pub top_level_site: Option<String>,
+    pub initiator_origin: Option<String>,
+    pub is_third_party: Option<bool>,
+}
+
+impl FrameIdentity {
+    /// The identity of `request`, judged by `policy` (decision D3 in the net-1 brief: the document's own
+    /// partition key, a top-level navigation, the policy's record of the web view, otherwise unknown).
+    /// `is_third_party` is `None` when the top-level site is not known, so the embedder can tell "not third
+    /// party" from "cannot tell".
+    pub(crate) fn of(request: &Request, policy: &NetPolicy) -> FrameIdentity {
+        let sites = policy.sites_of_request(request);
+        let top_level_site = sites.top_level.filter(|site| !site.is_empty());
+        let is_third_party = match (&top_level_site, sites.party) {
+            (Some(_), Party::First) => Some(false),
+            (Some(_), Party::Third) => Some(true),
+            (_, _) => None,
+        };
+        FrameIdentity {
+            is_for_main_frame: is_top_level_document(request),
+            top_level_site,
+            initiator_origin: initiator_origin(request),
+            is_third_party,
+        }
+    }
+}
+
+/// What a rewrite that was applied did.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) struct Applied {
+    /// The request's current URL is now another URL.
+    pub url_changed: bool,
+    /// The new URL has another origin (only a top-level navigation may do that), so the referrer was
+    /// worked out again.
+    pub origin_changed: bool,
+    /// Headers set.
+    pub headers_set: usize,
+    /// Headers that were present and are removed.
+    pub headers_removed: usize,
+}
+
+/// Why a rewrite was refused. The text names the rule, never a URL, a header name or a value.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum RewriteRefusal {
+    /// The request, or the new URL, is not `http` or `https`, or the request is a WebSocket.
+    NotHttp,
+    SchemeChanged,
+    /// The origin changed on a request that is not a `GET` navigation of the top-level frame.
+    OriginChanged,
+    CredentialsChanged,
+    UrlTooLong,
+    TooManyHeaders,
+    /// A header name or value that is not valid, or is too long.
+    InvalidHeader,
+    /// A header the rewrite may not set or remove.
+    ForbiddenHeader,
+}
+
+impl fmt::Display for RewriteRefusal {
+    fn fmt(&self, formatter: &mut fmt::Formatter) -> fmt::Result {
+        formatter.write_str(match self {
+            Self::NotHttp => {
+                "only an http or https request that is not a WebSocket can be rewritten"
+            },
+            Self::SchemeChanged => "a rewrite may not change the scheme",
+            Self::OriginChanged => {
+                "only a GET navigation of the top-level frame may change the origin"
+            },
+            Self::CredentialsChanged => "a rewrite may not change the user name or password",
+            Self::UrlTooLong => "the new URL is too long",
+            Self::TooManyHeaders => "too many header changes",
+            Self::InvalidHeader => "a header name or value is not valid or is too long",
+            Self::ForbiddenHeader => "a rewrite may not set or remove that kind of header",
+        })
+    }
+}
+
+/// A rewrite that passed every rule and can be committed without failing.
+struct Plan {
+    url: Option<ServoUrl>,
+    origin_changed: bool,
+    remove: Vec<HeaderName>,
+    set: Vec<(HeaderName, HeaderValue)>,
+}
+
+/// Apply `rewrite` to `request`, whole or not at all (see the module documentation for the rules). A
+/// refusal is logged at `warn` (the reason only) and leaves the request as it was. `policy` supplies the
+/// referrer cap when the origin changed and the referrer is worked out again.
+pub(crate) fn apply(
+    request: &mut Request,
+    rewrite: WebResourceRewrite,
+    policy: &NetPolicy,
+) -> Result<Applied, RewriteRefusal> {
+    match plan(request, &rewrite) {
+        Ok(plan) => Ok(commit(request, plan, policy)),
+        Err(refusal) => {
+            warn!("Mercury: refused a request rewrite: {refusal}");
+            Err(refusal)
+        },
+    }
+}
+
+fn plan(request: &Request, rewrite: &WebResourceRewrite) -> Result<Plan, RewriteRefusal> {
+    if rewrite.set_headers.len() > MAX_HEADER_CHANGES ||
+        rewrite.remove_headers.len() > MAX_HEADER_CHANGES
+    {
+        return Err(RewriteRefusal::TooManyHeaders);
+    }
+    let mut remove = Vec::with_capacity(rewrite.remove_headers.len());
+    for name in &rewrite.remove_headers {
+        remove.push(header_name(name)?);
+    }
+    let mut set = Vec::with_capacity(rewrite.set_headers.len());
+    for (name, value) in &rewrite.set_headers {
+        set.push((header_name(name)?, header_value(value)?));
+    }
+
+    let (url, origin_changed) = match &rewrite.url {
+        Some(new) => {
+            let origin_changed = check_url(request, new)?;
+            // Nothing to commit for the URL when it is the one the request has.
+            (
+                (*new != request.current_url()).then(|| new.clone()),
+                origin_changed,
+            )
+        },
+        None => (None, false),
+    };
+    Ok(Plan {
+        url,
+        origin_changed,
+        remove,
+        set,
+    })
+}
+
+fn header_name(name: &str) -> Result<HeaderName, RewriteRefusal> {
+    if name.len() > MAX_HEADER_NAME_BYTES {
+        return Err(RewriteRefusal::InvalidHeader);
+    }
+    let name =
+        HeaderName::from_bytes(name.as_bytes()).map_err(|_| RewriteRefusal::InvalidHeader)?;
+    // `HeaderName` is lower case, so one comparison covers every spelling.
+    let lower = name.as_str();
+    if lower.starts_with("sec-") ||
+        lower.starts_with("proxy-") ||
+        FORBIDDEN_HEADERS.contains(&lower)
+    {
+        return Err(RewriteRefusal::ForbiddenHeader);
+    }
+    Ok(name)
+}
+
+fn header_value(value: &str) -> Result<HeaderValue, RewriteRefusal> {
+    if value.len() > MAX_HEADER_VALUE_BYTES || !value.is_ascii() {
+        return Err(RewriteRefusal::InvalidHeader);
+    }
+    // ASCII only (`from_str` alone would let UTF-8 bytes through); it also refuses a line break and
+    // any control character other than a tab.
+    HeaderValue::from_str(value).map_err(|_| RewriteRefusal::InvalidHeader)
+}
+
+/// The rules for the new URL; `Ok` says whether its origin differs from the request's current URL's.
+fn check_url(request: &Request, new: &ServoUrl) -> Result<bool, RewriteRefusal> {
+    if matches!(request.mode, RequestMode::WebSocket { .. }) {
+        return Err(RewriteRefusal::NotHttp);
+    }
+    let old = request.current_url();
+    if !matches!(old.scheme(), "http" | "https") {
+        return Err(RewriteRefusal::NotHttp);
+    }
+    if new.scheme() != old.scheme() {
+        return Err(RewriteRefusal::SchemeChanged);
+    }
+    if new.username() != old.username() || new.password() != old.password() {
+        return Err(RewriteRefusal::CredentialsChanged);
+    }
+    if new.as_str().len() > MAX_URL_BYTES.max(old.as_str().len()) {
+        return Err(RewriteRefusal::UrlTooLong);
+    }
+    let origin_changed = new.origin() != old.origin();
+    if origin_changed &&
+        !(request.mode == RequestMode::Navigate &&
+            is_top_level_document(request) &&
+            request.method == Method::GET &&
+            request.body.is_none())
+    {
+        return Err(RewriteRefusal::OriginChanged);
+    }
+    Ok(origin_changed)
+}
+
+fn commit(request: &mut Request, plan: Plan, policy: &NetPolicy) -> Applied {
+    let mut applied = Applied {
+        origin_changed: plan.origin_changed,
+        ..Applied::default()
+    };
+    if let Some(url) = plan.url {
+        *request.current_url_mut() = url;
+        applied.url_changed = true;
+    }
+    for name in &plan.remove {
+        if request.headers.remove(name).is_some() {
+            applied.headers_removed += 1;
+        }
+    }
+    for (name, value) in plan.set {
+        request.headers.insert(name, value);
+        applied.headers_set += 1;
+    }
+    if plan.origin_changed {
+        // The referrer was worked out for the old URL: a `same-origin` policy would now send it to
+        // another origin. Work it out again for the new URL, from the referrer that is left (already
+        // trimmed, so this can only tighten it), with the same cap as `main_fetch`.
+        request.referrer = match std::mem::replace(&mut request.referrer, Referrer::NoReferrer) {
+            Referrer::NoReferrer => Referrer::NoReferrer,
+            Referrer::ReferrerUrl(source) | Referrer::Client(source) => {
+                let referrer_policy = policy.cap_referrer_policy(request.referrer_policy);
+                determine_requests_referrer(referrer_policy, source, request.current_url())
+                    .map_or(Referrer::NoReferrer, Referrer::ReferrerUrl)
+            },
+        };
+    }
+    applied
+}
+
+#[cfg(test)]
+mod tests {
+    use net_traits::ReferrerPolicy;
+    use net_traits::blob_url_store::UrlWithBlobClaim;
+    use net_traits::pub_domains::Site;
+    use net_traits::request::{
+        Destination, InsecureRequestsPolicy, RequestBuilder, RequestClient,
+    };
+
+    use super::*;
+
+    fn url(text: &str) -> ServoUrl {
+        ServoUrl::parse(text).unwrap()
+    }
+
+    fn client(origin_url: &ServoUrl, nested: bool) -> RequestClient {
+        RequestClient {
+            preloaded_resources: Default::default(),
+            policy_container: Default::default(),
+            origin: Origin::Origin(origin_url.origin()),
+            is_nested_browsing_context: nested,
+            insecure_requests_policy: InsecureRequestsPolicy::DoNotUpgrade,
+            has_trustworthy_ancestor_origin: false,
+            network_partition_key: Some(Site::from_origin(&origin_url.origin())),
+            browser_initiated_navigation: false,
+        }
+    }
+
+    /// A subresource request from `page` to `target` (destination none, no-cors).
+    fn subresource(page: &str, target: &str) -> Request {
+        let page = url(page);
+        RequestBuilder::new(
+            None,
+            UrlWithBlobClaim::new(url(target), None),
+            Referrer::NoReferrer,
+        )
+        .origin(page.origin())
+        .client(client(&page, false))
+        .policy_container(Default::default())
+        .build()
+    }
+
+    /// A navigation of a frame to `target`; `nested` says whether the frame is below the top level.
+    fn navigation(target: &str, nested: bool) -> Request {
+        let page = url("http://page.example/");
+        RequestBuilder::new(
+            None,
+            UrlWithBlobClaim::new(url(target), None),
+            Referrer::NoReferrer,
+        )
+        .destination(Destination::Document)
+        .mode(RequestMode::Navigate)
+        .origin(page.origin())
+        .client(client(&page, nested))
+        .policy_container(Default::default())
+        .build()
+    }
+
+    fn rewrite_url(target: &str) -> WebResourceRewrite {
+        WebResourceRewrite {
+            url: Some(url(target)),
+            ..WebResourceRewrite::default()
+        }
+    }
+
+    fn headers(set: &[(&str, &str)], remove: &[&str]) -> WebResourceRewrite {
+        WebResourceRewrite {
+            url: None,
+            set_headers: set
+                .iter()
+                .map(|(name, value)| ((*name).to_owned(), (*value).to_owned()))
+                .collect(),
+            remove_headers: remove.iter().map(|name| (*name).to_owned()).collect(),
+        }
+    }
+
+    fn unchanged(request: &Request, before_url: &str, before_headers: usize) {
+        assert_eq!(request.current_url().as_str(), before_url);
+        assert_eq!(request.headers.len(), before_headers);
+    }
+
+    #[test]
+    fn top_level_document_needs_the_document_destination_and_a_client_that_is_not_nested() {
+        assert!(is_top_level_document(&navigation(
+            "http://a.example/",
+            false
+        )));
+        // A frame navigated by a script or a link: destination Document, nested client (D17).
+        assert!(!is_top_level_document(&navigation(
+            "http://a.example/",
+            true
+        )));
+        // Not a document at all.
+        assert!(!is_top_level_document(&subresource(
+            "http://page.example/",
+            "http://a.example/x.js"
+        )));
+        // Without a client the destination decides, as it did before Mercury.
+        let mut no_client = navigation("http://a.example/", false);
+        no_client.client = None;
+        assert!(is_top_level_document(&no_client));
+        no_client.destination = Destination::IFrame;
+        assert!(!is_top_level_document(&no_client));
+    }
+
+    /// "Top-level document" (the embedder's `is_for_main_frame`, the rewrite rules) and "top-level navigation" (the
+    /// network policy's rule 2 for the site of a request) share one definition and differ in exactly three
+    /// deliberate ways: a request without a client, a mode other than `Navigate` and an initiator make a request
+    /// a top-level document but not a top-level navigation (net-1 review, minor 8). Every top-level navigation is a
+    /// top-level document.
+    #[test]
+    fn a_top_level_navigation_is_a_top_level_document_and_the_difference_is_pinned() {
+        let policy = NetPolicy::new();
+        let is_navigation = |request: &Request| policy.sites_of_request(request).top_level_navigation;
+
+        let top_level = navigation("http://a.example/", false);
+        assert!(is_top_level_document(&top_level) && is_navigation(&top_level));
+        let nested = navigation("http://a.example/", true);
+        assert!(!is_top_level_document(&nested) && !is_navigation(&nested));
+
+        let mut no_client = navigation("http://a.example/", false);
+        no_client.client = None;
+        assert!(is_top_level_document(&no_client) && !is_navigation(&no_client));
+
+        let mut fetched = navigation("http://a.example/", false);
+        fetched.mode = RequestMode::CorsMode;
+        assert!(is_top_level_document(&fetched) && !is_navigation(&fetched));
+
+        let mut prefetched = navigation("http://a.example/", false);
+        prefetched.initiator = net_traits::request::Initiator::Prefetch;
+        assert!(is_top_level_document(&prefetched) && !is_navigation(&prefetched));
+    }
+
+    #[test]
+    fn initiator_origin_is_the_ascii_origin_or_none_when_opaque() {
+        let request = subresource("http://page.example:8080/a", "http://other.example/");
+        assert_eq!(
+            initiator_origin(&request).as_deref(),
+            Some("http://page.example:8080")
+        );
+        // The request's origin is still "client": the client's is used.
+        let mut client_origin = request.clone();
+        client_origin.origin = Origin::Client;
+        assert_eq!(
+            initiator_origin(&client_origin).as_deref(),
+            Some("http://page.example:8080")
+        );
+        // A typed address: an opaque origin has no serialisation worth reporting.
+        let mut opaque = request.clone();
+        opaque.origin = Origin::Origin(servo_url::ImmutableOrigin::new_opaque());
+        assert_eq!(initiator_origin(&opaque), None);
+        // No origin and no client.
+        let mut nothing = request;
+        nothing.origin = Origin::Client;
+        nothing.client = None;
+        assert_eq!(initiator_origin(&nothing), None);
+    }
