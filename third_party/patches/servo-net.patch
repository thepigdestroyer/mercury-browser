+        assert_eq!(parse(namespaced.as_bytes()).unwrap_err(), TOO_DEEP);
+        let unicode = format!(
+            "<r>{}{}</r>",
+            "<\u{e9}l>".repeat(600),
+            "</\u{e9}l>".repeat(600)
+        );
+        assert_eq!(depth_of(&unicode), MAX_SVG_DEPTH + 1);
