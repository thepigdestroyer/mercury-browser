+        manager.note_certificate_failure_for_test(&host(index), &der(b"c"));
+        assert!(
+            manager
+                .report_certificate_failure_for_test(&host(index))
+                .is_some()
+        );
+    };
+    for index in 0..MAX_RECORDED_FAILURES {
+        report(index);
+    }
