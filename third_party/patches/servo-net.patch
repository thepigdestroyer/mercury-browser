+    report(0);
+    report(MAX_RECORDED_FAILURES);
+    assert_eq!(state.accept_failed_certificate(&host(0), b"c"), Ok(()));
+    assert_eq!(
+        state.accept_failed_certificate(&host(1), b"c"),
+        Err(CertificateExceptionRefusal::NoFailureRecorded)
