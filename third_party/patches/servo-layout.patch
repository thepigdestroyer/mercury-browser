+
+    #[test]
+    fn the_end_side_follows_gecko() {
+        // One value: always for the end.
+        assert_eq!(end_side(true, false), Side::Second);
+        assert_eq!(end_side(true, true), Side::Second);
+        // Two values are physical: left then right.
