+            return None;
+        }
+
+        let line_start = match self.current_line.placement_among_floats.get() {
+            Some(placement_among_floats) => placement_among_floats.start_corner.inline,
+            None => Au::zero(),
+        };
+        Some(line::LineElision {
+            limit: line_start + available_space,
+            marker,
+            block_is_rtl,
+        })
+    }
