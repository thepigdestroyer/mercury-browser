+        assert!(segments_for_fragment(&[leading_spaces], map, run(0, 5)).is_empty());
+        let dropped = map_highlights(&[leading_spaces, composition], map);
+        assert_eq!(dropped.len(), 1);
+        assert_eq!(dropped[0].kind, HighlightKind::Composition);
