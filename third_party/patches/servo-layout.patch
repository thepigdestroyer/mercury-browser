+        let segments = segments_for_fragment(&highlights, identity, run(0, 10));
+        assert_eq!(
+            segments,
+            vec![
+                Segment {
+                    range: run(0, 2),
+                    background: Some(HighlightKind::FindMatch),
+                    decorations: DecorationSet::EMPTY,
+                },
+                Segment {
+                    range: run(2, 4),
+                    background: Some(HighlightKind::ActiveFindMatch),
+                    decorations: DecorationSet::EMPTY,
