+    /// `li { counter-increment: item } li::before { content: counters(item, ".") }`: opens the
+    /// `li` (the caller closes it).
+    fn counted(doc: &mut Doc) -> CounterKey {
+        let key = doc.open(plain().increment("item", 1));
+        doc.pseudo(
+            key,
+            PseudoKind::Before,
+            ElementInput {
+                uses: vec![CounterUse {
+                    name: "item",
+                    all: true,
+                }],
+                ..Default::default()
+            },
+        );
+        key
+    }
