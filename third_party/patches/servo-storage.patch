+#[test]
+fn names_and_origins_are_independent() {
+    let storage = start();
+    let (site, other_site) = (origin("https://example.com"), origin("https://example.org"));
+    let (a, b, c) = (
+        Client::new(&storage, "a", &site),
+        Client::new(&storage, "b", &site),
+        Client::new(&storage, "c", &other_site),
