+    /// The highlights that [`HighlightSet::update`] resolved for `node`, for layout.
+    fn resolved_for(&self, node: OpaqueNode) -> TextHighlights {
+        self.resolved
+            .borrow()
+            .get(&node)
+            .cloned()
+            .unwrap_or_default()
