+        let recorded = Cell::new(false);
+        let record = |_| {
+            recorded.set(true);
+            PermissionState::Granted
+        };
+        assert_eq!(
+            settle_answer(true, Some(AllowOrDeny::Allow), record),
+            AnswerOutcome::Stale
+        );
+        assert!(!recorded.get());
+    }
