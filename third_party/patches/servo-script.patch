+            let mut len = 0;
+            if unsafe { !GetArrayLength(cx, object.handle(), &mut len) } {
+                return Err(Error::JSFailed);
+            }
+
+            // Step 1.2: Let seen be a new set containing only input.
+            let seen: Vec<HandleValue> = vec![input];
+
+            // Step 1.3: Let keys be a new empty list.
