+        assert_eq!(LockModeMsg::Exclusive.convert(), LockMode::Exclusive);
+        assert_eq!(LockMode::Shared.convert(), LockModeMsg::Shared);
+        assert_eq!(LockMode::Exclusive.convert(), LockModeMsg::Exclusive);
